COLOSSEUM_ACCOUNT_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/colosseum_account_dev?sslmode=disable
DATABASE_MAX_CONNECTIONS=8

# Generate independent random values for real use.
RECOVERY_HMAC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ABUSE_HMAC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SESSION_WRAP_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Optional: override the embedded baseline with a larger operator-managed corpus.
PASSWORD_BLOCKLIST_PATH=
REGISTRATION_GLOBAL_LIMIT_10M=500

BUCKET_NAME=
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto

# Bundle 6 sync payload encryption / clock-skew policy
SYNC_DATA_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SYNC_MAX_FUTURE_SKEW_SECONDS=600
