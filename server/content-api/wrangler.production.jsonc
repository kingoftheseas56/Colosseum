// Production catalogue endpoint; source-pinned D1 snapshot is shared with staging.
// Never migrate or overwrite the shared databases in place. SESSION_SECRET is provisioned separately.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colosseum-content-api",
  "main": "src/index.ts",
  "account_id": "69049ce787cd73028c878bf0953946f6",
  "assets": {
    "directory": "generated/content-production",
    "binding": "ASSETS",
    "run_worker_first": [
      "/v1/*",
      "/admin/*",
      "/healthz",
      "/internal/*"
    ]
  },
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "LIBRARY_REVISION": "4ee62650692b3ca915a27478c1da718726ae543c8f31768596c29509d6535b2e",
    "TANKOBAN_GUEST_ENABLED": "true"
  },
  "ratelimits": [
    {
      "name": "GUEST_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "LIBRARY",
      "database_name": "colosseum-library-staging-4ee626",
      "database_id": "65fca568-24e4-4ca8-b5e3-ad366577a489"
    },
    {
      "binding": "CATALOG",
      "database_name": "colosseum-catalog-staging",
      "database_id": "05a2f058-5df9-4636-a772-34a2672fb655",
      "migrations_dir": "migrations/catalog"
    },
    {
      "binding": "METADATA",
      "database_name": "colosseum-metadata-staging",
      "database_id": "9ea859a1-f800-4c24-b24a-476872eec0e2",
      "migrations_dir": "migrations/metadata"
    }
  ]
}
