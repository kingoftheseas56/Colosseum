agents/dataset-probes/*.json.gz filter=lfs diff=lfs merge=lfs -text
tools/biblio_series.db filter=lfs diff=lfs merge=lfs -text

# Signed update fixtures must stay byte-identical across clones - Ed25519 verifies the
# exact bytes; core.autocrlf=true otherwise rewrites LF->CRLF on checkout and breaks it.
tests/lanista_fixtures/**/manifest.json -text
tests/lanista_fixtures/**/manifest.sig  -text

# Production chronicle signatures also cover exact checkout bytes.
resources/installed-chronicle/installed-manifest.json -text
resources/installed-chronicle/installed-manifest.json.sig binary

# Linux launchers must remain executable by bash after Windows checkouts.
tools/linux-release/*.sh text eol=lf
tools/linux-release/AppRun text eol=lf

# The Android engine stamp verifies these exact patch bytes on every host.
native/third_party/nuvio-engine/patches/0001-android-hardening.patch text eol=lf

# These checksummed online artwork sources were published with CRLF bytes.
# Keep the source payload identical on Linux checkouts so release staging can
