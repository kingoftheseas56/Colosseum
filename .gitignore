# Colosseum — source-only backup. Build output, scratch, and downloadable art stay out.

# CMake / compiler output (recompiles from native/main.cpp + CMakeLists.txt)
# build*/ covers both the MinGW build/ and the MSVC build-msvc/ trees.
native/build*/

# Dev scratch: smoke screenshots, diagnostic logs, click scripts
tools/
*-proto.png
mocks/*-shot.png
.codex-history/
.worktrees/

# Cover art — fetched from remote URLs (Catalog.js) + cached to disk; not source
assets/covers/

# Per-machine settings (QtCore Settings ini) — Hemanth's local picks, not source.
# wallpapers.ini stays untracked-but-unignored (pre-existing convention); player.ini
# is new in this task so it goes in .gitignore straight away — never tempt a commit.
player.ini

# OS / editor cruft
*.log
Thumbs.db
.DS_Store
tests/xoxo_fixtures.gen.js
