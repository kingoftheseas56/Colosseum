+std::string regexEscape(char character)
+{
+    switch (character) {
+    case '\\':
+    case '.':
+    case '+':
+    case '^':
+    case '$':
+    case '|':
+    case '(':
+    case ')':
+    case '[':
+    case ']':
+    case '{':
+    case '}':
+        return std::string("\\") + character;
+    default:
+        return std::string(1, character);
+    }
+}
