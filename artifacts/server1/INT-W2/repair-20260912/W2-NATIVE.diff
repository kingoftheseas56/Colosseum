+Bytes bstring(std::string_view value)
+{
+    Bytes output;
+    append(output, std::to_string(value.size()));
+    output.push_back(':');
+    append(output, value);
+    return output;
+}
+
+Bytes bbytes(const Bytes &value)
+{
+    Bytes output;
+    append(output, std::to_string(value.size()));
+    output.push_back(':');
+    output.insert(output.end(), value.begin(), value.end());
+    return output;
+}
