+    sys.stdout.buffer.write(os.environ.get("M00_CHILD_ENV", "missing").encode("utf-8"))
+    sys.stdout.buffer.flush()
+    sys.exit(0)
+elif mode == "ignore-term":
+    if hasattr(signal, "SIGTERM"):
+        signal.signal(signal.SIGTERM, lambda _signum, _frame: None)
+    while True:
+        time.sleep(0.05)
+elif mode == "sleep":
+    time.sleep(10)
