diff --git a/src/ut_metadata.cpp b/src/ut_metadata.cpp
--- a/src/ut_metadata.cpp
+++ b/src/ut_metadata.cpp
@@ -137,0 +138,25 @@
+		int nuvio_metadata_request(bool const has_metadata, std::vector<int> const& sent)
+		{
+			if (m_requested_metadata.empty())
+			{
+				if (std::find(sent.begin(), sent.end(), 0) != sent.end()) return -1;
+				m_requested_metadata.resize(1);
+				++m_requested_metadata[0].num_requests;
+				if (has_metadata) m_requested_metadata[0].last_request = aux::time_now();
+				return 0;
+			}
+			int best = -1;
+			for (int piece = 0; piece < m_requested_metadata.end_index(); ++piece)
+			{
+				auto const& entry = m_requested_metadata[piece];
+				if (entry.num_requests == std::numeric_limits<int>::max()) continue;
+				if (std::find(sent.begin(), sent.end(), piece) != sent.end()) continue;
+				if (best == -1 || entry.num_requests < m_requested_metadata[best].num_requests)
+					best = piece;
+			}
+			if (best == -1) return -1;
+			++m_requested_metadata[best].num_requests;
+			if (has_metadata) m_requested_metadata[best].last_request = aux::time_now();
+			return best;
+		}
