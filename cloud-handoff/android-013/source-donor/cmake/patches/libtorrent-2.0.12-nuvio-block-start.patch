+	void piece_picker::set_block_start(piece_index_t const piece, int const block)
+	{
+		auto const i = std::find_if(m_nuvio_block_start.begin(), m_nuvio_block_start.end()
+			, [piece](std::pair<piece_index_t, int> const& e) { return e.first == piece; });
+		if (block <= 0)
+		{
+			if (i != m_nuvio_block_start.end()) m_nuvio_block_start.erase(i);
+			return;
+		}
+		if (i != m_nuvio_block_start.end()) i->second = block;
+		else m_nuvio_block_start.emplace_back(piece, block);
+	}
+
+	int piece_picker::block_start(piece_index_t const piece) const
+	{
+		for (auto const& e : m_nuvio_block_start)
+			if (e.first == piece) return e.second;
+		return 0;
