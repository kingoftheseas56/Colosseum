diff --git a/tests/qml/tst_vinyl_artist_lifetime.qml b/tests/qml/tst_vinyl_artist_lifetime.qml
new file mode 100644
--- /dev/null
+++ b/tests/qml/tst_vinyl_artist_lifetime.qml
@@ -0,0 +1,66 @@
+import QtQuick
+import QtTest
+
+TestCase {
+    name: "VinylArtistHistoryLifetime"
+    when: windowShown
+    property var host
+
+    function createArtist() {
+        var component = Qt.createComponent("../../qml/vinyl/ArtistPreview.qml");
+        verify(component.status === Component.Ready, component.errorString());
+        var view = component.createObject(null);
+        verify(view !== null);
+        view.pageData.frozen = true;
+        tryCompare(view, "ready", true);
+        view.artistData.reducedMotion = true;
+        return view;
+    }
+
+    function init() {
+        host = createArtist();
+        host.artistData.open("Eminem");
+    }
+
+    function cleanup() {
+        if (host) {
+            host.close();
+            host.destroy();
+            host = null;
+        }
+    }
+
+    function test_historyRestoresOnOwnedDeferredCallback() {
+        host.artistScroll.contentY = 220;
+        var expectedY = host.artistScroll.contentY;
+        host.openArtist("Michael Jackson");
+        compare(host.artistData.record.name, "Michael Jackson");
+        host.artistBack();
+        compare(host.artistData.record.name, "Eminem");
+        tryCompare(host.artistScroll, "contentY", expectedY);
+    }
+
+    function test_rapidBackDestroyDoesNotRunStaleHistoryCallback() {
+        host.openArtist("Joni Mitchell");
+        host.artistBack();
+        host.close();
+        host.destroy();
+        host = null;
+        wait(0);
+        verify(true);
+    }
+
+    function test_twelveConsecutiveHistoryTeardowns() {
+        for (var i = 0; i < 12; ++i) {
+            var instance = createArtist();
+            instance.artistData.open("Eminem");
+            instance.openArtist("Michael Jackson");
+            instance.artistBack();
+            instance.close();
+            instance.destroy();
+            instance = null;
+            wait(0);
+        }
+        verify(true);
+    }
+}
