+/*!
+ * \brief Sets the idle timeout for the web server's writes of file and
+ * virtual-directory bodies.
+ *
+ * Every slice of a body is written with a fresh budget of this many seconds,
+ * so a client that stops reading cannot pin a web server worker forever while
+ * a slow client that keeps reading is never cut off. The default is 90
+ * seconds; 0 turns the timeout off.
+ *
+ * \return An integer representing one of the following:
+ *     \li \c UPNP_E_SUCCESS: The operation completed successfully.
+ *     \li \c UPNP_E_INVALID_PARAM: \b seconds is negative.
+ */
+UPNP_EXPORT_SPEC int UpnpSetWebServerWriteIdleTimeout(
+	/*! [in] The idle timeout in seconds. */
+	int seconds);
+
