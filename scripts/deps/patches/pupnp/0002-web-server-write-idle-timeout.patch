+/*!
+ * Idle timeout, in seconds, for every write of a web-server file/virtual-dir
+ * body. Without it the web server writes with an infinite timeout, so one
+ * client that opens a GET and stops reading pins a worker thread for good.
+ * The budget is renewed for every slice that goes out, so a slow but moving
+ * client is never cut off: this bounds one stalled write, not a transfer.
+ * 0 or negative disables the timeout (the previous behaviour).
+ */
+static volatile int g_webWriteIdleTimeoutSecs = 90;
+
+/*! Size of one body write slice: small enough that the idle timeout bounds a
+ * stall, large enough to keep throughput. */
+#define WEB_WRITE_SLICE_SIZE (size_t)(64 * 1024)
+
+int UpnpSetWebServerWriteIdleTimeout(int seconds)
+{
+	if (seconds < 0) {
+		return UPNP_E_INVALID_PARAM;
+	}
+	g_webWriteIdleTimeoutSecs = seconds;
+
+	return UPNP_E_SUCCESS;
+}
+
+/*! Make a blocking send() itself give up after the idle timeout: select()
+ * alone only proves that some room exists, the send that follows can still
+ * block until the whole slice is queued. */
+static void web_set_send_timeout(SOCKET sock, int seconds)
+{
+	if (seconds <= 0) {
+		return;
+	}
+#ifdef _WIN32
+	{
+		DWORD ms = (DWORD)seconds * 1000;
+		setsockopt(sock,
+			SOL_SOCKET,
+			SO_SNDTIMEO,
+			(const char *)&ms,
+			(int)sizeof(ms));
+	}
+#else
+	{
+		struct timeval tv;
+		tv.tv_sec = seconds;
+		tv.tv_usec = 0;
+		setsockopt(sock, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+	}
+#endif
+}
+
+/*! Write a body buffer in slices, each with a fresh idle budget. Returns the
+ * number of bytes written, or the failing sock_write() result (<= 0). */
+static int web_write_body(SOCKINFO *info, const char *buf, size_t len)
+{
+	size_t done = 0;
+
+	while (done < len) {
+		size_t n = len - done;
+		int budget = g_webWriteIdleTimeoutSecs > 0
+				     ? g_webWriteIdleTimeoutSecs
+				     : -1;
+		int nw;
+
+		if (n > WEB_WRITE_SLICE_SIZE) {
+			n = WEB_WRITE_SLICE_SIZE;
+		}
+		nw = sock_write(info, buf + done, n, &budget);
+		if (nw <= 0) {
+			return nw;
+		}
+		done += (size_t)nw;
+	}
+
+	return (int)done;
+}
