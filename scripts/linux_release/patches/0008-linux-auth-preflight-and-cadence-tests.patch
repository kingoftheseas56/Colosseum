+void TrackerLifecycleTest::unavailableLinuxVaultBlocksAuthenticatedRequests()
+{
+    QTemporaryDir root;
+    QVERIFY(root.isValid());
+    const ProfilePaths profile = ProfilePaths::localOnly(root.path());
+    WindowsTrackerCredentialVault vault;
+    QVERIFY(!vault.isAvailable());
+    QTcpServer proxy;
+    QVERIFY(proxy.listen(QHostAddress::LocalHost, 0));
+    QSignalSpy connections(&proxy, &QTcpServer::newConnection);
+    // Route any accidental HTTP attempt to a local observer, never the provider.
+    struct RestoreProxy {
+        QNetworkProxy old = QNetworkProxy::applicationProxy();
+        ~RestoreProxy() { QNetworkProxy::setApplicationProxy(old); }
+    } restoreProxy;
+    QNetworkProxy::setApplicationProxy(QNetworkProxy(QNetworkProxy::HttpProxy,
+                                                   QStringLiteral("127.0.0.1"), proxy.serverPort()));
+    SimklApiClient client(profile, testAuthConfiguration());
+    QVERIFY(!client.available());
+    int completed = 0;
+    const auto rejected = [&completed](const SimklApiResult &result) {
+        QCOMPARE(result.statusCode, 401);
+        QVERIFY(!result.succeeded());
+        ++completed;
+    };
+    client.get(QStringLiteral("/users/settings"), {}, rejected);
+    client.post(QStringLiteral("/sync/history"), {}, QJsonDocument(QJsonObject{}), rejected);
+    QTRY_COMPARE(completed, 2);
+    TrackerConnectionStore store(profile);
+    FakeBrowser browser;
+    FakeAuthTransport transport;
+    WallClock clock;
+    SimklConnectionController controller(profile, &store, nullptr, testAuthConfiguration(),
+                                         &vault, &browser, &transport, &clock);
+    QVERIFY(!controller.available());
+    QVERIFY(!controller.beginConnection(QStringLiteral("simkl")));
+    QVERIFY(!controller.busy());
+    QCOMPARE(controller.phase(), QStringLiteral("attention"));
+    QVERIFY(controller.statusMessage().contains(QStringLiteral("unsupported in this Linux preview")));
+    QTest::qWait(100);
+    QCOMPARE(connections.count(), 0);
+    QVERIFY(!proxy.hasPendingConnections());
+}
