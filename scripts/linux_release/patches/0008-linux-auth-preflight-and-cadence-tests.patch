+void tst_account_identity::unavailableStoreRejectsAuthBeforeNetwork() {
+    ScopedEnvironmentVariable restore("COLOSSEUM_APPDATA_TAG");
+    qputenv("COLOSSEUM_APPDATA_TAG", QByteArrayLiteral("account-unavailable-preflight"));
+    for (bool create : {false, true}) {
+        for (bool pendingClear : {false, true}) {
+            QTemporaryDir temp;
+            QVERIFY(temp.isValid());
+            CapturingTransport transport;
+            MemoryAccountCredentialStore credentials;
+            StoredAccountCredential oldCredential;
+            oldCredential.accountId = QString::fromLatin1(kAccountId);
+            oldCredential.deviceId = QString::fromLatin1(kDeviceId);
+            oldCredential.refreshToken = QByteArrayLiteral("old-private-token");
+            if (pendingClear)
+                QVERIFY(credentials.saveActive(oldCredential));
+            credentials.setAvailable(false);
+            MemoryAccountOneTimeSecretSink secretSink;
+            AccountClient client(&transport);
+            AccountDeviceIdentity identity(temp.path() + QLatin1String("/device.ini"));
+            AccountBootstrapStore bootstrap(temp.path() + QLatin1String("/bootstrap.ini"));
+            QVERIFY(bootstrap.setCredentialClearPending(pendingClear));
+            QVERIFY(bootstrap.setLocalOnlyChosen(false));
+            QVERIFY(bootstrap.setOnboardingCompleted(false));
+            const QByteArray before = ordinaryStateBytes(temp.path());
+            {
+                AccountController controller(&client, &credentials, &identity, &bootstrap, &secretSink);
+                controller.setAutomaticPollingEnabled(false);
+                QSignalSpy signedIn(&controller, &AccountController::signedIn);
+                QSignalSpy syncReady(&controller, &AccountController::accountProfileReadyForSync);
+                if (create)
+                    controller.createAccount(QStringLiteral("TestUser"), QStringLiteral("password long enough 123"));
+                else
+                    controller.signIn(QStringLiteral("TestUser"), QStringLiteral("password long enough 123"));
+                QCoreApplication::processEvents();
+                QCOMPARE(transport.sendCount, 0);
+                QCOMPARE(controller.mode(), QStringLiteral("error"));
+                QCOMPARE(controller.errorCategory(), QStringLiteral("storage"));
+                QCOMPARE(controller.lastErrorCode(), QStringLiteral("secure_store_unavailable"));
+                QCOMPARE(signedIn.count(), 0);
+                QCOMPARE(syncReady.count(), 0);
+                QVERIFY(client.accessToken().isEmpty());
+                QCOMPARE(secretSink.presentCount(), 0);
+                QCOMPARE(bootstrap.credentialClearPending(), pendingClear);
+                QVERIFY(!bootstrap.localOnlyChosen());
+                QVERIFY(!bootstrap.onboardingCompleted());
+                QCOMPARE(ordinaryStateBytes(temp.path()), before);
+                controller.continueWithoutAccount();
+                QCOMPARE(controller.mode(), QStringLiteral("localOnly"));
+                QCOMPARE(bootstrap.credentialClearPending(), pendingClear);
+            }
+            AccountBootstrapStore restartedBootstrap(bootstrap.settingsPath());
+            AccountController restarted(&client, &credentials, &identity, &restartedBootstrap, &secretSink);
+            restarted.setAutomaticPollingEnabled(false);
+            restarted.restoreRememberedSession();
+            QCOMPARE(transport.sendCount, 0);
+            if (pendingClear) {
+                QCOMPARE(restarted.lastErrorCode(), QStringLiteral("secure_store_clear_pending"));
+                QVERIFY(restartedBootstrap.credentialClearPending());
+                credentials.setAvailable(true);
+                QVERIFY(credentials.loadActive().has_value());
+                restarted.restoreRememberedSession();
+                QVERIFY(!credentials.loadActive().has_value());
+            }
+            QCOMPARE(restarted.mode(), QStringLiteral("localOnly"));
+            QVERIFY(!restartedBootstrap.credentialClearPending());
+            QVERIFY(client.accessToken().isEmpty());
+        }
+    }
+}
