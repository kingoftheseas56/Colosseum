{
    "name":  "downloads",
    "comment":  "Shared Downloads page with one seeded Tankoban item. Run with open-manga-v1 seed.",
    "steps":  [
                  {
                      "cmd":  "ping",
                      "label":  "isolated capture session answers",
                      "expect":  [
                                     {
                                         "path":  "gates.drive",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "boot splash has left",
                      "payload":  {
                                      "object":  "bootSplash",
                                      "prop":  "visible",
                                      "value":  false,
                                      "timeout_ms":  60000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "fresh capture profile shows local-mode choice",
                      "payload":  {
                                      "object":  "accountWelcomeContinueLocal",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  10000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "continue without account for disposable capture profile",
                      "payload":  {
                                      "target":  "accountWelcomeContinueLocal"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Home shell appears after local-mode choice",
                      "payload":  {
                                      "object":  "modePill_Tankoban",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  10000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "open taskbar dock",
                      "payload":  {
                                      "target":  "colosseumTaskbarHomeButton"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Downloads control settles",
                      "payload":  {
                                      "object":  "taskbarDownloads",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  5000
                                  }
                  },
                  {
                      "capture":  {
                                      "action":  "start",
                                      "name":  "reddit-downloads"
                                  },
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ],
                      "label":  "start Downloads capture"
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "open Downloads",
                      "payload":  {
                                      "target":  "taskbarDownloads"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "seeded download shelf appears",
                      "payload":  {
                                      "object":  "downloadsShelfCard_tankoban_manga:journey-manga-series-v1",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  15000
                                  }
                  },
                  {
                      "presentation_hold_ms":  900,
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ],
                      "label":  "show Downloads"
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "expand download group",
                      "payload":  {
                                      "target":  "downloadsShelfCard_tankoban_manga:journey-manga-series-v1"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "download action appears",
                      "payload":  {
                                      "object":  "downloadsReadAction_journey-manga-ch-1",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  10000
                                  }
                  },
                  {
                      "presentation_hold_ms":  900,
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ],
                      "label":  "show expanded download"
                  },
                  {
                      "capture":  {
                                      "action":  "stop"
                                  },
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ],
                      "label":  "stop Downloads capture"
                  }
              ]
}
