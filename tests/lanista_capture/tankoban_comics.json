{
    "name":  "tankoban_comics",
    "comment":  "Presentation-only harness around the production TankobanComicsTab, avoiding the disposable-session WorldTabBar delegate race.",
    "steps":  [
                  {
                      "cmd":  "ping",
                      "label":  "Comics capture session answers",
                      "expect":  [
                                     {
                                         "path":  "gates.drive",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Comics presentation surface is visible",
                      "payload":  {
                                      "object":  "comicsCaptureTab",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  15000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Comics poster assets are decoded",
                      "payload":  {
                                      "object":  "comicsPosterGate",
                                      "prop":  "ready",
                                      "value":  true,
                                      "timeout_ms":  15000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "presentation_wait_ms":  250,
                      "cmd":  "__runner_local_presentation__",
                      "label":  "let cached comic covers paint",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ]
                  },
                  {
                      "capture":  {
                                      "action":  "start",
                                      "name":  "reddit-tankoban-comics"
                                  },
                      "cmd":  "__runner_local_presentation__",
                      "label":  "start Tankoban comics capture",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ]
                  },
                  {
                      "presentation_hold_ms":  1800,
                      "cmd":  "__runner_local_presentation__",
                      "label":  "show Comics catalogue",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ]
                  },
                  {
                      "capture":  {
                                      "action":  "stop"
                                  },
                      "cmd":  "__runner_local_presentation__",
                      "label":  "stop Tankoban comics capture",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ]
                  }
              ]
}