{
    "name":  "tankoban_comics",
    "comment":  "Tankoban Comics capture waits off-camera for the live catalogue to settle.",
    "steps":  [
                  {
                      "cmd":  "ping",
                      "label":  "isolated capture session answers",
                      "expect":  [
                                     {
                                         "path":  "gates.drive",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "boot splash has left",
                      "payload":  {
                                      "object":  "bootSplash",
                                      "prop":  "visible",
                                      "value":  false,
                                      "timeout_ms":  60000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "fresh capture profile shows local-mode choice",
                      "payload":  {
                                      "object":  "accountWelcomeContinueLocal",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  10000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "continue without account for disposable capture profile",
                      "payload":  {
                                      "target":  "accountWelcomeContinueLocal"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Home shell appears after local-mode choice",
                      "payload":  {
                                      "object":  "modePill_Tankoban",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  10000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "enter Tankoban",
                      "payload":  {
                                      "target":  "modePill_Tankoban"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Tankoban is visible",
                      "payload":  {
                                      "object":  "tankobanWorld",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  10000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "open Comics tab",
                      "payload":  {
                                      "target":  "tankobanTab_comics"
                                  }
                  },
                  {
                      "presentation_wait_ms":  12000,
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ],
                      "label":  "let Comics finish loading off-camera"
                  },
                  {
                      "cmd":  "qml-get",
                      "label":  "probe Comics world state",
                      "payload":  {
                                      "object":  "tankobanWorld",
                                      "props":  [
                                                    "activeTab",
                                                    "viewportContentY",
                                                    "viewportHeight",
                                                    "comicRows",
                                                    "comicShelves",
                                                    "comicBoxes"
                                                ]
                                  }
                  }
              ]
}