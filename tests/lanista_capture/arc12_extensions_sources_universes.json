{
  "name": "arc12_extensions_sources_universes",
  "comment": "Production Extensions Sources pane: ask-order chain through Theatre, Tankoban, Biblio, and Universes.",
  "steps": [
    { "cmd": "ping", "expect": [{ "path": "gates.drive", "op": "==", "value": "true" }] },
    { "cmd": "ui-wait-for", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "payload": { "object": "accountWelcomeContinueLocal", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "payload": { "object": "modePill_Tankoban", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "payload": { "target": "colosseumTaskbarHomeButton" } },
    { "cmd": "ui-wait-for", "payload": { "object": "taskbarExtensions", "prop": "visible", "value": true, "timeout_ms": 5000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "payload": { "target": "taskbarExtensions" } },
    { "cmd": "ui-wait-for", "payload": { "object": "extensionsPage", "prop": "visible", "value": true, "timeout_ms": 15000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "payload": { "object": "extensionsSources", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "payload": { "object": "extensionSourceSection_theatre", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "capture", "capture": { "action": "start", "name": "arc12-extensions-sources-universes" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "__runner_local_presentation__", "presentation_hold_ms": 1800, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-scroll", "label": "scroll from Theatre sources into Tankoban", "payload": { "target": "extensionsPageScroll", "dy": -900 }, "expect": [{ "path": "scrolled", "op": "==", "value": "extensionsPageScroll" }] },
    { "cmd": "__runner_local_presentation__", "presentation_hold_ms": 1700, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-scroll", "label": "scroll from Tankoban sources into Biblio", "payload": { "target": "extensionsPageScroll", "dy": -900 }, "expect": [{ "path": "scrolled", "op": "==", "value": "extensionsPageScroll" }] },
    { "cmd": "__runner_local_presentation__", "presentation_hold_ms": 1700, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-scroll", "label": "scroll from Biblio sources into Universes", "payload": { "target": "extensionsPageScroll", "dy": -900 }, "expect": [{ "path": "scrolled", "op": "==", "value": "extensionsPageScroll" }] },
    { "cmd": "__runner_local_presentation__", "presentation_hold_ms": 1700, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-query", "label": "verify Universes section is in the capture window", "payload": { "object": "extensionSourceSection_universes" }, "expect": [{ "path": "rect.y", "op": "<", "value": 1080 }] },
    { "cmd": "capture", "capture": { "action": "stop" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] }
  ]
}
