{
    "name":  "tankoban_reader",
    "comment":  "Seeded Tankoban reader capture without loading the live Comics catalogue.",
    "steps":  [
                  {
                      "cmd":  "ping",
                      "label":  "isolated capture session answers",
                      "expect":  [
                                     {
                                         "path":  "gates.drive",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "boot splash has left",
                      "payload":  {
                                      "object":  "bootSplash",
                                      "prop":  "visible",
                                      "value":  false,
                                      "timeout_ms":  60000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "fresh capture profile shows local-mode choice",
                      "payload":  {
                                      "object":  "accountWelcomeContinueLocal",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  10000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "continue without account for disposable capture profile",
                      "payload":  {
                                      "target":  "accountWelcomeContinueLocal"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Home shell appears after local-mode choice",
                      "payload":  {
                                      "object":  "modePill_Tankoban",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  10000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "open taskbar dock",
                      "payload":  {
                                      "target":  "colosseumTaskbarHomeButton"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Downloads control settles",
                      "payload":  {
                                      "object":  "taskbarDownloads",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  5000
                                  }
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "open Downloads",
                      "payload":  {
                                      "target":  "taskbarDownloads"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "seeded manga shelf appears",
                      "payload":  {
                                      "object":  "downloadsShelfCard_tankoban_manga:journey-manga-series-v1",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  15000
                                  }
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "expand seeded manga",
                      "payload":  {
                                      "target":  "downloadsShelfCard_tankoban_manga:journey-manga-series-v1"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Read action appears",
                      "payload":  {
                                      "object":  "downloadsReadAction_journey-manga-ch-1",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  15000
                                  }
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "open comic reader",
                      "payload":  {
                                      "target":  "downloadsReadAction_journey-manga-ch-1"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "comic reader is ready",
                      "payload":  {
                                      "object":  "comicReaderShell",
                                      "prop":  "readerReady",
                                      "value":  true,
                                      "timeout_ms":  30000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "capture":  {
                                      "action":  "start",
                                      "name":  "reddit-tankoban-reader"
                                  },
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ],
                      "label":  "start comic reader capture"
                  },
                  {
                      "presentation_hold_ms":  800,
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ],
                      "label":  "show reader"
                  },
                  {
                      "cmd":  "ui-keypress",
                      "label":  "turn one page",
                      "payload":  {
                                      "key":  "Right"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "reader settles after turn",
                      "payload":  {
                                      "object":  "comicReaderShell",
                                      "prop":  "readerReady",
                                      "value":  true,
                                      "timeout_ms":  15000
                                  }
                  },
                  {
                      "presentation_hold_ms":  700,
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ],
                      "label":  "show turned page"
                  },
                  {
                      "capture":  {
                                      "action":  "stop"
                                  },
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ],
                      "label":  "stop comic reader capture"
                  }
              ]
}