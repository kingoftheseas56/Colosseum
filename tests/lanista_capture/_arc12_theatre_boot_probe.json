{
  "name": "arc12_theatre_boot_probe",
  "comment": "Inspect production Theatre after world navigation before capture gestures.",
  "steps": [
    { "cmd": "ping", "expect": [{ "path": "gates.drive", "op": "==", "value": "true" }] },
    { "cmd": "ui-wait-for", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "payload": { "object": "accountWelcomeContinueLocal", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "payload": { "object": "modePill_Tankoban", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "payload": { "target": "modePill_Theatre" } },
    { "cmd": "__runner_local_presentation__", "label": "allow the asynchronous Theatre world to paint", "presentation_wait_ms": 5000, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-snapshot", "label": "inspect production Theatre actions after paint" },
    { "cmd": "ui-query", "label": "inspect visible Theatre world", "payload": { "object": "theatreWorld" } },
    { "cmd": "qml-get", "label": "inspect Theatre world geometry", "payload": { "object": "theatreWorld", "props": ["visible", "width", "height", "activeTab"] }, "expect": [{ "path": "props.width", "op": ">", "value": 1000 }, { "path": "props.height", "op": ">", "value": 500 }] },
    { "cmd": "qml-get", "label": "inspect Theatre scroll geometry", "payload": { "object": "theatreWorldScroll", "props": ["visible", "width", "height", "contentHeight", "contentY"] }, "expect": [{ "path": "props.width", "op": ">", "value": 1000 }, { "path": "props.height", "op": ">", "value": 500 }, { "path": "props.contentHeight", "op": ">", "value": 1000 }] },
    { "cmd": "qml-get", "label": "inspect Theatre discover payload", "payload": { "object": "theatreDiscoverPage", "props": ["visible", "width", "height", "loading", "items"] }, "expect": [{ "path": "props.width", "op": ">", "value": 1000 }, { "path": "props.height", "op": ">", "value": 300 }] }
  ]
}
