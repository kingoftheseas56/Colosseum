{
  "name": "arc12_wallpaper",
  "comment": "Arc 12 wallpaper picker and default-wallpaper Theatre view through production Main routes.",
  "steps": [
    { "cmd": "ping", "expect": [{ "path": "gates.drive", "op": "==", "value": "true" }] },
    { "cmd": "ui-wait-for", "label": "boot splash has left", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "label": "fresh capture profile shows local-mode choice", "payload": { "object": "accountWelcomeContinueLocal", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "label": "continue without account", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "Home shell appears", "payload": { "object": "modePill_Tankoban", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "label": "open production wallpaper picker", "payload": { "target": "topBarWallpaperButton" } },
    { "cmd": "ui-wait-for", "label": "production wallpaper picker appears", "payload": { "object": "wallpaperSearch", "prop": "visible", "value": true, "timeout_ms": 15000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "label": "native wallpaper choices appear", "payload": { "object": "wallpaperPick_native_mesh_ember", "prop": "visible", "value": true, "timeout_ms": 15000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "capture", "label": "start wallpaper picker clip", "capture": { "action": "start", "name": "arc12-wallpaper-picker" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "__runner_local_presentation__", "label": "show production wallpaper picker", "presentation_hold_ms": 1200, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "capture", "label": "stop wallpaper picker clip", "capture": { "action": "stop" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-click", "label": "close wallpaper picker without changing the default", "payload": { "target": "wallpaperSearchClose" } },
    { "cmd": "ui-wait-for", "label": "Home shell returns with default wallpaper", "payload": { "object": "modePill_Tankoban", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "label": "enter Theatre with default wallpaper", "payload": { "target": "modePill_Theatre" } },
    { "cmd": "ui-wait-for", "label": "production Theatre returns", "payload": { "object": "theatreWorld", "prop": "visible", "value": true, "timeout_ms": 15000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "label": "production Theatre Discover finishes loading", "payload": { "object": "theatreDiscoverPage", "prop": "loading", "value": false, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "capture", "label": "start default Theatre wallpaper clip", "capture": { "action": "start", "name": "arc12-theatre-wallpaper" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "__runner_local_presentation__", "label": "show Theatre over the default wallpaper", "presentation_hold_ms": 1800, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "capture", "label": "stop default Theatre wallpaper clip", "capture": { "action": "stop" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] }
  ]
}
