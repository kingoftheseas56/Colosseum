{
  "name": "arc12_theatre_routes",
  "comment": "Arc 12 snap coverage through the production Main -> TheatreWorld route. No presentation harness.",
  "steps": [
    { "cmd": "ping", "expect": [{ "path": "gates.drive", "op": "==", "value": "true" }] },
    { "cmd": "ui-wait-for", "label": "boot splash has left", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "label": "fresh capture profile shows local-mode choice", "payload": { "object": "accountWelcomeContinueLocal", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "label": "continue without account", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "Home shell appears", "payload": { "object": "modePill_Tankoban", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "label": "enter Theatre", "payload": { "target": "modePill_Theatre" } },
    { "cmd": "ui-wait-for", "label": "production Theatre world appears", "payload": { "object": "theatreWorld", "prop": "visible", "value": true, "timeout_ms": 15000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "label": "production Discover finishes loading", "payload": { "object": "theatreDiscoverPage", "prop": "loading", "value": false, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "capture", "label": "start Discover and Movies clip", "capture": { "action": "start", "name": "arc12-theatre-discover-movies" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "__runner_local_presentation__", "label": "show production Theatre Discover", "presentation_hold_ms": 1200, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-scroll", "label": "bring the production Theatre tabs into view", "payload": { "target": "theatreWorldScroll", "dy": -650 }, "expect": [{ "path": "scrolled", "op": "==", "value": "theatreWorldScroll" }] },
    { "cmd": "__runner_local_presentation__", "label": "settle the Theatre board", "presentation_hold_ms": 700, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-click", "label": "open production Movies tab", "payload": { "target": "theatreTab_movies" } },
    { "cmd": "ui-wait-for", "label": "Movies tab is active", "payload": { "object": "theatreTab_movies", "prop": "activeState", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "label": "production Movies catalogue finishes loading", "payload": { "object": "theatreCatalogPage", "prop": "loading", "value": false, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "__runner_local_presentation__", "label": "show production Movies", "presentation_hold_ms": 1800, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "capture", "label": "stop Discover and Movies clip", "capture": { "action": "stop" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "capture", "label": "start Movies and Shows clip", "capture": { "action": "start", "name": "arc12-theatre-movies-shows" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "__runner_local_presentation__", "label": "show production Movies", "presentation_hold_ms": 900, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-click", "label": "open production Shows tab", "payload": { "target": "theatreTab_shows" } },
    { "cmd": "ui-wait-for", "label": "Shows tab is active", "payload": { "object": "theatreTab_shows", "prop": "activeState", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "label": "production Shows catalogue finishes loading", "payload": { "object": "theatreCatalogPage", "prop": "loading", "value": false, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "__runner_local_presentation__", "label": "show production Shows", "presentation_hold_ms": 1800, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "capture", "label": "stop Movies and Shows clip", "capture": { "action": "stop" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "capture", "label": "start Anime clip", "capture": { "action": "start", "name": "arc12-theatre-anime-featured" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-click", "label": "open production Anime tab", "payload": { "target": "theatreTab_anime" } },
    { "cmd": "ui-wait-for", "label": "Anime tab is active", "payload": { "object": "theatreTab_anime", "prop": "activeState", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "label": "production Anime catalogue finishes loading", "payload": { "object": "theatreCatalogPage", "prop": "loading", "value": false, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "__runner_local_presentation__", "label": "show production Anime", "presentation_hold_ms": 2000, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "capture", "label": "stop Anime clip", "capture": { "action": "stop" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] }
  ]
}
