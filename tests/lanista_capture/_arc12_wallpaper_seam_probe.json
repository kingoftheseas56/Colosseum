{
  "name": "arc12_wallpaper_seam_probe",
  "steps": [
    { "cmd": "ping" },
    { "cmd": "ui-wait-for", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 } },
    { "cmd": "ui-wait-for", "payload": { "object": "accountWelcomeContinueLocal", "prop": "visible", "value": true, "timeout_ms": 10000 } },
    { "cmd": "ui-click", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "payload": { "object": "modePill_Tankoban", "prop": "visible", "value": true, "timeout_ms": 10000 } },
    { "cmd": "ui-click", "label": "probe production wallpaper control", "payload": { "target": "topBarWallpaperButton" } },
    { "cmd": "ui-wait-for", "label": "probe wallpaper route", "payload": { "object": "wallpaperSearch", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] }
  ]
}
