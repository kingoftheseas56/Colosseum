{
    "name":  "theatre",
    "comment":  "Presentation-only harness around production TheatreCatalogPage with deterministic movie rows.",
    "steps":  [
                  {
                      "cmd":  "ping",
                      "label":  "Theatre capture session answers",
                      "expect":  [
                                     {
                                         "path":  "gates.drive",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Theatre catalogue surface is visible",
                      "payload":  {
                                      "object":  "theatreCatalogCapturePage",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  15000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Theatre catalogue is loaded",
                      "payload":  {
                                      "object":  "theatreCatalogCapturePage",
                                      "prop":  "loading",
                                      "value":  false,
                                      "timeout_ms":  15000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Theatre poster assets are decoded",
                      "payload":  {
                                      "object":  "theatrePosterGate",
                                      "prop":  "ready",
                                      "value":  true,
                                      "timeout_ms":  15000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "presentation_wait_ms":  250,
                      "cmd":  "__runner_local_presentation__",
                      "label":  "let cached Theatre posters paint",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ]
                  },
                  {
                      "capture":  {
                                      "action":  "start",
                                      "name":  "reddit-theatre-catalogue"
                                  },
                      "cmd":  "__runner_local_presentation__",
                      "label":  "start Theatre catalogue capture",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ]
                  },
                  {
                      "presentation_hold_ms":  1000,
                      "cmd":  "__runner_local_presentation__",
                      "label":  "show top movie rows",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-scroll",
                      "label":  "move through movie rows",
                      "payload":  {
                                      "target":  "theatreCatalogCaptureFlick",
                                      "dy":  -950
                                  },
                      "expect":  [
                                     {
                                         "path":  "scrolled",
                                         "op":  "==",
                                         "value":  "theatreCatalogCaptureFlick"
                                     }
                                 ]
                  },
                  {
                      "presentation_hold_ms":  1200,
                      "cmd":  "__runner_local_presentation__",
                      "label":  "show lower movie rows",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ]
                  },
                  {
                      "capture":  {
                                      "action":  "stop"
                                  },
                      "cmd":  "__runner_local_presentation__",
                      "label":  "stop Theatre catalogue capture",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ]
                  }
              ]
}