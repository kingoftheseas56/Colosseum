{
    "name":  "biblio",
    "comment":  "Biblio Discover to Explore. Live catalogue data may refresh during the run.",
    "steps":  [
                  {
                      "cmd":  "ping",
                      "label":  "isolated capture session answers",
                      "expect":  [
                                     {
                                         "path":  "gates.drive",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "boot splash has left",
                      "payload":  {
                                      "object":  "bootSplash",
                                      "prop":  "visible",
                                      "value":  false,
                                      "timeout_ms":  60000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "fresh capture profile shows local-mode choice",
                      "payload":  {
                                      "object":  "accountWelcomeContinueLocal",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  10000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "continue without account for disposable capture profile",
                      "payload":  {
                                      "target":  "accountWelcomeContinueLocal"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Home shell appears after local-mode choice",
                      "payload":  {
                                      "object":  "modePill_Tankoban",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  10000
                                  },
                      "expect":  [
                                     {
                                         "path":  "matched",
                                         "op":  "==",
                                         "value":  "true"
                                     }
                                 ]
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "enter Biblio",
                      "payload":  {
                                      "target":  "modePill_Biblio"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Biblio tab bar appears",
                      "payload":  {
                                      "object":  "biblioTabBar",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  10000
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "Discover finishes loading",
                      "payload":  {
                                      "object":  "biblioDiscoverPage",
                                      "prop":  "loading",
                                      "value":  false,
                                      "timeout_ms":  30000
                                  }
                  },
                  {
                      "presentation_wait_ms":  1200,
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ],
                      "label":  "let Biblio controls settle off-camera"
                  },
                  {
                      "capture":  {
                                      "action":  "start",
                                      "name":  "reddit-biblio-catalogue"
                                  },
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ],
                      "label":  "start Biblio catalogue capture"
                  },
                  {
                      "presentation_hold_ms":  800,
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ],
                      "label":  "show Discover"
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "open Explore",
                      "payload":  {
                                      "target":  "biblioTab_explore"
                                  }
                  },
                  {
                      "presentation_hold_ms":  2000,
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ],
                      "label":  "show Explore"
                  },
                  {
                      "capture":  {
                                      "action":  "stop"
                                  },
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ],
                      "label":  "stop Biblio catalogue capture"
                  }
              ]
}