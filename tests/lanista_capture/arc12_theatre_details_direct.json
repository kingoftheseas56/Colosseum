{
  "name": "arc12_theatre_details_direct",
  "comment": "Production Theatre Anime -> Attack on Titan detail -> source sheet, with direct Theatre boot to avoid hidden warm-loader ambiguity.",
  "steps": [
    { "cmd": "ping", "expect": [{ "path": "gates.drive", "op": "==", "value": "true" }] },
    { "cmd": "ui-wait-for", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "payload": { "object": "accountWelcomeContinueLocal", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "__runner_local_presentation__", "label": "allow direct Theatre world to paint", "presentation_wait_ms": 5000, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-wait-for", "payload": { "object": "theatreWorld", "prop": "visible", "value": true, "timeout_ms": 15000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "payload": { "object": "theatreDiscoverPage", "prop": "loading", "value": false, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-scroll", "payload": { "target": "theatreWorldScroll", "dy": -650 }, "expect": [{ "path": "scrolled", "op": "==", "value": "theatreWorldScroll" }] },
    { "cmd": "__runner_local_presentation__", "presentation_wait_ms": 1500, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-click", "payload": { "target": "theatreTab_anime" } },
    { "cmd": "ui-wait-for", "payload": { "object": "theatreTab_anime", "prop": "activeState", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "payload": { "object": "theatreCatalogPage", "prop": "loading", "value": false, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-scroll", "label": "bring the Attack on Titan catalogue card into view", "payload": { "target": "theatreWorldScroll", "dy": -750 }, "expect": [{ "path": "scrolled", "op": "==", "value": "theatreWorldScroll" }] },
    { "cmd": "__runner_local_presentation__", "presentation_wait_ms": 1000, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-wait-for", "label": "Attack on Titan catalogue card appears", "payload": { "object": "theatreCatalogCard_mal_16498", "prop": "visible", "value": true, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-query", "label": "verify Attack on Titan card is in the window", "payload": { "object": "theatreCatalogCard_mal_16498" }, "expect": [{ "path": "rect.y", "op": ">", "value": 96 }, { "path": "rect.y", "op": "<", "value": 1080 }, { "path": "rect.x", "op": ">", "value": 0 }] },
    { "cmd": "ui-click", "label": "open production Attack on Titan detail", "payload": { "target": "theatreCatalogCard_mal_16498" } },
    { "cmd": "ui-wait-for", "label": "production Theatre detail appears", "payload": { "object": "theatreSeriesPage", "prop": "visible", "value": true, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "label": "Attack on Titan detail finishes loading", "payload": { "object": "theatreSeriesPage", "prop": "loading", "value": false, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "label": "detail Watch action appears", "payload": { "object": "theatreSeriesWatch", "prop": "visible", "value": true, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "capture", "capture": { "action": "start", "name": "arc12-theatre-details-sources" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "__runner_local_presentation__", "presentation_hold_ms": 1200, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-click", "label": "open production source sheet", "payload": { "target": "theatreSeriesWatch" } },
    { "cmd": "ui-wait-for", "label": "production source sheet opens", "payload": { "object": "sourcesSheet", "prop": "open", "value": true, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "label": "production source lookup settles", "payload": { "object": "sourcesSheet", "prop": "loading", "value": false, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "__runner_local_presentation__", "presentation_hold_ms": 2200, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "capture", "capture": { "action": "stop" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] }
  ]
}
