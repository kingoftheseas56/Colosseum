{
  "name": "theatre_player",
  "comment": "Production mpv player via the existing seeded Open Recent route. Run with play-video-v1 seed.",
  "steps": [
    {
      "cmd": "ping",
      "label": "isolated capture session answers",
      "expect": [
        {
          "path": "gates.drive",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "boot splash has left",
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "fresh capture profile shows local-mode choice",
      "payload": {
        "object": "accountWelcomeContinueLocal",
        "prop": "visible",
        "value": true,
        "timeout_ms": 10000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "continue without account for disposable capture profile",
      "payload": {
        "target": "accountWelcomeContinueLocal"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "Home shell appears after local-mode choice",
      "payload": {
        "object": "modePill_Tankoban",
        "prop": "visible",
        "value": true,
        "timeout_ms": 10000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "open taskbar dock",
      "payload": {
        "target": "colosseumTaskbarHomeButton"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "Open Media settles",
      "payload": {
        "object": "taskbarOpenMedia",
        "prop": "visible",
        "value": true,
        "timeout_ms": 5000
      }
    },
    {
      "cmd": "ui-click",
      "label": "open Recent",
      "payload": {
        "target": "openRecentDisclosure"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "seeded recent row appears",
      "payload": {
        "object": "openRecentPanel",
        "prop": "rowCount",
        "value": 1,
        "timeout_ms": 8000
      }
    },
    {
      "cmd": "ui-click",
      "label": "open seeded video",
      "payload": {
        "target": "openRecentRow_0"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "player is active",
      "payload": {
        "object": "player",
        "prop": "playerActive",
        "value": true,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "player is ready",
      "payload": {
        "object": "player",
        "prop": "playerReady",
        "value": true,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-keypress",
      "label": "start seeded playback before recording",
      "payload": {
        "key": "Space"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "seeded playback actually advances",
      "payload": {
        "object": "player",
        "prop": "playbackStarted",
        "value": true,
        "timeout_ms": 10000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "capture": {
        "action": "start",
        "name": "probe-theatre-player"
      },
      "cmd": "__runner_local_presentation__",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
      ],
      "label": "start Theatre player capture"
    },
    {
      "presentation_hold_ms": 700,
      "cmd": "__runner_local_presentation__",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
      ],
      "label": "show player"
    },
    {
      "cmd": "ui-keypress",
      "label": "pause",
      "payload": {
        "key": "Space"
      }
    },
    {
      "presentation_hold_ms": 500,
      "cmd": "__runner_local_presentation__",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
      ],
      "label": "show paused state"
    },
    {
      "cmd": "ui-keypress",
      "label": "resume",
      "payload": {
        "key": "Space"
      }
    },
    {
      "presentation_hold_ms": 700,
      "cmd": "__runner_local_presentation__",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
      ],
      "label": "show playback"
    },
    {
      "capture": {
        "action": "stop"
      },
      "cmd": "__runner_local_presentation__",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
      ],
      "label": "stop Theatre player capture"
    }
  ]
}