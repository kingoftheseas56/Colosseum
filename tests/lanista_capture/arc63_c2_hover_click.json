{
  "name": "arc63-c2-production-hover-click",
  "comment": "Arc 63-C2: dismiss only the fresh-session onboarding fixture, then enter the real Universes world with point + pointer-click on its production KeyboardAction, scroll the production ledger until One Piece is pointerable, point with the real OS cursor, hold the real hover/Explore treatment, click through with pointer-click, and prove the One Piece Shelves universe opened. No direct QML activation shortcut substitutes for the One Piece click, and every route-critical wait asserts matched=true.",
  "steps": [
    {
      "cmd": "ping",
      "label": "isolated Drive session answers",
      "expect": [
        {
          "path": "gates.drive",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "boot splash releases",
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "dismiss fresh-session onboarding",
      "payload": {
        "target": "accountWelcomeContinueLocal"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "onboarding overlay closes before real pointer route",
      "payload": {
        "object": "accountHost",
        "prop": "visible",
        "value": false,
        "timeout_ms": 15000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "point",
      "label": "real pointer arrives on production Universes mode action",
      "payload": {
        "target": "modePillFocus_Universes",
        "duration_ms": 220,
        "path": "smoothstep",
        "tolerance_px": 2
      },
      "expect": [
        {
          "path": "pointed",
          "op": "==",
          "value": "modePillFocus_Universes"
        },
        {
          "path": "deltaX",
          "op": ">=",
          "value": -2
        },
        {
          "path": "deltaX",
          "op": "<=",
          "value": 2
        },
        {
          "path": "deltaY",
          "op": ">=",
          "value": -2
        },
        {
          "path": "deltaY",
          "op": "<=",
          "value": 2
        }
      ]
    },
    {
      "cmd": "pointer-click",
      "label": "real pointer enters production Universes world",
      "payload": {
        "target": "modePillFocus_Universes",
        "button": "left",
        "action": "click"
      },
      "expect": [
        {
          "path": "clicked",
          "op": "==",
          "value": "modePillFocus_Universes"
        },
        {
          "path": "submittedEvents",
          "op": "==",
          "value": 2
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "Universes world active",
      "payload": {
        "object": "universesWorld",
        "prop": "visible",
        "value": true,
        "timeout_ms": 10000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "One Piece production banner materialized",
      "payload": {
        "object": "universesBanner_onepiece",
        "prop": "visible",
        "value": true,
        "timeout_ms": 10000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "point",
      "label": "real pointer arrives on Manga facet",
      "payload": {
        "target": "universesFilter_manga",
        "duration_ms": 180,
        "path": "smoothstep",
        "tolerance_px": 2
      },
      "expect": [
        {
          "path": "pointed",
          "op": "==",
          "value": "universesFilter_manga"
        },
        {
          "path": "deltaX",
          "op": ">=",
          "value": -2
        },
        {
          "path": "deltaX",
          "op": "<=",
          "value": 2
        },
        {
          "path": "deltaY",
          "op": ">=",
          "value": -2
        },
        {
          "path": "deltaY",
          "op": "<=",
          "value": 2
        }
      ]
    },
    {
      "cmd": "pointer-click",
      "label": "real pointer narrows production roster to Manga",
      "payload": {
        "target": "universesFilter_manga",
        "button": "left",
        "action": "click"
      },
      "expect": [
        {
          "path": "clicked",
          "op": "==",
          "value": "universesFilter_manga"
        },
        {
          "path": "submittedEvents",
          "op": "==",
          "value": 2
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "Manga facet settles",
      "payload": {
        "object": "universesWorld",
        "prop": "facet",
        "value": "manga",
        "timeout_ms": 5000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-keypress",
      "label": "Down leaves the Manga facet through the production spatial router",
      "payload": {
        "key": "Down"
      },
      "expect": [
        {
          "path": "pressed",
          "op": "==",
          "value": "Down"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "production spatial router lands the universe ledger",
      "payload": {
        "object": "universesLedger",
        "prop": "activeFocus",
        "value": true,
        "timeout_ms": 5000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-keypress",
      "label": "Manga row 1 to Dragon Ball",
      "payload": {
        "key": "Down"
      },
      "expect": [
        {
          "path": "pressed",
          "op": "==",
          "value": "Down"
        }
      ]
    },
    {
      "cmd": "ui-keypress",
      "label": "Manga row 2 to Naruto",
      "payload": {
        "key": "Down"
      },
      "expect": [
        {
          "path": "pressed",
          "op": "==",
          "value": "Down"
        }
      ]
    },
    {
      "cmd": "ui-keypress",
      "label": "Manga row 3 to One Piece",
      "payload": {
        "key": "Down"
      },
      "expect": [
        {
          "path": "pressed",
          "op": "==",
          "value": "Down"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "production ledger reveals One Piece at index 3",
      "payload": {
        "object": "universesLedger",
        "props": [
          "currentIndex"
        ]
      },
      "expect": [
        {
          "path": "props.currentIndex",
          "op": "==",
          "value": 3
        }
      ]
    },
    {
      "cmd": "ui-keypress",
      "label": "Tab leaves ledger so keyboard selection cannot fake hover",
      "payload": {
        "key": "Tab"
      },
      "expect": [
        {
          "path": "pressed",
          "op": "==",
          "value": "Tab"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "ledger releases keyboard focus",
      "payload": {
        "object": "universesLedger",
        "prop": "activeFocus",
        "value": false,
        "timeout_ms": 5000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "presentation_wait_ms": 350,
      "label": "let keyboard movement and page walking settle before hover proof"
    },
    {
      "cmd": "qml-get",
      "label": "One Piece starts without pointer hover",
      "payload": {
        "object": "universesBanner_onepiece",
        "props": [
          "hot",
          "keyboardSelected",
          "lit"
        ]
      },
      "expect": [
        {
          "path": "props.hot",
          "op": "==",
          "value": "false"
        },
        {
          "path": "props.keyboardSelected",
          "op": "==",
          "value": "false"
        },
        {
          "path": "props.lit",
          "op": "==",
          "value": "false"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "One Piece Explore starts hidden",
      "payload": {
        "object": "universesBanner_onepiece_explore",
        "props": [
          "opacity"
        ]
      },
      "expect": [
        {
          "path": "props.opacity",
          "op": "<=",
          "value": 0.05
        }
      ]
    },
    {
      "capture": {
        "action": "start",
        "name": "arc63-c2-onepiece-hover-click"
      },
      "label": "start production hover-click shot"
    },
    {
      "presentation_hold_ms": 350,
      "label": "pre-hover beat"
    },
    {
      "cmd": "point",
      "label": "real pointer arrives on One Piece",
      "payload": {
        "target": "universesBanner_onepiece",
        "duration_ms": 700,
        "path": "smoothstep",
        "tolerance_px": 2
      },
      "expect": [
        {
          "path": "pointed",
          "op": "==",
          "value": "universesBanner_onepiece"
        },
        {
          "path": "deltaX",
          "op": ">=",
          "value": -2
        },
        {
          "path": "deltaX",
          "op": "<=",
          "value": 2
        },
        {
          "path": "deltaY",
          "op": ">=",
          "value": -2
        },
        {
          "path": "deltaY",
          "op": "<=",
          "value": 2
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "real production hover becomes active",
      "payload": {
        "object": "universesBanner_onepiece",
        "prop": "hot",
        "value": true,
        "timeout_ms": 3000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "presentation_hold_ms": 600,
      "label": "hold on real One Piece hover treatment"
    },
    {
      "cmd": "qml-get",
      "label": "One Piece Explore affordance is fully revealed",
      "payload": {
        "object": "universesBanner_onepiece_explore",
        "props": [
          "opacity",
          "visible"
        ]
      },
      "expect": [
        {
          "path": "props.opacity",
          "op": ">=",
          "value": 0.95
        },
        {
          "path": "props.visible",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "pointer-click",
      "label": "real pointer clicks One Piece production banner",
      "payload": {
        "target": "universesBanner_onepiece",
        "button": "left",
        "action": "click"
      },
      "expect": [
        {
          "path": "clicked",
          "op": "==",
          "value": "universesBanner_onepiece"
        },
        {
          "path": "submittedEvents",
          "op": "==",
          "value": 2
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "One Piece Shelves destination opens",
      "payload": {
        "object": "shelvesUniversePage",
        "prop": "visible",
        "value": true,
        "timeout_ms": 10000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "destination identity is exactly One Piece",
      "payload": {
        "object": "shelvesUniversePage",
        "props": [
          "universeName",
          "visible"
        ]
      },
      "expect": [
        {
          "path": "props.universeName",
          "op": "==",
          "value": "One Piece"
        },
        {
          "path": "props.visible",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "One Piece Shelves scroll surface is live",
      "payload": {
        "object": "shelvesScroll",
        "prop": "visible",
        "value": true,
        "timeout_ms": 10000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "presentation_hold_ms": 700,
      "label": "One Piece destination beat"
    },
    {
      "capture": {
        "action": "stop"
      },
      "label": "stop production hover-click shot"
    }
  ]
}
