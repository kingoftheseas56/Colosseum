{
  "name": "manga-window-probe",
  "steps": [
    { "cmd": "ping", "label": "probe session answers",
      "expect": [ { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "Manga surface is visible",
      "payload": { "object": "mangaCaptureFlick", "prop": "visible", "value": true, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "Manga posters decoded",
      "payload": { "object": "mangaPosterGate", "prop": "ready", "value": true, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "capture": { "action": "start", "name": "probe-manga-window" },
      "cmd": "__runner_local_presentation__", "label": "start capture",
      "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "__runner_local_presentation__", "presentation_hold_ms": 5000,
      "label": "hold capture for z-order inspection 1",
      "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "__runner_local_presentation__", "presentation_hold_ms": 5000,
      "label": "hold capture for z-order inspection 2",
      "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "__runner_local_presentation__", "presentation_hold_ms": 5000,
      "label": "hold capture for z-order inspection 3",
      "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "capture": { "action": "stop" }, "cmd": "__runner_local_presentation__",
      "label": "stop capture", "expect": [ { "path": "type", "op": "==", "value": "reply" } ] }
  ]
}
