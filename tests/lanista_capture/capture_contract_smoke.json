{
    "name":  "presentation-capture-contract-smoke",
    "steps":  [
                  {
                      "cmd":  "ping",
                      "label":  "capture session answers",
                      "expect":  [
                                     {
                                         "path":  "schema",
                                         "op":  "matches",
                                         "value":  "^colosseum\\.dev\\.v1"
                                     }
                                 ]
                  },
                  {
                      "capture":  {
                                      "action":  "start",
                                      "name":  "lanista-contract-smoke"
                                  },
                      "label":  "start presentation recording",
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ]
                  },
                  {
                      "presentation_hold_ms":  800,
                      "label":  "hold the visible frame",
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ]
                  },
                  {
                      "capture":  {
                                      "action":  "stop"
                                  },
                      "label":  "stop presentation recording",
                      "cmd":  "__runner_local_presentation__",
                      "expect":  [
                                     {
                                         "path":  "type",
                                         "op":  "==",
                                         "value":  "reply"
                                     }
                                 ]
                  }
              ]
}
