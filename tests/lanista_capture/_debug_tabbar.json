{
    "name":  "debug-tabbar",
    "steps":  [
                  {
                      "cmd":  "ping",
                      "label":  "ping"
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "boot",
                      "payload":  {
                                      "object":  "bootSplash",
                                      "prop":  "visible",
                                      "value":  false,
                                      "timeout_ms":  60000
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "local",
                      "payload":  {
                                      "object":  "accountWelcomeContinueLocal",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  10000
                                  }
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "local click",
                      "payload":  {
                                      "target":  "accountWelcomeContinueLocal"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "home",
                      "payload":  {
                                      "object":  "modePill_Tankoban",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  10000
                                  }
                  },
                  {
                      "cmd":  "ui-click",
                      "label":  "enter",
                      "payload":  {
                                      "target":  "modePill_Tankoban"
                                  }
                  },
                  {
                      "cmd":  "ui-wait-for",
                      "label":  "bar",
                      "payload":  {
                                      "object":  "tankobanTabBar",
                                      "prop":  "visible",
                                      "value":  true,
                                      "timeout_ms":  10000
                                  }
                  },
                  {
                      "cmd":  "qml-get",
                      "label":  "bar props",
                      "payload":  {
                                      "object":  "tankobanTabBar",
                                      "props":  [
                                                    "tabModel",
                                                    "currentTab",
                                                    "tabPrefix",
                                                    "width",
                                                    "height",
                                                    "visible"
                                                ]
                                  }
                  },
                  {
                      "cmd":  "dump-ui",
                      "label":  "bar dump",
                      "payload":  {
                                      "root":  "tankobanTabBar",
                                      "maxDepth":  8
                                  }
                  },
                  {
                      "cmd":  "ui-query",
                      "label":  "library query",
                      "payload":  {
                                      "target":  "tankobanTab_library"
                                  }
                  },
                  {
                      "cmd":  "ui-query",
                      "label":  "discover query",
                      "payload":  {
                                      "target":  "tankobanTab_discover"
                                  }
                  }
              ]
}