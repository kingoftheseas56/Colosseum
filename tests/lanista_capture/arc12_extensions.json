{
  "name": "arc12_extensions",
  "comment": "Arc 12 Extensions installed surface through production Main -> Taskbar -> ExtensionsPage.",
  "steps": [
    { "cmd": "ping", "expect": [{ "path": "gates.drive", "op": "==", "value": "true" }] },
    { "cmd": "ui-wait-for", "label": "boot splash has left", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "label": "fresh capture profile shows local-mode choice", "payload": { "object": "accountWelcomeContinueLocal", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "label": "continue without account", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "Home shell appears", "payload": { "object": "modePill_Tankoban", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "label": "open shared taskbar dock", "payload": { "target": "colosseumTaskbarHomeButton" } },
    { "cmd": "ui-wait-for", "label": "Extensions control settles", "payload": { "object": "taskbarExtensions", "prop": "visible", "value": true, "timeout_ms": 5000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "label": "open production Extensions page", "payload": { "target": "taskbarExtensions" } },
    { "cmd": "ui-wait-for", "label": "production Extensions page appears", "payload": { "object": "extensionsPage", "prop": "visible", "value": true, "timeout_ms": 15000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "label": "open Installed pane", "payload": { "target": "extensionsPaneTab_installed" } },
    { "cmd": "ui-wait-for", "label": "Installed pane is selected", "payload": { "object": "extensionsPage", "prop": "pane", "value": "installed", "timeout_ms": 5000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "capture", "label": "start production Extensions clip", "capture": { "action": "start", "name": "arc12-extensions-installed" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "__runner_local_presentation__", "label": "show installed Extensions", "presentation_hold_ms": 2200, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "capture", "label": "stop production Extensions clip", "capture": { "action": "stop" }, "cmd": "__runner_local_presentation__", "expect": [{ "path": "type", "op": "==", "value": "reply" }] }
  ]
}
