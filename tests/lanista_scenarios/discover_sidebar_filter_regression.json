  },
  {
   "cmd": "qml-get",
   "label": "tankoban summary names it",
   "payload": {
    "object": "tankobanDiscoverBrowser",
    "props": [
     "automationFilterSummary",
     "activeFilterCount"
    ]
   },
   "expect": [
    {
     "path": "props.automationFilterSummary",
