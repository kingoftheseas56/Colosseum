  {
   "cmd": "ui-click",
   "label": "tankoban reopen the picker",
   "payload": {
    "target": "tankobanDiscoverFilterPickerPill"
   }
  },
  {
   "cmd": "ui-click",
   "label": "tankoban choose All",
   "payload": {
    "target": "tankobanDiscoverFilterPickerOption_0"
   }
  },
  {
   "cmd": "ui-wait-for",
   "label": "tankoban filters cleared",
   "payload": {
    "object": "tankobanDiscoverBrowser",
