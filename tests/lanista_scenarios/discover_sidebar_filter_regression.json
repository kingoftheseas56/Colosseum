   }
  },
  {
   "cmd": "ui-wait-for",
   "label": "biblio filters cleared",
   "payload": {
    "object": "biblioDiscoverBrowser",
    "prop": "activeFilterCount",
    "value": 0,
    "timeout_ms": 10000
   },
   "expect": [
    {
     "path": "matched",
     "op": "==",
     "value": "true"
    }
   ]
  },
  {
   "cmd": "ui-keypress",
   "label": "back to Home",
   "payload": {
    "key": "Escape"
   }
  },
  {
   "cmd": "ui-click",
   "label": "enter tankoban",
   "payload": {
    "target": "modePill_Tankoban"
   }
  },
  {
   "cmd": "ui-wait-for",
