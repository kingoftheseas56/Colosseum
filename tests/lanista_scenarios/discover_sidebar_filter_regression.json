   "label": "biblio open the filter picker",
   "payload": {
    "target": "biblioDiscoverFilterPickerPill"
   }
  },
  {
   "cmd": "ui-click",
   "label": "biblio choose the first real option (0 = All, 1 = a group header in multi-group worlds)",
   "payload": {
    "target": "biblioDiscoverFilterPickerOption_2"
   }
  },
  {
   "cmd": "ui-wait-for",
   "label": "biblio exactly one filter active",
   "payload": {
    "object": "biblioDiscoverBrowser",
    "prop": "activeFilterCount",
    "value": 1,
    "timeout_ms": 10000
   },
   "expect": [
    {
     "path": "matched",
