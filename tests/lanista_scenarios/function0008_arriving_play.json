{
  "name": "function0008-arriving-play",
  "comment": "Assembled-app arriving-play proof. The fixture holds the first Direct download after the .part crosses the production 8 MiB disk-first floor. Lanista clicks the real Downloads Play control, proves decoded disk-first playback, then proves the production frontier handoff points Player 1 at the live loopback Direct URL and decodes again. The Python driver releases the held download only after the loopback observes a second, header-valid media request and separately requires the final output file to have landed before PASS.",
  "steps": [
    {
      "cmd": "ping",
      "label": "isolated Drive-enabled Lanista session answers",
      "expect": [
        {
          "path": "schema",
          "op": "matches",
          "value": "^colosseum\\.dev\\.v1"
        },
        {
          "path": "gates.drive",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "the app reports the disposable Function 0008 arriving roots",
      "expect": [
        {
          "path": "appDataRoot",
          "op": "contains",
          "value": "Colosseum-dltest-function0008-arriving-"
        },
        {
          "path": "cacheRoot",
          "op": "contains",
          "value": "Colosseum-dltest-function0008-arriving-"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "boot completes",
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "fresh tagged profile exposes continue-local onboarding",
      "payload": {
        "object": "accountWelcomeContinueLocal",
        "prop": "visible",
        "value": true,
        "timeout_ms": 15000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "continue locally without touching a real account",
      "payload": {
        "target": "accountWelcomeContinueLocal"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "onboarding dismisses",
      "payload": {
        "object": "accountHost",
        "prop": "visible",
        "value": false,
        "timeout_ms": 15000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "active seeded download auto-reveals the taskbar",
      "payload": {
        "object": "taskbarDownloads",
        "prop": "visible",
        "value": true,
        "timeout_ms": 15000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "record the auto-revealed taskbar state without toggling it",
      "payload": {
        "object": "colosseumTaskbar",
        "props": [
          "open"
        ]
      },
      "expect": [
        {
          "path": "props.open",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "Downloads taskbar button is actionable",
      "payload": {
        "object": "taskbarDownloads",
        "prop": "visible",
        "value": true,
        "timeout_ms": 5000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "open the production Downloads page",
      "payload": {
        "target": "taskbarDownloads"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "Downloads page is mounted",
      "payload": {
        "object": "downloadsPage",
        "prop": "visible",
        "value": true,
        "timeout_ms": 10000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "the real arriving Play control is visible for the resolved Direct job",
      "payload": {
        "object": "downloadsPlayArriving_function0008-direct-video",
        "prop": "visible",
        "value": true,
        "timeout_ms": 30000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "the .part crossed the exact production disk-first floor",
      "payload": {
        "object": "downloadsPlayArriving_function0008-direct-video",
        "prop": "diskFirstReady",
        "value": true,
        "timeout_ms": 30000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "record Downloads projections before arriving playback",
      "payload": {
        "object": "downloadsPage",
        "props": [
          "liveJobCount",
          "attentionCount",
          "totalsMap"
        ]
      },
      "expect": [
        {
          "path": "props.attentionCount",
          "op": "==",
          "value": 0
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "click the production arriving Play control",
      "payload": {
        "target": "downloadsPlayArriving_function0008-direct-video"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "Player 1 decodes a real frame",
      "payload": {
        "object": "player",
        "prop": "playerReady",
        "value": true,
        "timeout_ms": 30000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "record Player 1 identity before the frontier handoff",
      "payload": {
        "object": "player",
        "props": [
          "playerReady",
          "sourceIdentity",
          "mediaTransport",
          "currentPlaybackUrl"
        ]
      },
      "expect": [
        {
          "path": "props.playerReady",
          "op": "==",
          "value": true
        },
        {
          "path": "props.sourceIdentity",
          "op": "==",
          "value": "function0008-direct-video"
        },
        {
          "path": "props.mediaTransport",
          "op": "==",
          "value": "Downloaded"
        },
        {
          "path": "props.currentPlaybackUrl",
          "op": "contains",
          "value": ".part"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "production frontier watcher hands the arriving session to HTTP",
      "payload": {
        "object": "player",
        "prop": "mediaTransport",
        "value": "Arriving",
        "timeout_ms": 30000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "frontier switch now points Player 1 at the live original Direct URL",
      "payload": {
        "object": "player",
        "props": [
          "currentPlaybackUrl"
        ]
      },
      "expect": [
        {
          "path": "props.currentPlaybackUrl",
          "op": "matches",
          "value": "^http://127\\.0\\.0\\.1:[0-9]+/video\\.mp4$"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "Player 1 decodes again after the HTTP frontier handoff",
      "payload": {
        "object": "player",
        "prop": "playerReady",
        "value": true,
        "timeout_ms": 30000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "final post-frontier player truth",
      "payload": {
        "object": "player",
        "props": [
          "playerReady",
          "sourceIdentity",
          "mediaTransport",
          "currentPlaybackUrl"
        ]
      },
      "expect": [
        {
          "path": "props.playerReady",
          "op": "==",
          "value": true
        },
        {
          "path": "props.sourceIdentity",
          "op": "==",
          "value": "function0008-direct-video"
        },
        {
          "path": "props.mediaTransport",
          "op": "==",
          "value": "Arriving"
        },
        {
          "path": "props.currentPlaybackUrl",
          "op": "matches",
          "value": "^http://127\\.0\\.0\\.1:[0-9]+/video\\.mp4$"
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "capture final arriving-play state",
      "payload": {
        "grab": {
          "target": "window"
        }
      },
      "expect": [
        {
          "path": "windows.0.visible",
          "op": "==",
          "value": true
        }
      ]
    }
  ]
}
