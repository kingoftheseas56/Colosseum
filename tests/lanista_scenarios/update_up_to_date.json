{
  "name": "update-up-to-date",
  "comment": "Lanista Slice L2: a disposable session with no newer verified release still opens the chronicle, reports UpToDate, and keeps the latest release notes visible.",
  "steps": [
    { "cmd": "ping", "label": "the update test session answers",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "one visible window",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" },
                  { "path": "appDataRoot", "op": "contains", "value": "updater-current" },
                  { "path": "cacheRoot", "op": "contains", "value": "updater-current" } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash has left the screen",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 } },
    { "cmd": "ui-click", "label": "open the update chronicle",
      "payload": { "target": "colosseumUpdateTaskbarButton" } },
    { "cmd": "ui-wait-for", "label": "the update page is on screen",
      "payload": { "object": "colosseumUpdatePage", "prop": "visible", "value": true, "timeout_ms": 8000 } },
    { "cmd": "ui-wait-for", "label": "the page reports the up-to-date state",
      "payload": { "object": "colosseumUpdatePage", "prop": "automationState", "value": "UpToDate", "timeout_ms": 8000 } },
    { "cmd": "qml-get", "label": "the page exposes the up-to-date contract",
      "payload": { "object": "colosseumUpdatePage", "props": ["automationState", "automationVersion", "primaryLabel"] },
      "expect": [ { "path": "props.automationState", "op": "==", "value": "UpToDate" },
                  { "path": "props.automationVersion", "op": "exists" },
                  { "path": "props.primaryLabel", "op": "==", "value": "No updates available" } ] },
    { "cmd": "ui-query", "label": "the no-update action remains a manual check affordance",
      "payload": { "object": "colosseumUpdatePrimaryAction" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" },
                  { "path": "enabled", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "the latest release highlights remain in the chronicle",
      "payload": { "object": "colosseumUpdateHighlights" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "the chronicle status is visible",
      "payload": { "object": "colosseumUpdateStatusText" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "evidence: the whole window with the retained latest-release chronicle",
      "payload": { "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] }
  ]
}
