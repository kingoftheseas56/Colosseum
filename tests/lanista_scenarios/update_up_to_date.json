{
  "name": "update-up-to-date",
  "comment": "Lanista Slice L2: a disposable session with no newer verified release still opens the chronicle, reports UpToDate, and keeps the latest release notes visible.",
  "steps": [
    { "cmd": "ping", "label": "the update test session answers",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "one visible window",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" },
                  { "path": "windows.0.width", "op": "==", "value": 1280 },
                  { "path": "windows.0.height", "op": "==", "value": 720 },
                  { "path": "appDataRoot", "op": "contains", "value": "updater-current" },
                  { "path": "cacheRoot", "op": "contains", "value": "updater-current" } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash has left the screen",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the taskbar to reach the retained update chronicle",
      "payload": { "target": "colosseumTaskbarHomeButton" } },
    { "cmd": "ui-wait-for", "label": "the update taskbar item is exposed",
      "payload": { "object": "colosseumUpdateTaskbarButton", "prop": "visible", "value": true, "timeout_ms": 3000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the update chronicle",
      "payload": { "target": "colosseumUpdateTaskbarButton" } },
    { "cmd": "ui-wait-for", "label": "the update page is on screen",
      "payload": { "object": "colosseumUpdatePage", "prop": "visible", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the page reports the up-to-date state",
      "payload": { "object": "colosseumUpdatePage", "prop": "automationState", "value": "UpToDate", "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the retained chapter title has rendered",
      "payload": { "object": "colosseumUpdateChapterTitle", "prop": "text", "value": "Colosseum 1.1.1", "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the retained chapter body has rendered",
      "payload": { "object": "colosseumUpdateChapterBody", "prop": "text", "value": "The house keeps itself current.", "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the retained inline chapter navigator is visible",
      "payload": { "object": "colosseumUpdateChapterNav", "prop": "visible", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the rendered monochrome stage has settled",
      "payload": { "object": "colosseumUpdateGallery", "prop": "automationStageSettled", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the retained living gallery has presented a visual frame",
      "payload": { "object": "colosseumUpdateGallery", "prop": "automationVisualReady", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the ordinary taskbar stays visible above the chronicle",
      "payload": { "object": "colosseumUpdateTaskbarButton", "prop": "visible", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the page exposes the up-to-date contract",
      "payload": { "object": "colosseumUpdatePage", "props": ["automationState", "automationVersion", "primaryLabel"] },
      "expect": [ { "path": "props.automationState", "op": "==", "value": "UpToDate" },
                  { "path": "props.automationVersion", "op": "exists" },
                  { "path": "props.primaryLabel", "op": "==", "value": "Check again" } ] },
    { "cmd": "ui-query", "label": "the taskbar-owned no-update action remains a manual check affordance",
      "payload": { "object": "colosseumUpdatePrimaryAction" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" },
                  { "path": "enabled", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "the living gallery remains in the chronicle",
      "payload": { "object": "colosseumUpdateGallery" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the retained chronicle has a single fallback chapter",
      "payload": { "object": "colosseumUpdateGallery", "props": ["chapterCount", "automationLogicalWidth", "automationLogicalHeight", "automationDevicePixelRatio"] },
      "expect": [ { "path": "props.chapterCount", "op": "==", "value": 1 },
                  { "path": "props.automationLogicalWidth", "op": "==", "value": 1280 },
                  { "path": "props.automationLogicalHeight", "op": "==", "value": 720 },
                  { "path": "props.automationDevicePixelRatio", "op": "exists" } ] },
    { "cmd": "qml-get", "label": "the taskbar owns honest installed and latest update metadata",
      "payload": { "object": "colosseumTaskbar", "props": ["updateStatusText", "updateMetadataText", "updatePrimaryLabel", "updatePrimaryVisible"] },
      "expect": [ { "path": "props.updateStatusText", "op": "==", "value": "Everything is up to date" },
                  { "path": "props.updateMetadataText", "op": "==", "value": "Installed 1.1.1 \u00b7 Latest 1.1.1" },
                  { "path": "props.updatePrimaryLabel", "op": "==", "value": "Check again" },
                  { "path": "props.updatePrimaryVisible", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "evidence: the whole window with the retained latest-release chronicle",
      "payload": { "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] }
  ]
}
