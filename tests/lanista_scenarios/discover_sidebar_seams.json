    "value": "book",
    "timeout_ms": 30000
   },
   "expect": [
    {
     "path": "matched",
     "op": "==",
     "value": "true"
    }
   ]
  },
  {
   "cmd": "ui-wait-for",
   "label": "biblio Discover finished loading",
   "payload": {
    "object": "biblioDiscoverBrowser",
    "prop": "loading",
    "value": false,
    "timeout_ms": 30000
   },
   "expect": [
    {
     "path": "matched",
     "op": "==",
     "value": "true"
    }
   ]
  },
  {
   "cmd": "qml-get",
   "label": "biblio seams resolve; both pickers present (categories top right, filters in their dropdown)",
   "payload": {
    "object": "biblioDiscoverBrowser",
    "props": [
     "automationLegacyPickerCount",
     "automationType",
     "automationCatalogKey",
     "automationItemCount"
    ]
   },
   "expect": [
    {
     "path": "props.automationLegacyPickerCount",
     "op": "==",
     "value": "2"
    },
    {
     "path": "props.automationCatalogKey",
     "op": "!=",
     "value": ""
    }
   ]
  },
  {
   "cmd": "qml-get",
   "label": "biblio rail names its source addon, starts closed; posters seven across",
   "payload": {
    "object": "biblioDiscoverSidebar",
    "props": [
     "automationRows",
     "collapsed"
    ]
   },
   "expect": [
    {
     "path": "props.automationRows",
     "op": "contains",
     "value": "Apple Books"
    },
    {
     "path": "props.collapsed",
     "op": "==",
     "value": "true"
    }
   ]
  },
  {
   "cmd": "qml-get",
   "label": "biblio wall: seven columns with the rail closed",
   "payload": {
    "object": "biblioDiscoverBrowser",
    "props": [
     "_galleryColumnCountForTest"
    ]
   },
   "expect": [
    {
     "path": "props._galleryColumnCountForTest",
     "op": "==",
     "value": "7"
    }
   ]
  },
  {
   "cmd": "qml-get",
   "label": "biblio wall name resolves",
   "payload": {
    "object": "biblioDiscoverWall",
    "props": [
     "visible"
    ]
   },
   "expect": [
    {
     "path": "props.visible",
     "op": "==",
     "value": "true"
    }
   ]
  },
  {
   "cmd": "ui-keypress",
   "label": "back to Home",
   "payload": {
    "key": "Escape"
   }
  },
  {
   "cmd": "ui-click",
   "label": "enter tankoban",
   "payload": {
    "target": "modePill_Tankoban"
   }
  },
  {
   "cmd": "ui-wait-for",
   "label": "tankoban tab bar up",
   "payload": {
    "object": "tankobanTabBar",
    "prop": "visible",
    "value": true,
    "timeout_ms": 15000
   },
   "expect": [
    {
     "path": "matched",
     "op": "==",
     "value": "true"
    }
   ]
  },
  {
   "cmd": "ui-click",
   "label": "tankoban Discover tab",
   "payload": {
