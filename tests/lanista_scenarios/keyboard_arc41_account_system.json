{
  "name": "keyboard-arc41-account-system",
  "comment": "Arc 41 K-06 live matrix: onboarding traversal, editable-field precedence, local AccountFlyout focus/escape restoration, and Update-page keyboard entry. Setup clicks are used only where no global route exists; the assertions exercise real key delivery.",
  "steps": [
    { "cmd": "ping", "label": "isolated driven session answers",
      "expect": [ { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "boot splash leaves",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "welcome hands initial focus to Continue",
      "payload": { "object": "accountWelcomeContinueLocal", "props": ["activeFocus"] },
      "expect": [ { "path": "props.activeFocus", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Tab advances within onboarding", "payload": { "key": "Tab" } },
    { "cmd": "qml-get", "label": "Sign in choice owns focus after Tab",
      "payload": { "object": "accountWelcomeSignIn", "props": ["activeFocus"] },
      "expect": [ { "path": "props.activeFocus", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Shift Tab returns to Continue", "payload": { "key": "Shift+Tab" } },
    { "cmd": "qml-get", "label": "Continue owns focus again",
      "payload": { "object": "accountWelcomeContinueLocal", "props": ["activeFocus"] },
      "expect": [ { "path": "props.activeFocus", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Tab reaches Sign in again", "payload": { "key": "Tab" } },
    { "cmd": "ui-keypress", "label": "Enter opens Sign in route", "payload": { "key": "Enter" } },
    { "cmd": "ui-wait-for", "label": "Sign in surface becomes visible",
      "payload": { "object": "accountSignIn", "prop": "visible", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "username field receives route-entry focus",
      "payload": { "object": "accountSignInUsername", "props": ["activeFocus"] },
      "expect": [ { "path": "props.activeFocus", "op": "==", "value": "true" } ] },
    { "cmd": "ui-text-input", "label": "type into focused username field",
      "payload": { "target": "accountSignInUsername", "text": "KeyboardProbe" } },
    { "cmd": "ui-keypress", "label": "Tab leaves username for password", "payload": { "key": "Tab" } },
    { "cmd": "qml-get", "label": "password field owns focus",
      "payload": { "object": "accountSignInPassword", "props": ["activeFocus"] },
      "expect": [ { "path": "props.activeFocus", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Shift Tab returns to username", "payload": { "key": "Shift+Tab" } },
    { "cmd": "qml-get", "label": "username field regains focus",
      "payload": { "object": "accountSignInUsername", "props": ["activeFocus", "text"] },
      "expect": [ { "path": "props.activeFocus", "op": "==", "value": "true" },
                  { "path": "props.text", "op": "==", "value": "KeyboardProbe" } ] },
    { "cmd": "ui-click", "label": "return to local shell via existing action", "payload": { "target": "accountSignInContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "account host releases shell",
      "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 10000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open Account flyout from its production shell control",
      "payload": { "target": "colosseumTopbarAccountButton" } },
    { "cmd": "ui-wait-for", "label": "Account flyout opens",
      "payload": { "object": "accountFlyout", "prop": "visible", "value": true, "timeout_ms": 5000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "local session action receives flyout focus",
      "payload": { "object": "accountFlyoutSessionAction", "props": ["activeFocus"] },
      "expect": [ { "path": "props.activeFocus", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Escape closes Account flyout", "payload": { "key": "Escape" } },
    { "cmd": "ui-wait-for", "label": "Account flyout closes from keyboard",
      "payload": { "object": "accountFlyout", "prop": "visible", "value": false, "timeout_ms": 5000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },

    { "cmd": "ui-click", "label": "open Update page from production top bar", "payload": { "target": "colosseumTopbarUpdateButton" } },
    { "cmd": "ui-wait-for", "label": "Update page opens",
      "payload": { "object": "colosseumUpdatePage", "prop": "visible", "value": true, "timeout_ms": 5000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Escape exits Update page", "payload": { "key": "Escape" } },
    { "cmd": "ui-wait-for", "label": "Update Loader deactivates from keyboard",
      "payload": { "object": "updateLayer", "prop": "active", "value": false, "timeout_ms": 5000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] }
  ]
}
