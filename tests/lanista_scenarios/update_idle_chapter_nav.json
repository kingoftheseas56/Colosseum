{
  "name": "update-idle-chapter-nav",
  "comment": "Diagnostic probe (Slice 4d chapter-transition flash): opens the installed chronicle at rest, navigates to chapter 2, and confirms the stage re-settles on the new chapter's content with an opaque backing (no home-page bleed-through). Disposable shipping-build probe; the base-plate fix makes the gallery z-stack opaque so the monochrome-stage opacity dip during a source swap reads as a brief dim, not a flash of the page behind.",
  "steps": [
    { "cmd": "ping", "label": "the chapter-nav probe session answers",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "one visible window",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" },
                  { "path": "windows.0.width", "op": "==", "value": 1280 },
                  { "path": "windows.0.height", "op": "==", "value": 720 } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash has left the screen",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the home topbar Update glyph is visible",
      "payload": { "object": "colosseumTopbarUpdateButton", "prop": "visible", "value": true, "timeout_ms": 30000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the update page from the topbar glyph",
      "payload": { "target": "colosseumTopbarUpdateButton" } },
    { "cmd": "ui-wait-for", "label": "the update page is on screen",
      "payload": { "object": "colosseumUpdatePage", "prop": "visible", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the page reports the idle state at rest",
      "payload": { "object": "colosseumUpdatePage", "prop": "automationState", "value": "Idle", "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "chapter 1 title has rendered before navigation",
      "payload": { "object": "colosseumUpdateChapterTitle", "prop": "text", "value": "Reader", "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the stage has settled on chapter 1",
      "payload": { "object": "colosseumUpdateGallery", "prop": "automationVisualReady", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "evidence: chapter 1 settled before navigation",
      "payload": { "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "ui-click", "label": "advance to chapter 2 via the next-chapter control",
      "payload": { "target": "colosseumUpdateNextChapter" } },
    { "cmd": "ui-wait-for", "label": "the chapter counter advanced to 02 / 05",
      "payload": { "object": "colosseumUpdateChapterCount", "prop": "text", "value": "02 / 05", "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the stage re-settled on chapter 2 (opacity returned, opaque base held)",
      "payload": { "object": "colosseumUpdateGallery", "prop": "automationVisualReady", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "chapter 2 title has rendered (the stage did not collapse)",
      "payload": { "object": "colosseumUpdateChapterTitle", "prop": "text", "value": "Discover", "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "advance to chapter 3 to re-exercise the swap",
      "payload": { "target": "colosseumUpdateNextChapter" } },
    { "cmd": "ui-wait-for", "label": "the chapter counter advanced to 03 / 05",
      "payload": { "object": "colosseumUpdateChapterCount", "prop": "text", "value": "03 / 05", "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the stage re-settled on chapter 3",
      "payload": { "object": "colosseumUpdateGallery", "prop": "automationVisualReady", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "evidence: chapter 3 settled after a second swap",
      "payload": { "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] }
  ]
}
