{
  "name": "vault-identify",
  "comment": "Vault Slice 17: the seeded one-folder shelf adopts one offline MAL match, keeps the file list stable through Un-identify and Hide/Restore, paints the synopsis seam, and opens the Tankoban identity door. Run with --seed tests/lanista-slice17-seed.",
  "steps": [
    { "cmd": "ping", "label": "the isolated session answers with the drive gate on",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash has left the screen",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the Vault via the folder door",
      "payload": { "target": "taskbarVaultDoor" } },
    { "cmd": "ui-wait-for", "label": "the seeded folder paints as a Vault shelf",
      "payload": { "object": "vaultPage", "prop": "vaultState", "value": "populated", "timeout_ms": 10000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the seeded tile action menu",
      "payload": { "target": "vaultTileMenu" } },
    { "cmd": "ui-query", "label": "the identity menu is visible and actionable",
      "payload": { "object": "vaultTileActionMenu", "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "visible", "op": "==", "value": "true" },
                  { "path": "enabled", "op": "==", "value": "true" },
                  { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "ui-click", "label": "open Identify… from the menu",
      "payload": { "target": "vaultTileIdentify" } },
    { "cmd": "ui-wait-for", "label": "the explicit identity dialog action is on screen",
      "payload": { "object": "vaultIdentifyConfirm", "prop": "visible", "value": true, "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "confirm the certain offline identity",
      "payload": { "target": "vaultIdentifyConfirm" } },
    { "cmd": "ui-wait-for", "label": "the tile wears its MAL provenance badge",
      "payload": { "object": "vaultTile_c:/users/suprabha/appdata/local/temp/colosseum-vault-s16-root/series", "prop": "identSource", "value": "MAL", "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the adopted title and badge are readable",
      "payload": { "object": "vaultTile_c:/users/suprabha/appdata/local/temp/colosseum-vault-s16-root/series", "props": ["identSource", "synopsis"] },
      "expect": [ { "path": "props.identSource", "op": "==", "value": "MAL" },
                  { "path": "props.synopsis", "op": "matches", "value": "^.+$" } ] },
    { "cmd": "ui-click", "label": "reopen the adopted tile menu",
      "payload": { "target": "vaultTileMenu" } },
    { "cmd": "ui-click", "label": "remove the identity decoration",
      "payload": { "target": "vaultTileUnidentify" } },
    { "cmd": "ui-wait-for", "label": "Un-identify restores filename truth",
      "payload": { "object": "vaultTile_c:/users/suprabha/appdata/local/temp/colosseum-vault-s16-root/series", "prop": "identSource", "value": "", "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the restored tile menu",
      "payload": { "target": "vaultTileMenu" } },
    { "cmd": "ui-click", "label": "hide the restored folder",
      "payload": { "target": "vaultTileHide" } },
    { "cmd": "ui-click", "label": "open the reversible Hidden surface",
      "payload": { "target": "worldTab_hidden" } },
    { "cmd": "qml-get", "label": "Hidden contains one folder",
      "payload": { "object": "vaultShelf_hidden", "props": ["rowCount"] },
      "expect": [ { "path": "props.rowCount", "op": "==", "value": 1 } ] },
    { "cmd": "ui-click", "label": "open the hidden tile menu",
      "payload": { "target": "vaultTileMenu" } },
    { "cmd": "ui-click", "label": "restore the hidden folder",
      "payload": { "target": "vaultTileRestore" } },
    { "cmd": "qml-get", "label": "Hidden is empty after restore",
      "payload": { "object": "vaultShelf_hidden", "props": ["rowCount"] },
      "expect": [ { "path": "props.rowCount", "op": "==", "value": 0 } ] },
    { "cmd": "ui-click", "label": "return to the populated Vault surface",
      "payload": { "target": "worldTab_all" } },
    { "cmd": "ui-click", "label": "reopen Identify for the world-door leg",
      "payload": { "target": "vaultTileMenu" } },
    { "cmd": "ui-click", "label": "choose Identify for the world-door leg",
      "payload": { "target": "vaultTileIdentify" } },
    { "cmd": "ui-click", "label": "confirm the world-door identity",
      "payload": { "target": "vaultIdentifyConfirm" } },
    { "cmd": "ui-wait-for", "label": "the adopted tile remains MAL identified",
      "payload": { "object": "vaultTile_c:/users/suprabha/appdata/local/temp/colosseum-vault-s16-root/series", "prop": "identSource", "value": "MAL", "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the identified folder",
      "payload": { "target": "vaultTile_c:/users/suprabha/appdata/local/temp/colosseum-vault-s16-root/series" } },
    { "cmd": "ui-wait-for", "label": "the identified folder preview opens",
      "payload": { "object": "vaultFolderView", "prop": "visible", "value": true, "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the preview exposes its synopsis seam",
      "payload": { "object": "vaultFolderView", "prop": "hasSynopsis", "value": true, "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the preview keeps synopsis provenance and file count",
      "payload": { "object": "vaultFolderView", "props": ["hasSynopsis", "synopsisSource", "fileCount"] },
      "expect": [ { "path": "props.hasSynopsis", "op": "==", "value": "true" },
                  { "path": "props.synopsisSource", "op": "==", "value": "MAL" },
                  { "path": "props.fileCount", "op": "==", "value": 1 } ] },
    { "cmd": "qml-get", "label": "the world door carries the adopted identity",
      "payload": { "object": "vaultFolderView", "props": ["identityId", "identityWorld"] },
      "expect": [ { "path": "props.identityId", "op": "==", "value": "mal:7" },
                  { "path": "props.identityWorld", "op": "==", "value": "Tankoban" } ] },
    { "cmd": "ui-click", "label": "take the identity door into Tankoban",
      "payload": { "target": "vaultFolderViewWorld" } },
    { "cmd": "qml-get", "label": "the Vault overlay closes after the identity handoff",
      "payload": { "object": "vaultState", "props": ["pageOpen"] },
      "expect": [ { "path": "props.pageOpen", "op": "==", "value": "false" } ] },
    { "cmd": "ui-wait-for", "label": "the Tankoban identity page is visible",
      "payload": { "object": "mangaSeriesPage", "prop": "visible", "value": true, "timeout_ms": 5000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] }
  ]
}
