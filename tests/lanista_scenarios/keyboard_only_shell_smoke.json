{
  "name": "keyboard-only-shell-smoke",
  "comment": "Arc 41 acceptance: zero ui-click steps. Fresh isolated session must dismiss onboarding, open/close Vault, and toggle fullscreen using keyboard only.",
  "steps": [
    { "cmd": "ping", "label": "isolated drive session answers",
      "expect": [
        { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
        { "path": "gates.drive", "op": "==", "value": "true" }
      ] },
    { "cmd": "ui-wait-for", "label": "boot splash leaves",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "fresh tag starts at onboarding",
      "payload": { "object": "accountHost", "props": ["visible"] },
      "expect": [ { "path": "props.visible", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "activate the focused continue-local action", "payload": { "key": "Enter" } },
    { "cmd": "ui-wait-for", "label": "onboarding dismisses without a click",
      "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },

    { "cmd": "ui-keypress", "label": "global keyboard route opens Vault", "payload": { "key": "Ctrl+Shift+V" } },
    { "cmd": "ui-wait-for", "label": "Vault opens from keyboard only",
      "payload": { "object": "vaultState", "prop": "pageOpen", "value": true, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Escape closes the topmost Vault surface", "payload": { "key": "Esc" } },
    { "cmd": "ui-wait-for", "label": "Vault closes from keyboard only",
      "payload": { "object": "vaultState", "prop": "pageOpen", "value": false, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "F11 enters windowed shell mode", "payload": { "key": "F11" } },
    { "cmd": "ui-wait-for", "label": "shell-mode flip settles before the state is read",
      "payload": { "object": "fullscreenTransition", "prop": "transitioning", "value": false, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "windowed state is observable",
      "expect": [ { "path": "windows.0.state", "op": "==", "value": "normal" } ] },
    { "cmd": "ui-keypress", "label": "F11 returns to fullscreen shell mode", "payload": { "key": "F11" } },
    { "cmd": "ui-wait-for", "label": "shell-mode flip settles before the state is read",
      "payload": { "object": "fullscreenTransition", "prop": "transitioning", "value": false, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "fullscreen state is observable",
      "expect": [ { "path": "windows.0.state", "op": "==", "value": "fullscreen" } ] },
    { "cmd": "get-state", "label": "final keyboard-only evidence frame",
      "payload": { "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] }
  ]
}
