{
  "name": "biblio-tab-probe",
  "comment": "Diagnostic (Slice 6, run 3 follow-up): resolve each Biblio tab pill by name without clicking, to isolate why biblioTab_explore answered NO_SUCH_ITEM in biblio_catalog_source_smoke run 3 while the bar itself was visible. Disposable session, read-only after the mode click.",
  "steps": [
    { "cmd": "ping", "label": "session app answers on its own pipe with drive armed",
      "expect": [ { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "one visible window",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash has left the screen",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 } },
    { "cmd": "ui-click", "label": "open the Biblio mode",
      "payload": { "target": "modePill_Biblio" } },
    { "cmd": "ui-wait-for", "label": "Biblio's tab bar appears",
      "payload": { "object": "biblioTabBar", "prop": "visible", "value": true, "timeout_ms": 8000 } },
    { "cmd": "ui-query", "label": "probe: discover pill resolves",
      "payload": { "object": "biblioTab_discover" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "probe: explore pill resolves",
      "payload": { "object": "biblioTab_explore" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "probe: library pill resolves",
      "payload": { "object": "biblioTab_library" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "probe: explore page name + rollups are addressable pre-click",
      "payload": { "object": "biblioExplorePage", "props": ["railKeysCsv", "mostReadRailCount"] },
      "expect": [ { "path": "props.railKeysCsv", "op": "matches", "value": "classics$" } ] }
  ]
}
