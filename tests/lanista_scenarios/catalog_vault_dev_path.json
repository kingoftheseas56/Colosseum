{
  "name": "catalog-vault-dev-path",
  "comment": "Data-vault adoption Slice 4 (2026-08-22), Session 1. Proves the dev machine (all four data/*.db files present) boots byte-identically to before the vault client landed: zero network fetch, all four catalogs resolve via the dev-relative ladder, readyCount reaches 4 with fetching never true. Onboarding step order copied from the Slice 3 ledger entry (docs/colosseum-lanista-verification.md, 'accountHost' objectName correction); Tankoban masthead/shelf steps copied from the committed tankoban_catalogue_smoke.json (One Piece, malId 13). Isolated tagged session, unique pipe, never the daily pipe.",
  "steps": [
    { "cmd": "ping", "label": "the session answers, drive gated on",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "one visible window, isolated data root",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" },
                  { "path": "appDataRoot", "op": "contains", "value": "Colosseum-dltest" } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash has left the screen",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "a fresh tag gates world content behind account onboarding",
      "payload": { "object": "accountHost", "props": ["visible"] },
      "expect": [ { "path": "props.visible", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "continue without an account",
      "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "onboarding dismisses (mode leaves signedOut)",
      "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },

    { "cmd": "qml-get", "label": "dev-path regression: all four catalogs already local, zero network fetch on this machine",
      "payload": { "object": "catalogVaultState", "props": ["fetching", "tag", "readyCount"] },
      "expect": [ { "path": "props.readyCount", "op": "==", "value": "4" },
                  { "path": "props.fetching", "op": "==", "value": "false" } ] },

    { "cmd": "ui-click", "label": "enter Tankoban", "payload": { "target": "modePill_Tankoban" } },
    { "cmd": "ui-click", "label": "the Manga tab",
      "payload": { "target": "tankobanTab_manga" } },
    { "cmd": "ui-click", "label": "One Piece - index 0 of the static 'Top in Tankoban - Manga' rail",
      "payload": { "target": "tankobanTopMangaTile_0" } },

    { "cmd": "ui-wait-for", "label": "One Piece's catalogue-fed masthead is ready",
      "payload": { "object": "tankobanSeriesMasthead", "prop": "ready", "value": true, "timeout_ms": 20000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "masthead identity: One Piece, malId 13, has a shelf",
      "payload": { "object": "tankobanSeriesMasthead",
                   "props": ["ready", "displayTitle", "resolvedMalId", "hasShelf"] },
      "expect": [ { "path": "props.ready", "op": "==", "value": "true" },
                  { "path": "props.displayTitle", "op": "==", "value": "One Piece" },
                  { "path": "props.resolvedMalId", "op": "==", "value": "13" },
                  { "path": "props.hasShelf", "op": "==", "value": "true" } ] },

    { "cmd": "ui-wait-for", "label": "the baked volume shelf renders",
      "payload": { "object": "tankobanShelfState", "prop": "rowCount", "value": 113, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },

    { "cmd": "ui-query", "label": "whole-window exhibit: ordinary Tankoban home, dev machine unchanged by the vault client",
      "payload": { "object": "tankobanSeriesMasthead", "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] }
  ]
}
