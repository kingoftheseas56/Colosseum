{
  "name": "vault-open-recent",
  "comment": "Vault execution Slice 9: a seeded recent list (VaultRecent is file-backed at <appdata>/vault/open-recent.json, so seedable) renders in the Open Recent panel, and clicking a row reopens the file — the vault comic reader mounts with the fixture's pages. NOTE: reading progress is registry-backed QSettings, NOT seedable via --seed (Lanista ledger), so resume-at-page and completed-video-restart are human-witnessed, not driven here. This scenario proves the panel + one-click-reopen loop the bridge CAN reach. Isolated tagged session.",
  "steps": [
    { "cmd": "ping", "label": "the session answers, drive gated on",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "one visible window, isolated data root",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" },
                  { "path": "appDataRoot", "op": "contains", "value": "Colosseum-dltest" } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash has left the screen",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the launch-state surface is idle at boot",
      "payload": { "object": "localLaunchState", "props": ["openCount"] },
      "expect": [ { "path": "props.openCount", "op": "==", "value": "0" } ] },
    { "cmd": "ui-click", "label": "open the taskbar dock",
      "payload": { "target": "colosseumTaskbarHomeButton" } },
    { "cmd": "ui-query", "label": "settle the dock open (a real round-trip, no sleep)",
      "payload": { "object": "colosseumTaskbarHomeButton" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the Recent panel via the disclosure caret",
      "payload": { "target": "openRecentDisclosure" } },
    { "cmd": "ui-wait-for", "label": "the seeded recent list shows two rows",
      "payload": { "object": "openRecentPanel", "prop": "rowCount", "value": 2, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "the recent panel is on screen",
      "payload": { "object": "openRecentPanel", "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "visible", "op": "==", "value": "true" },
                  { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "ui-click", "label": "reopen the first recent item (the fixture comic)",
      "payload": { "target": "openRecentRow_0" } },
    { "cmd": "ui-wait-for", "label": "the vault comic reader mounted the fixture's pages",
      "payload": { "object": "comicReaderShell", "prop": "pageCount", "value": 3, "timeout_ms": 12000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the reader carries the vault content identity",
      "payload": { "object": "comicReaderShell", "props": ["seriesId", "pageCount", "currentPage"] },
      "expect": [ { "path": "props.seriesId", "op": "matches", "value": "^vault:" },
                  { "path": "props.pageCount", "op": "==", "value": "3" } ] },
    { "cmd": "qml-get", "label": "the reopen counted exactly once + grab the reopened reader",
      "payload": { "object": "localLaunchState", "props": ["openCount", "lastRouteKind"],
                   "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "props.openCount", "op": "==", "value": "1" },
                  { "path": "props.lastRouteKind", "op": "==", "value": "comic" },
                  { "path": "grabPath", "op": "exists" } ] }
  ]
}
