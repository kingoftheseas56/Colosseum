{
  "name": "update-available",
  "comment": "Update ascends to the topbar: a disposable session seeded with a verified release exposes the home topbar Update glyph + badge, opens the full-bleed chronicle (no taskbar), and shows the on-page status strip + primary action.",
  "steps": [
    { "cmd": "ping", "label": "the update test session answers",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "one visible window",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" },
                  { "path": "windows.0.width", "op": "==", "value": 1280 },
                  { "path": "windows.0.height", "op": "==", "value": 720 },
                  { "path": "appDataRoot", "op": "contains", "value": "updater-available" },
                  { "path": "cacheRoot", "op": "contains", "value": "updater-available" } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash has left the screen",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the home topbar advertises the verified release",
      "payload": { "object": "colosseumTopbarUpdateButton", "prop": "visible", "value": true, "timeout_ms": 30000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "the home topbar Update glyph is visible and actionable",
      "payload": { "object": "colosseumTopbarUpdateButton" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" },
                  { "path": "enabled", "op": "==", "value": "true" },
                  { "path": "clippedByWindow", "op": "==", "value": "false" } ] },
    { "cmd": "ui-query", "label": "the available-release badge is visible on the topbar glyph",
      "payload": { "object": "colosseumTopbarUpdateBadge" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" },
                  { "path": "clippedByWindow", "op": "==", "value": "false" } ] },
    { "cmd": "ui-click", "label": "open the update chronicle from the topbar glyph",
      "payload": { "target": "colosseumTopbarUpdateButton" } },
    { "cmd": "ui-wait-for", "label": "the update page is on screen",
      "payload": { "object": "colosseumUpdatePage", "prop": "visible", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the page reports the available state",
      "payload": { "object": "colosseumUpdatePage", "prop": "automationState", "value": "Available", "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the taskbar has yielded to the full-bleed chronicle",
      "payload": { "object": "colosseumUpdatePage", "prop": "visible", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the page exposes the available release contract",
      "payload": { "object": "colosseumUpdatePage", "props": ["automationState", "automationVersion", "primaryLabel"] },
      "expect": [ { "path": "props.automationState", "op": "==", "value": "Available" },
                  { "path": "props.automationVersion", "op": "exists" },
                  { "path": "props.primaryLabel", "op": "==", "value": "Download update" } ] },
    { "cmd": "ui-query", "label": "the on-page status strip carries the available-release copy",
      "payload": { "object": "colosseumUpdateStatusText" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the living gallery exposes its signed single-chapter fallback",
      "payload": { "object": "colosseumUpdateGallery", "props": ["chapterCount", "currentIndex", "automationLogicalWidth", "automationLogicalHeight", "automationDevicePixelRatio"] },
      "expect": [ { "path": "props.chapterCount", "op": "==", "value": 1 },
                  { "path": "props.currentIndex", "op": "==", "value": 0 },
                  { "path": "props.automationLogicalWidth", "op": "==", "value": 1280 },
                  { "path": "props.automationLogicalHeight", "op": "==", "value": 720 },
                  { "path": "props.automationDevicePixelRatio", "op": "exists" } ] },
    { "cmd": "qml-get", "label": "the available release has readable chapter copy",
      "payload": { "object": "colosseumUpdateChapterTitle", "props": ["text"] },
      "expect": [ { "path": "props.text", "op": "matches", "value": "^.+$" } ] },
    { "cmd": "ui-wait-for", "label": "the rendered monochrome stage has settled",
      "payload": { "object": "colosseumUpdateGallery", "prop": "automationStageSettled", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the living gallery has presented a visual frame",
      "payload": { "object": "colosseumUpdateGallery", "prop": "automationVisualReady", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "the single-chapter gallery omits redundant Next",
      "payload": { "object": "colosseumUpdateNextChapter" },
      "expect": [ { "path": "visible", "op": "==", "value": "false" } ] },
    { "cmd": "ui-query", "label": "the page-level available-release action is visible",
      "payload": { "object": "colosseumUpdatePrimaryAction" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" },
                  { "path": "enabled", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "evidence: the whole window after opening the chronicle",
      "payload": { "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] }
  ]
}
