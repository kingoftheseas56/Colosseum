{
  "name": "vault-browse-churn",
  "comment": "Vault Browse face execution plan, Slice 6 (living tile states) — the regression the reviewer named as the direct test of this slice's own re-projection fix: a card whose state genuinely changed (Akira resolving->identified via the boot-time auto-identify pass against the real catalogue; Masterpiece resolving->uncertain) must still read correctly after the grid is scrolled far away and back, not a stale/reset face. The fixture root (tests/fixtures/vault/browse-states-smoke) carries 303 single-file comic groups (Akira + Masterpiece + 301 nonsense-titled fillers, none of which match the production catalogue) specifically to force the GridView through its full virtualization range (contentHeight 15300px against a 290px viewport and a 900px cacheBuffer) when scrolled to its true maximum extent. HONEST LIMIT recorded here: dump-ui still reported the Akira card's Item object present in the scene tree even at the fully-settled maximum scroll position (contentY==contentHeight-height, verified via Flickable.moving==false, not a mid-flick read) — GridView's cache eviction was not observably forced within this fixture's scale, so this scenario proves the OUTCOME (state/title survive the round-trip correctly) but does not independently confirm delegate destruction/recreation occurred. VaultPage.qml's grid does not set reuseItems (grep-verified), and the delegate's `row: modelData` binding is a plain, live QML property binding that always reflects current model data regardless of whether the Item persists or is recreated — which is why staleness is structurally unlikely either way — but that is architectural reasoning, not something this replay independently proves. Run with --seed tests/fixtures/vault/browse-states-smoke-seed.",
  "steps": [
    { "cmd": "ping", "label": "the session answers, drive gated on",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "one visible window, isolated data root",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" },
                  { "path": "appDataRoot", "op": "contains", "value": "Colosseum-dltest" } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash has left the screen",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the Vault via the folder door",
      "payload": { "target": "taskbarVaultDoor" } },
    { "cmd": "ui-wait-for", "label": "the seeded fixture root paints the populated Vault",
      "payload": { "object": "vaultPage", "prop": "vaultState", "value": "populated", "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the grid settles at 303 (Akira + Masterpiece + 301 fillers)",
      "payload": { "object": "vaultBrowseGrid", "prop": "count", "value": 303, "timeout_ms": 20000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "CHURN: Akira settles identified (the boot-time auto-identify pass)",
      "payload": { "object": "vaultBrowseCard_C:/users/testuser/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-states-smoke/Akira",
                   "prop": "state", "value": "identified", "timeout_ms": 20000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "CHURN: Masterpiece settles uncertain (the same pass, correctly declining ambiguity)",
      "payload": { "object": "vaultBrowseCard_C:/users/testuser/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-states-smoke/Masterpiece",
                   "prop": "state", "value": "uncertain", "timeout_ms": 20000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "Akira and Masterpiece read correctly BEFORE the scroll churn",
      "payload": { "object": "vaultBrowseCard_C:/users/testuser/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-states-smoke/Akira",
                   "props": ["state", "displayTitle"] },
      "expect": [ { "path": "props.state", "op": "==", "value": "identified" },
                  { "path": "props.displayTitle", "op": "==", "value": "Akira" } ] },
    { "cmd": "get-state", "label": "visual evidence: the grid before the scroll round-trip",
      "payload": { "grab": { "target": "vaultBrowseGrid", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "ui-scroll", "label": "scroll down burst 1", "payload": { "target": "vaultBrowseGrid", "dy": -6000 } },
    { "cmd": "ui-wait-for", "label": "flick 1 settles",
      "payload": { "object": "vaultBrowseGrid", "prop": "moving", "value": false, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "scroll down burst 2", "payload": { "target": "vaultBrowseGrid", "dy": -6000 } },
    { "cmd": "ui-wait-for", "label": "flick 2 settles",
      "payload": { "object": "vaultBrowseGrid", "prop": "moving", "value": false, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "scroll down burst 3", "payload": { "target": "vaultBrowseGrid", "dy": -6000 } },
    { "cmd": "ui-wait-for", "label": "flick 3 settles",
      "payload": { "object": "vaultBrowseGrid", "prop": "moving", "value": false, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "scroll down burst 4", "payload": { "target": "vaultBrowseGrid", "dy": -6000 } },
    { "cmd": "ui-wait-for", "label": "flick 4 settles",
      "payload": { "object": "vaultBrowseGrid", "prop": "moving", "value": false, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "scroll down burst 5", "payload": { "target": "vaultBrowseGrid", "dy": -6000 } },
    { "cmd": "ui-wait-for", "label": "flick 5 settles",
      "payload": { "object": "vaultBrowseGrid", "prop": "moving", "value": false, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "scroll down burst 6", "payload": { "target": "vaultBrowseGrid", "dy": -6000 } },
    { "cmd": "ui-wait-for", "label": "flick 6 settles at the true maximum (contentHeight - height)",
      "payload": { "object": "vaultBrowseGrid", "prop": "moving", "value": false, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "confirm we are genuinely at the bottom, fully settled",
      "payload": { "object": "vaultBrowseGrid", "props": ["contentY", "contentHeight", "moving"] },
      "expect": [ { "path": "props.contentY", "op": "==", "value": 15010 },
                  { "path": "props.contentHeight", "op": "==", "value": 15300 },
                  { "path": "props.moving", "op": "==", "value": "false" } ] },
    { "cmd": "get-state", "label": "visual evidence: the grid at maximum scroll",
      "payload": { "grab": { "target": "vaultBrowseGrid", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "ui-scroll", "label": "scroll up burst 1", "payload": { "target": "vaultBrowseGrid", "dy": 6000 } },
    { "cmd": "ui-wait-for", "label": "flick up 1 settles",
      "payload": { "object": "vaultBrowseGrid", "prop": "moving", "value": false, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "scroll up burst 2", "payload": { "target": "vaultBrowseGrid", "dy": 6000 } },
    { "cmd": "ui-wait-for", "label": "flick up 2 settles",
      "payload": { "object": "vaultBrowseGrid", "prop": "moving", "value": false, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "scroll up burst 3", "payload": { "target": "vaultBrowseGrid", "dy": 6000 } },
    { "cmd": "ui-wait-for", "label": "flick up 3 settles",
      "payload": { "object": "vaultBrowseGrid", "prop": "moving", "value": false, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "scroll up burst 4", "payload": { "target": "vaultBrowseGrid", "dy": 6000 } },
    { "cmd": "ui-wait-for", "label": "flick up 4 settles",
      "payload": { "object": "vaultBrowseGrid", "prop": "moving", "value": false, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "scroll up burst 5", "payload": { "target": "vaultBrowseGrid", "dy": 6000 } },
    { "cmd": "ui-wait-for", "label": "flick up 5 settles",
      "payload": { "object": "vaultBrowseGrid", "prop": "moving", "value": false, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "scroll up burst 6", "payload": { "target": "vaultBrowseGrid", "dy": 6000 } },
    { "cmd": "ui-wait-for", "label": "flick up 6 settles back at the top",
      "payload": { "object": "vaultBrowseGrid", "prop": "contentY", "value": 0, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "THE CONTRACT: Akira and Masterpiece read correctly AFTER the scroll round-trip — not a stale/reset face",
      "payload": { "object": "vaultBrowseCard_C:/users/testuser/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-states-smoke/Akira",
                   "props": ["state", "displayTitle"] },
      "expect": [ { "path": "props.state", "op": "==", "value": "identified" },
                  { "path": "props.displayTitle", "op": "==", "value": "Akira" } ] },
    { "cmd": "qml-get", "label": "Masterpiece also reads correctly after the round-trip",
      "payload": { "object": "vaultBrowseCard_C:/users/testuser/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-states-smoke/Masterpiece",
                   "props": ["state", "displayTitle"] },
      "expect": [ { "path": "props.state", "op": "==", "value": "uncertain" },
                  { "path": "props.displayTitle", "op": "==", "value": "Masterpiece" } ] },
    { "cmd": "get-state", "label": "visual evidence: the grid back at the top after the round-trip",
      "payload": { "grab": { "target": "vaultBrowseGrid", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] }
  ]
}
