    {
      "cmd": "qml-get",
      "label": "Read final source-provided Spin counts; no local invented rows",
      "payload": {
        "object": "vinylSpin",
        "props": [
          "view",
          "columns",
          "pageSize",
          "pageCount",
          "songs",
          "albums",
          "artists"
        ]
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.view",
          "op": "==",
          "value": "songs"
        }
      ]
    },
    {
      "cmd": "ui-scroll",
      "label": "Return the one outer page to its top for Home geometry and capture",
      "payload": {
        "target": "vinylWorldScroll",
        "dy": 12000,
        "xFraction": 0.005,
        "yFraction": 0.5
      },
      "expect": [
        {
          "path": "scrolled",
          "op": "==",
          "value": "vinylWorldScroll"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "Outer page has reached its actual top",
      "payload": {
        "object": "vinylWorldScroll",
        "prop": "contentY",
        "value": 0,
        "timeout_ms": 60000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "Capture populated Home from the real top of the page",
      "payload": {
        "object": "vinylHome",
        "props": [
          "rowKeys"
        ],
        "grab": {
          "target": "window",
          "timeoutMs": 4000
        }
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.rowKeys",
          "op": "==",
          "value": "mixes-radio,new-from-your-artists,albums-for-you,deep-cuts,artists-like-yours"
        },
        {
          "path": "grabPath",
          "op": "exists",
          "value": null
        }
      ]
    },
    {
      "cmd": "ui-scroll",
      "label": "Scroll the single outer page until the below-Spin tabs dock",
      "payload": {
        "target": "vinylWorldScroll",
        "dy": -12000,
        "xFraction": 0.005,
        "yFraction": 0.5
      },
      "expect": [
        {
          "path": "scrolled",
          "op": "==",
          "value": "vinylWorldScroll"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "The actual flow tabs have docked",
      "payload": {
        "object": "vinylWorld",
        "prop": "tabsDocked",
        "value": true,
        "timeout_ms": 60000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
