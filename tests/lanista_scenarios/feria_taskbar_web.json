{
  "name": "feria-taskbar-web",
  "comment": "Feria opens from the Colosseum taskbar as a bundled web page while the three world selector remains independent.",
  "steps": [
    { "cmd": "ping", "label": "isolated app answers", "expect": [ { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "boot splash leaves", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "local entry is available", "payload": { "object": "accountWelcomeContinueLocal", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "continue locally", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "shell is ready", "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the taskbar", "payload": { "target": "colosseumTaskbarHomeButton" } },
    { "cmd": "ui-query", "label": "Feria taskbar icon is actionable", "payload": { "object": "taskbarFeria" }, "expect": [ { "path": "visible", "op": "==", "value": "true" }, { "path": "enabled", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open Feria", "payload": { "target": "taskbarFeria" } },
    { "cmd": "ui-wait-for", "label": "Feria page opens", "payload": { "object": "feriaLayer", "prop": "active", "value": true, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "bundled web page loads", "payload": { "object": "feriaAppPage", "prop": "loadStatus", "value": "ready", "timeout_ms": 15000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "capture the rendered Feria web page", "payload": { "object": "feriaAppPage", "grab": { "target": "window", "timeoutMs": 4000 } }, "expect": [ { "path": "visible", "op": "==", "value": "true" }, { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "ui-keypress", "label": "Escape returns to Colosseum", "payload": { "key": "Escape" } },
    { "cmd": "ui-wait-for", "label": "Feria closes", "payload": { "object": "feriaLayer", "prop": "active", "value": false, "timeout_ms": 5000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] }
  ]
}
