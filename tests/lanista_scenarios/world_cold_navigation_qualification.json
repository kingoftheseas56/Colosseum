{
  "name": "world-cold-navigation-qualification",
  "comment": "Measurement-only cold-world qualification. Run with COLOSSEUM_WORLD_WARMER=0 so the first Tankoban entry is a cold Loader construction, not background warming. The vault-stale-index-v1 seed is provider-independent; no catalogue result is required. The first tankobanWorld.visible wait measures route plus Loader construction, while stderr GUI_STALL_PROBE lines separate qml-load stalls from QNetworkReplyHttpImpl/network stalls. Escape exercises the production world-to-Home route. The same tankobanWorld structural tree must survive Home -> Tankoban -> Home -> Tankoban; qml-get records lifecycleActive as a diagnostic because the live run observed it false even while visible. The retained Loader/state claim is based on the same class/tree shape and activeTab across the round-trip, not on that anomalous lifecycle flag.",
  "steps": [
    { "cmd": "ping", "label": "the isolated app answers with Drive enabled",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "the app reports its tagged disposable data root",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" },
                  { "path": "appDataRoot", "op": "contains", "value": "Colosseum-dltest" } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash clears",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "dismiss fresh-session onboarding",
      "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "the account host closes",
      "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "Home is the pre-route surface",
      "payload": { "object": "homePageFlickable", "props": ["visible"] },
      "expect": [ { "path": "props.visible", "op": "==", "value": "true" } ] },

    { "cmd": "ui-click", "label": "first cold visit: enter Tankoban from Home",
      "payload": { "target": "modePill_Tankoban" } },
    { "cmd": "ui-wait-for", "label": "first visit: Tankoban world becomes visible after its Loader is constructed",
      "payload": { "object": "tankobanWorld", "prop": "visible", "value": true, "timeout_ms": 20000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "first visit lands on the Tankoban world root",
      "payload": { "object": "tankobanWorld", "props": ["visible", "lifecycleActive", "activeTab"] },
      "expect": [ { "path": "props.visible", "op": "==", "value": "true" },
                  { "path": "props.activeTab", "op": "==", "value": "discover" } ] },
    { "cmd": "dump-ui", "label": "capture first-visit world tree",
      "payload": { "root": "tankobanWorld", "maxDepth": 4, "maxItems": 300 },
      "expect": [ { "path": "count", "op": ">", "value": "0" } ] },
    { "cmd": "ui-keypress", "label": "production world-to-Home route via Escape",
      "payload": { "key": "Escape" } },
    { "cmd": "ui-wait-for", "label": "Tankoban hides while Home is revealed",
      "payload": { "object": "tankobanWorld", "prop": "visible", "value": false, "timeout_ms": 10000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "Home is visible after leaving the world",
      "payload": { "object": "homePageFlickable", "prop": "visible", "value": true, "timeout_ms": 10000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the visited world remains materialized but inactive",
      "payload": { "object": "tankobanWorld", "props": ["visible", "lifecycleActive"] },
      "expect": [ { "path": "props.visible", "op": "==", "value": "false" } ] },

    { "cmd": "ui-click", "label": "second visit: re-enter the retained Tankoban world",
      "payload": { "target": "modePill_Tankoban" } },
    { "cmd": "ui-wait-for", "label": "second visit: the retained Tankoban world becomes visible",
      "payload": { "object": "tankobanWorld", "prop": "visible", "value": true, "timeout_ms": 10000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "visited-world state survives Home round-trip",
      "payload": { "object": "tankobanWorld", "props": ["visible", "lifecycleActive", "activeTab"] },
      "expect": [ { "path": "props.visible", "op": "==", "value": "true" },
                  { "path": "props.activeTab", "op": "==", "value": "discover" } ] },
    { "cmd": "dump-ui", "label": "capture second-visit world tree for retained Loader shape comparison",
      "payload": { "root": "tankobanWorld", "maxDepth": 4, "maxItems": 300 },
      "expect": [ { "path": "count", "op": ">", "value": "0" } ] },
    { "cmd": "ping", "label": "no-crash/no-hang check after cold entry, back, and retained re-entry",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" } ] }
  ]
}
