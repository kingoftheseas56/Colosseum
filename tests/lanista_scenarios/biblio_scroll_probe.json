{
  "name": "biblio-scroll-probe",
  "description": "Diagnostic: does the Explore mainFlick contentY move and hold across ui-scroll steps?",
  "app": { "exe": "native/build-msvc/colosseum.exe" },
  "steps": [
    { "cmd": "ping", "label": "runner ping",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" } ] },
    { "cmd": "ui-wait-for", "label": "one visible window",
      "payload": { "object": "__window__", "prop": "visible", "value": true, "timeout_ms": 30000 } },
    { "cmd": "ui-wait-for", "label": "boot splash gone",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 30000 } },
    { "cmd": "ui-click", "label": "open Biblio mode", "payload": { "target": "modePill_Biblio" } },
    { "cmd": "ui-wait-for", "label": "biblio tab bar visible",
      "payload": { "object": "biblioTabBar", "prop": "visible", "value": true, "timeout_ms": 30000 } },
    { "cmd": "ui-wait-for", "label": "the Explore pill resolves",
      "payload": { "object": "biblioTab_explore", "prop": "visible", "value": true, "timeout_ms": 20000 } },
    { "cmd": "ui-click", "label": "open Explore", "payload": { "target": "biblioTab_explore" } },
    { "cmd": "ui-wait-for", "label": "explore page visible",
      "payload": { "object": "biblioExplorePage", "prop": "visible", "value": true, "timeout_ms": 20000 } },
    { "cmd": "ui-wait-for", "label": "houses loaded",
      "payload": { "object": "biblioExplorePage", "prop": "housesLoading", "value": false, "timeout_ms": 30000 } },
    { "cmd": "qml-get", "label": "contentY at rest",
      "payload": { "object": "biblioExploreFlick", "props": [ "contentY", "contentHeight", "height" ] } },
    { "cmd": "ui-scroll", "label": "scroll once",
      "payload": { "target": "biblioExploreFlick", "dy": -2400 } },
    { "cmd": "qml-get", "label": "contentY right after scroll",
      "payload": { "object": "biblioExploreFlick", "props": [ "contentY", "contentHeight" ] } },
    { "cmd": "sleep", "label": "let it settle", "payload": { "ms": 1500 } },
    { "cmd": "qml-get", "label": "contentY after settle",
      "payload": { "object": "biblioExploreFlick", "props": [ "contentY", "contentHeight" ] } },
    { "cmd": "ui-scroll", "label": "scroll again",
      "payload": { "target": "biblioExploreFlick", "dy": -2400 } },
    { "cmd": "qml-get", "label": "contentY after second scroll",
      "payload": { "object": "biblioExploreFlick", "props": [ "contentY", "contentHeight" ] } },
    { "cmd": "sleep", "label": "settle", "payload": { "ms": 1500 } },
    { "cmd": "qml-get", "label": "contentY final",
      "payload": { "object": "biblioExploreFlick", "props": [ "contentY", "contentHeight" ] } }
  ]
}
