{
  "name": "arc49-rr-slice2-visual-capture",
  "comment": "Disposable visual-evidence capture of the Arc 49 Slice 2 Ratings & Reviews page (hero, ten-star private rating, inline editor, provider badges, community area). Not a registered capability.",
  "steps": [
    { "cmd": "ping", "expect": [{ "path": "gates.drive", "op": "==", "value": "true" }] },
    { "cmd": "ui-wait-for", "label": "startup completes", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "label": "fresh tagged profile offers local continuation", "payload": { "object": "accountWelcomeContinueLocal", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "label": "activate tagged local profile", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-click", "label": "open Theatre", "payload": { "target": "modePill_Theatre" } },
    { "cmd": "ui-wait-for", "label": "Theatre world active", "payload": { "object": "theatreWorld", "prop": "lifecycleActive", "value": true, "timeout_ms": 15000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "label": "open Theatre search", "payload": { "target": "topBarSearch" } },
    { "cmd": "ui-wait-for", "label": "search surface opens", "payload": { "object": "searchSurfaceInput", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-text-input", "label": "search Frieren", "payload": { "target": "searchSurfaceInput", "text": "Frieren" } },
    { "cmd": "ui-wait-for", "label": "Frieren result resolves", "payload": { "object": "searchResult_tt22248376", "prop": "visible", "value": true, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "label": "open Frieren detail", "payload": { "target": "searchResult_tt22248376" } },
    { "cmd": "ui-wait-for", "label": "detail visible", "payload": { "object": "theatreSeriesPage", "prop": "visible", "value": true, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-wait-for", "label": "entry action visible", "payload": { "object": "theatreRatingsReviewsAction", "prop": "visible", "value": true, "timeout_ms": 30000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "capture", "label": "start clip", "capture": { "action": "start", "name": "arc49-rr-slice2-page" } },
    { "cmd": "ui-click", "label": "open Ratings and Reviews", "payload": { "target": "theatreRatingsReviewsAction" } },
    { "cmd": "ui-wait-for", "label": "page opens with provider badges", "payload": { "object": "ratingsReviewsProviderBadges", "prop": "visible", "value": true, "timeout_ms": 15000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "presentation_hold_ms", "label": "hold hero and cards", "presentation_hold_ms": 2600, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-click", "label": "select 8 stars", "payload": { "target": "rrStar_8" } },
    { "cmd": "ui-wait-for", "label": "save control appears", "payload": { "object": "ratingsReviewsSaveRating", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "ui-click", "label": "Save privately", "payload": { "target": "ratingsReviewsSaveRating" } },
    { "cmd": "ui-wait-for", "label": "saved badge appears", "payload": { "object": "ratingsReviewsSavedBadge", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "presentation_hold_ms", "label": "hold saved state", "presentation_hold_ms": 2400, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-click", "label": "open editor", "payload": { "target": "ratingsReviewsOpenEditor" } },
    { "cmd": "ui-wait-for", "label": "editor expands", "payload": { "object": "ratingsReviewsEditor", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "presentation_hold_ms", "label": "hold editor", "presentation_hold_ms": 2600, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "ui-text-input", "label": "write review", "payload": { "target": "ratingsReviewsEditorText", "text": "A quiet journey worth keeping." } },
    { "cmd": "ui-click", "label": "Save privately", "payload": { "target": "ratingsReviewsSavePrivate" } },
    { "cmd": "ui-wait-for", "label": "editor collapses after save", "payload": { "object": "ratingsReviewsEditor", "prop": "visible", "value": false, "timeout_ms": 10000 }, "expect": [{ "path": "matched", "op": "==", "value": true }] },
    { "cmd": "presentation_hold_ms", "label": "hold collapsed saved state", "presentation_hold_ms": 2200, "expect": [{ "path": "type", "op": "==", "value": "reply" }] },
    { "cmd": "capture", "label": "stop clip", "capture": { "action": "stop" } }
  ]
}
