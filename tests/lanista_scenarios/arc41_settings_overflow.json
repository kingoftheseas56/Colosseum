{
  "name": "arc41-settings-overflow",
  "comment": "Arc41 family4 acceptance derived from the existing keyboard_universe_utilities_completion Settings route. The isolated run uses QT_SCALE_FACTOR=1.5 so the real Settings content overflows the smaller logical viewport without filler UI. At this scale the onboarding Continue action is clipped, so the disposable per-tag local-only seed marks onboarding complete before launch; the scenario records that the onboarding host is absent, then records the real Settings viewport and focused control, uses ordinary Down input to continue into the overflow, and requires positive contentY plus fully visible/unclipped focus geometry.",
  "steps": [
    { "cmd": "ping", "label": "isolated session answers with drive enabled", "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" }, { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "fresh tagged window is visible", "expect": [ { "path": "windows.0.visible", "op": "==", "value": true }, { "path": "appDataRoot", "op": "contains", "value": "Colosseum-dltest" } ] },
    { "cmd": "ui-wait-for", "label": "boot splash leaves", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "qml-get", "label": "the disposable local-only seed bypasses clipped onboarding", "payload": { "object": "accountHost", "props": [ "visible" ] }, "expect": [ { "path": "props.visible", "op": "==", "value": false } ] },
    { "cmd": "ui-keypress", "label": "open Settings through the production shortcut", "payload": { "key": "Ctrl+Shift+S" } },
    { "cmd": "ui-wait-for", "label": "Settings layer opens", "payload": { "object": "settingsLayer", "prop": "active", "value": true, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "ui-wait-for", "label": "Settings page owns focus", "payload": { "object": "settingsPageScroll", "prop": "activeFocus", "value": true, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "qml-get", "label": "record the real overflowing Settings viewport before Down", "payload": { "object": "settingsPageScroll", "props": [ "activeFocus", "contentY", "contentHeight", "height", "automationHasVerticalOverflow", "visible" ] }, "expect": [ { "path": "props.activeFocus", "op": "==", "value": true }, { "path": "props.visible", "op": "==", "value": true }, { "path": "props.automationHasVerticalOverflow", "op": "==", "value": true } ] },
    { "cmd": "ui-query", "label": "the real Settings toggle is visible and unclipped before navigation", "payload": { "object": "settingsExplicitToggle" }, "expect": [ { "path": "visible", "op": "==", "value": true }, { "path": "clippedByWindow", "op": "==", "value": false } ] },
    { "cmd": "ui-keypress", "label": "ordinary Down moves the Settings viewport", "payload": { "key": "Down" } },
    { "cmd": "qml-get", "label": "the first Down settles the real Settings toggle focus", "payload": { "object": "settingsExplicitToggle", "props": [ "activeFocus", "visible", "width", "height" ] }, "expect": [ { "path": "props.activeFocus", "op": "==", "value": true }, { "path": "props.visible", "op": "==", "value": true }, { "path": "props.width", "op": ">", "value": 0 }, { "path": "props.height", "op": ">", "value": 0 } ] },
    { "cmd": "ui-keypress", "label": "ordinary Down continues below the focused Settings control", "payload": { "key": "Down" } },
    { "cmd": "qml-get", "label": "the Settings viewport advances in the requested direction", "payload": { "object": "settingsPageScroll", "props": [ "activeFocus", "contentY", "contentHeight", "height", "visible" ] }, "expect": [ { "path": "props.contentY", "op": ">", "value": 0 }, { "path": "props.visible", "op": "==", "value": true } ] },
    { "cmd": "qml-get", "label": "the real Settings toggle retains keyboard focus after scroll", "payload": { "object": "settingsExplicitToggle", "props": [ "activeFocus", "visible", "width", "height" ] }, "expect": [ { "path": "props.activeFocus", "op": "==", "value": true }, { "path": "props.visible", "op": "==", "value": true }, { "path": "props.width", "op": ">", "value": 0 }, { "path": "props.height", "op": ">", "value": 0 } ] },
    { "cmd": "ui-query", "label": "the Settings focus surface remains visible and unclipped after Down", "payload": { "object": "settingsExplicitToggle" }, "expect": [ { "path": "visible", "op": "==", "value": true }, { "path": "clippedByWindow", "op": "==", "value": false } ] },
    { "cmd": "ui-keypress", "label": "Escape closes Settings", "payload": { "key": "Escape" } },
    { "cmd": "ui-wait-for", "label": "Settings closes", "payload": { "object": "settingsLayer", "prop": "active", "value": false, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "ping", "label": "session remains live after Settings route", "expect": [ { "path": "gates.drive", "op": "==", "value": true }, { "path": "gates.read", "op": "==", "value": true } ] }
  ]
}
