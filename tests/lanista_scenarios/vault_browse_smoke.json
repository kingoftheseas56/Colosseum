{
  "name": "vault-browse-smoke",
  "comment": "Vault Browse face execution plan, Slices 5-8: the assembled face (carousel, collapsible rail, breadcrumb, media-faced grid; Slice 5), living tile states + the detail sheet (Slices 6-7), and the series drill (Slice 8 — show to seasons band to episode wall) over a fixture root mirroring the five real library shapes (tests/fixtures/vault/browse-face-smoke: a one-film folder, Loki's two sibling season folders, The Wire's nested-season folder — claims 5 seasons, holds only Season 4 — Gintama's absolute-numbered episodes (Slice 8: extended from 3 to 300 stub files for the virtualization proof at real Gintama scale — the real disk shows 367), Cricket's loose clips). Run with --seed tests/fixtures/vault/browse-face-smoke-seed (an absolute path; its vault/config.json points a confirmed root directly at the fixture tree — no pre-built index needed, VaultLibrary::republishAtBoot() scans+publishes any confirmed root automatically at boot). Isolated tagged session, never the daily app.",
  "steps": [
    { "cmd": "ping", "label": "the session answers, drive gated on",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "one visible window, isolated data root",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" },
                  { "path": "appDataRoot", "op": "contains", "value": "Colosseum-dltest" } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash has left the screen",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the Vault via the folder door",
      "payload": { "target": "taskbarVaultDoor" } },
    { "cmd": "ui-wait-for", "label": "the seeded fixture root paints the populated Vault",
      "payload": { "object": "vaultPage", "prop": "vaultState", "value": "populated", "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the grid settles at the expected node count (the collapse, proven at runtime)",
      "payload": { "object": "vaultBrowseGrid", "prop": "count", "value": 5, "timeout_ms": 10000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "Loki's TWO sibling season folders collapsed to ONE show card",
      "payload": { "object": "vaultBrowseCard_c:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke::show::loki",
                   "props": ["nodeType", "displayTitle", "state"] },
      "expect": [ { "path": "props.nodeType", "op": "==", "value": "show" },
                  { "path": "props.displayTitle", "op": "==", "value": "Loki" },
                  { "path": "props.state", "op": "==", "value": "identified" } ] },
    { "cmd": "qml-get", "label": "the one-film folder presents as that film (locked design #4)",
      "payload": { "object": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/Spider-Man No Way Home (2021) [1080p] [WEBRip] [5.1] [YTS.MX]",
                   "props": ["nodeType", "displayTitle"] },
      "expect": [ { "path": "props.nodeType", "op": "==", "value": "film" },
                  { "path": "props.displayTitle", "op": "==", "value": "Spider-Man No Way Home" } ] },
    { "cmd": "get-state", "label": "visual evidence: the populated grid, collapsed rail",
      "payload": { "grab": { "target": "vaultBrowseGrid", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] },

    { "cmd": "ui-click", "label": "Slice 7: open the Spider-Man film — the detail sheet, not a direct Play",
      "payload": { "target": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/Spider-Man No Way Home (2021) [1080p] [WEBRip] [5.1] [YTS.MX]_hitArea" } },
    { "cmd": "ui-wait-for", "label": "the detail sheet opens",
      "payload": { "object": "vaultBrowseSheet", "prop": "visible", "value": true, "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "physical truth against the real fixture: 1 copy, 2 companions (.srt + Subs/), 2 extras",
      "payload": { "object": "vaultBrowseSheet", "props": ["copiesHeld", "companionsCount", "extrasCount"] },
      "expect": [ { "path": "props.copiesHeld", "op": "==", "value": "1" },
                  { "path": "props.companionsCount", "op": "==", "value": "2" },
                  { "path": "props.extrasCount", "op": "==", "value": "2" } ] },
    { "cmd": "qml-get", "label": "the one copy's quality line, parsed straight from the real filename",
      "payload": { "object": "vaultBrowseSheetCopy_0", "props": ["quality", "away"] },
      "expect": [ { "path": "props.quality", "op": "==", "value": "1080p WEBRip" },
                  { "path": "props.away", "op": "==", "value": "false" } ] },
    { "cmd": "get-state", "label": "visual evidence: the detail sheet on the Spider-Man fixture",
      "payload": { "grab": { "target": "vaultBrowseSheet", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] },

    { "cmd": "ui-click", "label": "regression: Back dismisses the sheet without disturbing the grid",
      "payload": { "target": "vaultBrowseSheetBack" } },
    { "cmd": "ui-wait-for", "label": "the sheet closes",
      "payload": { "object": "vaultBrowseSheet", "prop": "visible", "value": false, "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the grid's node count is untouched by the sheet round-trip",
      "payload": { "object": "vaultBrowseGrid", "props": ["count"] },
      "expect": [ { "path": "props.count", "op": "==", "value": "5" } ] },

    { "cmd": "ui-click", "label": "open a plain folder card (Cricket — loose clips, no show pattern)",
      "payload": { "target": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/Cricket_hitArea" } },
    { "cmd": "ui-wait-for", "label": "the breadcrumb extends to the drilled folder",
      "payload": { "object": "vaultBrowseCrumb", "prop": "currentPath",
                   "value": "C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/Cricket",
                   "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the rail is collapsed by default",
      "payload": { "object": "vaultBrowseRail", "props": ["expanded"] },
      "expect": [ { "path": "props.expanded", "op": "==", "value": "false" } ] },
    { "cmd": "get-state", "label": "visual evidence: the collapsed rail",
      "payload": { "grab": { "target": "vaultBrowseRail", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "ui-click", "label": "toggle the rail open",
      "payload": { "target": "vaultBrowseRailToggle" } },
    { "cmd": "ui-wait-for", "label": "the rail expands",
      "payload": { "object": "vaultBrowseRail", "prop": "expanded", "value": true, "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "visual evidence: the expanded rail",
      "payload": { "grab": { "target": "vaultBrowseRail", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] },

    { "cmd": "ui-click", "label": "return to root before Slice 8's series drill",
      "payload": { "target": "vaultBrowseRailRoot_0" } },
    { "cmd": "ui-wait-for", "label": "the grid is back at the root's 5 nodes",
      "payload": { "object": "vaultBrowseGrid", "prop": "count", "value": 5, "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },

    { "cmd": "ui-wait-for", "label": "Slice 8: the Wire show card exists before clicking it (real fixture: claims 5 seasons, holds only Season 4)",
      "payload": { "object": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/The Wire (2002) Season 1-5 S01-S05 [1080p] [BluRay] [5.1]",
                   "prop": "nodeType", "value": "show", "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "drill the Wire show",
      "payload": { "target": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/The Wire (2002) Season 1-5 S01-S05 [1080p] [BluRay] [5.1]_hitArea" } },
    { "cmd": "ui-wait-for", "label": "the crumb extends to the Wire show",
      "payload": { "object": "vaultBrowseCrumb", "prop": "currentPath",
                   "value": "C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/The Wire (2002) Season 1-5 S01-S05 [1080p] [BluRay] [5.1]",
                   "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the seasons band holds exactly the ONE season physically present (season-presence honesty, not the claimed 5)",
      "payload": { "object": "vaultBrowseGrid", "prop": "count", "value": 1, "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the season card: 2:3 poster node, honest fact string, exact equality",
      "payload": { "object": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/The Wire (2002) Season 1-5 S01-S05 [1080p] [BluRay] [5.1]/Season 4",
                   "props": ["nodeType", "displayTitle", "physicalFact"] },
      "expect": [ { "path": "props.nodeType", "op": "==", "value": "season" },
                  { "path": "props.displayTitle", "op": "==", "value": "Season 4" },
                  { "path": "props.physicalFact", "op": "==", "value": "2 episodes" } ] },
    { "cmd": "get-state", "label": "visual evidence: the seasons band (one honestly-held season)",
      "payload": { "grab": { "target": "vaultBrowseGrid", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] },

    { "cmd": "ui-click", "label": "drill Season 4 to the episode wall",
      "payload": { "target": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/The Wire (2002) Season 1-5 S01-S05 [1080p] [BluRay] [5.1]/Season 4_hitArea" } },
    { "cmd": "ui-wait-for", "label": "the crumb extends to Season 4",
      "payload": { "object": "vaultBrowseCrumb", "prop": "currentPath",
                   "value": "C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/The Wire (2002) Season 1-5 S01-S05 [1080p] [BluRay] [5.1]/Season 4",
                   "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the episode wall holds both real files",
      "payload": { "object": "vaultBrowseGrid", "prop": "count", "value": 2, "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the first episode card exists and is a 16:9 episode node (nodeType == episodes, the plan's own wait)",
      "payload": { "object": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/The Wire (2002) Season 1-5 S01-S05 [1080p] [BluRay] [5.1]/Season 4/The.Wire.S04E01.1080p.BluRay.x264.mkv",
                   "prop": "nodeType", "value": "episode", "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the episode fact line: S<season>:E<episode> plus quality, exact string equality (composed, never contains)",
      "payload": { "object": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/The Wire (2002) Season 1-5 S01-S05 [1080p] [BluRay] [5.1]/Season 4/The.Wire.S04E01.1080p.BluRay.x264.mkv",
                   "props": ["nodeType", "displayTitle", "physicalFact"] },
      "expect": [ { "path": "props.nodeType", "op": "==", "value": "episode" },
                  { "path": "props.physicalFact", "op": "==", "value": "S4:E1 · 1080p BluRay" } ] },
    { "cmd": "get-state", "label": "visual evidence: the episode wall (16:9 wide cards)",
      "payload": { "grab": { "target": "vaultBrowseGrid", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] },

    { "cmd": "ui-click", "label": "back to root (rail root entry) before the Gintama-scale drill",
      "payload": { "target": "vaultBrowseRailRoot_0" } },
    { "cmd": "ui-wait-for", "label": "the grid is back at the root's 5 nodes",
      "payload": { "object": "vaultBrowseGrid", "prop": "count", "value": 5, "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },

    { "cmd": "ui-wait-for", "label": "Slice 8 at scale: the Gintama show card exists (367 episodes real, 300 stubbed here — flat, absolute-numbered, no season subfolders on disk)",
      "payload": { "object": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/[Judas] Gintama 001-367 (Seasons 1-10) [BD 1080p][HEVC x265 10bit][Eng-Subs]",
                   "prop": "nodeType", "value": "show", "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "drill the Gintama-scale show",
      "payload": { "target": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/[Judas] Gintama 001-367 (Seasons 1-10) [BD 1080p][HEVC x265 10bit][Eng-Subs]_hitArea" } },
    { "cmd": "ui-wait-for", "label": "the crumb extends to the Gintama show",
      "payload": { "object": "vaultBrowseCrumb", "prop": "currentPath",
                   "value": "C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/[Judas] Gintama 001-367 (Seasons 1-10) [BD 1080p][HEVC x265 10bit][Eng-Subs]",
                   "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the flat show drills DIRECTLY to its 300-episode wall — no season band exists to hold one (folder-true: this real disk shape has no season subfolders)",
      "payload": { "object": "vaultBrowseGrid", "prop": "count", "value": 300, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "episode 1's fact line: absolute numbering has no season, so the honest 'Episode N' shape plus quality",
      "payload": { "object": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/[Judas] Gintama 001-367 (Seasons 1-10) [BD 1080p][HEVC x265 10bit][Eng-Subs]/[Judas] Gintama - 001 [BD 1080p][HEVC x265 10bit][Eng-Subs].mkv",
                   "props": ["nodeType", "physicalFact"] },
      "expect": [ { "path": "props.nodeType", "op": "==", "value": "episode" },
                  { "path": "props.physicalFact", "op": "==", "value": "Episode 1 · 1080p" } ] },
    { "cmd": "get-state", "label": "visual evidence: the episode wall at scale",
      "payload": { "grab": { "target": "vaultBrowseGrid", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] },

    { "cmd": "ui-scroll", "label": "scroll the episode wall — the bridge has no absence assertion (ledger: UNAVAILABLE), so 'not yet instantiated' is proven at the Quick Test layer instead (created-delegate-count < total); this replay proves the positive half, scrolling reveals a card beyond the initial cacheBuffer window (episodes ~1-18 render unscrolled — measured live)",
      "payload": { "target": "vaultBrowseGrid", "dy": -800 } },
    { "cmd": "ui-scroll", "label": "scroll (2)", "payload": { "target": "vaultBrowseGrid", "dy": -800 } },
    { "cmd": "ui-scroll", "label": "scroll (3)", "payload": { "target": "vaultBrowseGrid", "dy": -800 } },
    { "cmd": "ui-scroll", "label": "scroll (4)", "payload": { "target": "vaultBrowseGrid", "dy": -800 } },
    { "cmd": "ui-scroll", "label": "scroll (5)", "payload": { "target": "vaultBrowseGrid", "dy": -800 } },
    { "cmd": "ui-scroll", "label": "scroll (6)", "payload": { "target": "vaultBrowseGrid", "dy": -800 } },
    { "cmd": "ui-scroll", "label": "scroll (7)", "payload": { "target": "vaultBrowseGrid", "dy": -800 } },
    { "cmd": "ui-scroll", "label": "scroll (8)", "payload": { "target": "vaultBrowseGrid", "dy": -800 } },
    { "cmd": "ui-scroll", "label": "scroll (9)", "payload": { "target": "vaultBrowseGrid", "dy": -800 } },
    { "cmd": "ui-scroll", "label": "scroll (10 of 10)", "payload": { "target": "vaultBrowseGrid", "dy": -800 } },
    { "cmd": "ui-wait-for", "label": "a later card exists by name after scrolling — virtualization delivering on demand, the plan's own proof",
      "payload": { "object": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/[Judas] Gintama 001-367 (Seasons 1-10) [BD 1080p][HEVC x265 10bit][Eng-Subs]/[Judas] Gintama - 022 [BD 1080p][HEVC x265 10bit][Eng-Subs].mkv",
                   "prop": "nodeType", "value": "episode", "timeout_ms": 12000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },

    { "cmd": "ui-click", "label": "regression: back out from depth (rail root) — the level's scroll must be restored on return",
      "payload": { "target": "vaultBrowseRailRoot_0" } },
    { "cmd": "ui-wait-for", "label": "back at the root's 5 nodes",
      "payload": { "object": "vaultBrowseGrid", "prop": "count", "value": 5, "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the Gintama show card exists again before redrilling",
      "payload": { "object": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/[Judas] Gintama 001-367 (Seasons 1-10) [BD 1080p][HEVC x265 10bit][Eng-Subs]",
                   "prop": "nodeType", "value": "show", "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "redrill the Gintama-scale show",
      "payload": { "target": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/[Judas] Gintama 001-367 (Seasons 1-10) [BD 1080p][HEVC x265 10bit][Eng-Subs]_hitArea" } },
    { "cmd": "ui-wait-for", "label": "back at the 300-episode wall",
      "payload": { "object": "vaultBrowseGrid", "prop": "count", "value": 300, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "episode 22 is there again WITHOUT a fresh scroll action — proving the level's scroll position survived the round trip (design §4.8)",
      "payload": { "object": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/[Judas] Gintama 001-367 (Seasons 1-10) [BD 1080p][HEVC x265 10bit][Eng-Subs]/[Judas] Gintama - 022 [BD 1080p][HEVC x265 10bit][Eng-Subs].mkv",
                   "prop": "nodeType", "value": "episode", "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },

    { "cmd": "ui-click", "label": "return to root (the rail's own root entry) before the Play proof",
      "payload": { "target": "vaultBrowseRailRoot_0" } },
    { "cmd": "ui-wait-for", "label": "the grid is back at the root's 5 nodes",
      "payload": { "object": "vaultBrowseGrid", "prop": "count", "value": 5, "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "reopen the sheet to prove Play",
      "payload": { "target": "vaultBrowseCard_C:/users/suprabha/desktop/brotherhood/colosseum/tests/fixtures/vault/browse-face-smoke/Spider-Man No Way Home (2021) [1080p] [WEBRip] [5.1] [YTS.MX]_hitArea" } },
    { "cmd": "ui-wait-for", "label": "the detail sheet reopens",
      "payload": { "object": "vaultBrowseSheet", "prop": "visible", "value": true, "timeout_ms": 4000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "Play — the shipped launch seam, machine-checkable",
      "payload": { "target": "vaultBrowseSheetPlay" } },
    { "cmd": "ui-wait-for", "label": "the launch fired exactly once",
      "payload": { "object": "localLaunchState", "prop": "openCount", "value": 1, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the route is video — Play handed off through the shared launch path",
      "payload": { "object": "localLaunchState", "props": ["lastRouteKind"] },
      "expect": [ { "path": "props.lastRouteKind", "op": "==", "value": "video" } ] }
  ]
}
