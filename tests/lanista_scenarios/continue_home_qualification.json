{
  "name": "continue-home-qualification",
  "comment": "Measurement-only Home Continue probe. Uses a tagged file-backed Progress seed, dismisses onboarding through the real Lanista drive path, then dumps only the Home subtree. The runner output is parsed for ContinueTile delegate rows; no production QML is changed and no provider result is required.",
  "steps": [
    { "cmd": "ping", "label": "the isolated app answers with Drive enabled",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "the app reports its tagged disposable data root",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" },
                  { "path": "appDataRoot", "op": "contains", "value": "Colosseum-dltest" } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash clears",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "dismiss fresh-session onboarding",
      "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "the account host closes",
      "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "the Home page is visible before structural capture",
      "payload": { "object": "homePageFlickable" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" } ] },
    { "cmd": "dump-ui", "label": "capture the Home subtree for ContinueTile delegate counting",
      "payload": { "root": "homePageFlickable", "maxDepth": 40, "maxItems": 5000 },
      "expect": [ { "path": "count", "op": ">", "value": "0" } ] }
  ]
}
