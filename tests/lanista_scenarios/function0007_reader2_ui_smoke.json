{
  "name": "function0007-reader2-ui-smoke",
  "comment": "Function 0007's ordinary no-sleep Biblio -> downloaded EPUB -> Reader 2 journey. Uses the existing real tiny EPUB seed, a tagged Drive-gated session, and only named visibility/loading/ready state; no fixed timed-settle step is part of this proof.",
  "steps": [
    { "cmd": "ping", "label": "the tagged session answers on its own pipe with Drive enabled",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "the session reports its isolated AppData root",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" },
                  { "path": "appDataRoot", "op": "contains", "value": "Colosseum-dltest" } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash has left the screen",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "dismiss account onboarding through the existing named action",
      "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "account onboarding is gone",
      "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "enter the Biblio world",
      "payload": { "target": "modePill_Biblio" } },
    { "cmd": "ui-wait-for", "label": "Biblio's tab bar appears",
      "payload": { "object": "biblioTabBar", "prop": "visible", "value": true, "timeout_ms": 20000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the retained Discover catalog load settles before the Library assertion",
      "payload": { "object": "biblioDiscoverPage", "prop": "loading", "value": false, "timeout_ms": 30000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "switch to the Library tab",
      "payload": { "target": "biblioTab_library" } },
    { "cmd": "ui-wait-for", "label": "the Library page is on screen",
      "payload": { "object": "biblioLibraryPage", "prop": "visible", "value": true, "timeout_ms": 30000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "reveal the seeded Library card through the page's real scroll surface",
      "payload": { "target": "biblioTabBar", "dy": -1200 } },
    { "cmd": "ui-wait-for", "label": "the seeded book's Library card is structurally present after the scroll",
      "payload": { "object": "biblioLibraryCard_arc 19 book|test author", "prop": "visible", "value": true, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the seeded book's detail page",
      "payload": { "target": "biblioLibraryCard_arc 19 book|test author" } },
    { "cmd": "ui-wait-for", "label": "the BiblioBook detail page is on screen",
      "payload": { "object": "biblioBookDetail", "prop": "visible", "value": true, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the downloaded book is ready locally",
      "payload": { "object": "biblioPrimaryReadStatus", "prop": "text", "value": "Ready on this device", "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the detail route resolves the seeded local EPUB without acquisition",
      "payload": { "object": "biblioBookDetail", "props": ["localPath", "readError", "pendingReadTransport"] },
      "expect": [ { "path": "props.localPath", "op": "contains", "value": "Colosseum-dltest" },
                  { "path": "props.localPath", "op": "contains", "value": "/books/" },
                  { "path": "props.localPath", "op": "matches", "value": "tiny-book\\.epub$" },
                  { "path": "props.readError", "op": "==", "value": "" },
                  { "path": "props.pendingReadTransport", "op": "==", "value": "" } ] },
    { "cmd": "ui-click", "label": "the named Read action opens the production Reader 2 shell",
      "payload": { "target": "biblioPrimaryRead" } },
    { "cmd": "ui-wait-for", "label": "the production Reader 2 reaches ready on the seeded EPUB",
      "payload": { "object": "bookReaderShell", "prop": "bookReady", "value": true, "timeout_ms": 40000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the reader uses the same tagged seeded local path",
      "payload": { "object": "bookReaderShell", "props": ["bookPath", "bookReady"] },
      "expect": [ { "path": "props.bookPath", "op": "contains", "value": "Colosseum-dltest" },
                  { "path": "props.bookPath", "op": "contains", "value": "/books/" },
                  { "path": "props.bookPath", "op": "matches", "value": "tiny-book\\.epub$" },
                  { "path": "props.bookReady", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "evidence grab: the ready Reader 2",
      "payload": { "grab": { "target": "bookReaderShell", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] }
  ]
}
