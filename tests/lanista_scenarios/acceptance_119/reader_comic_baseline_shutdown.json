{
  "name": "reader-comic-baseline-shutdown",
  "comment": "Positive unchanged-baseline QML shutdown comparison. Uses only selectors present at a6104f7a8d9aab9766e71f031b7908beaeca85ad, fresh comic seed, default paired-page layout. This is not a matched single-page A04 comparison. Runner appends acknowledged Ctrl+Q and requires normal exit. NOT RUN.",
  "steps": [
    {
      "cmd": "ping",
      "label": "001 Prove native protocol and drive gate",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "schema",
          "op": "matches",
          "value": "^colosseum\\.dev\\.v1"
        },
        {
          "path": "gates.drive",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "002 Prove visible owned disposable profile",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "windows.0.visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "appDataRoot",
          "op": "contains",
          "value": "Colosseum-dltest-"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "003 bootSplash.visible reaches False",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      }
    },
    {
      "cmd": "ui-click",
      "label": "004 Continue locally without account sign-in",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "clicked",
          "op": "==",
          "value": "accountWelcomeContinueLocal"
        }
      ],
      "payload": {
        "target": "accountWelcomeContinueLocal"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "005 accountHost.visible reaches False",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "accountHost",
        "prop": "visible",
        "value": false,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-click",
      "label": "006 Open taskbar dock",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "clicked",
          "op": "==",
          "value": "colosseumTaskbarHomeButton"
        }
      ],
      "payload": {
        "target": "colosseumTaskbarHomeButton"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "007 openRecentDisclosure.visible reaches True",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "openRecentDisclosure",
        "prop": "visible",
        "value": true,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-query",
      "label": "008 openRecentDisclosure is visible, enabled, and within window",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "enabled",
          "op": "==",
          "value": "true"
        },
        {
          "path": "clippedByWindow",
          "op": "==",
          "value": "false"
        },
        {
          "path": "localRect.width",
          "op": ">",
          "value": "0"
        },
        {
          "path": "localRect.height",
          "op": ">",
          "value": "0"
        }
      ],
      "payload": {
        "object": "openRecentDisclosure"
      }
    },
    {
      "cmd": "ui-click",
      "label": "009 Open actual Recent panel",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "clicked",
          "op": "==",
          "value": "openRecentDisclosure"
        }
      ],
      "payload": {
        "target": "openRecentDisclosure"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "010 openRecentPanel.visible reaches True",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "openRecentPanel",
        "prop": "visible",
        "value": true,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "011 openRecentPanel.rowCount reaches 2",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "openRecentPanel",
        "prop": "rowCount",
        "value": 2,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-query",
      "label": "012 openRecentRow_0 is visible, enabled, and within window",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "enabled",
          "op": "==",
          "value": "true"
        },
        {
          "path": "clippedByWindow",
          "op": "==",
          "value": "false"
        },
        {
          "path": "localRect.width",
          "op": ">",
          "value": "0"
        },
        {
          "path": "localRect.height",
          "op": ">",
          "value": "0"
        }
      ],
      "payload": {
        "object": "openRecentRow_0"
      }
    },
    {
      "cmd": "ui-click",
      "label": "013 Route seeded local file through production Recent action",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "clicked",
          "op": "==",
          "value": "openRecentRow_0"
        }
      ],
      "payload": {
        "target": "openRecentRow_0"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "014 comicReaderShell.readerPageCount reaches 8",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "comicReaderShell",
        "prop": "readerPageCount",
        "value": 8,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "015 comicReaderShell.readerSourceId reaches ${FIXTURE_ROOT}/comics/a/twin.cbz",
      "payload": {
        "object": "comicReaderShell",
        "prop": "readerSourceId",
        "value": "${FIXTURE_ROOT}/comics/a/twin.cbz",
        "timeout_ms": 20000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "016 comicReaderShell.readerReady reaches True",
      "payload": {
        "object": "comicReaderShell",
        "prop": "readerReady",
        "value": true,
        "timeout_ms": 20000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "017 comicReaderShell.layout reaches paired_pages",
      "payload": {
        "object": "comicReaderShell",
        "prop": "layout",
        "value": "paired_pages",
        "timeout_ms": 20000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "018 comicReaderShell.currentPage reaches 1",
      "payload": {
        "object": "comicReaderShell",
        "prop": "currentPage",
        "value": 1,
        "timeout_ms": 20000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "019 doubleSurface.rightPixelsShown reaches True",
      "payload": {
        "object": "doubleSurface",
        "prop": "rightPixelsShown",
        "value": true,
        "timeout_ms": 20000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "020 Exact baseline identity and rendered first page",
      "payload": {
        "object": "comicReaderShell",
        "props": [
          "readerSourceId",
          "seriesId",
          "readerPageCount",
          "readerPageIndex",
          "presentedPage",
          "layout",
          "readerReady"
        ]
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.readerSourceId",
          "op": "==",
          "value": "${FIXTURE_ROOT}/comics/a/twin.cbz"
        },
        {
          "path": "props.seriesId",
          "op": "==",
          "value": "${COMIC_A_ID}"
        },
        {
          "path": "props.readerPageCount",
          "op": "==",
          "value": "8"
        },
        {
          "path": "props.readerPageIndex",
          "op": "==",
          "value": "0"
        },
        {
          "path": "props.presentedPage",
          "op": "==",
          "value": "1"
        },
        {
          "path": "props.layout",
          "op": "==",
          "value": "paired_pages"
        },
        {
          "path": "props.readerReady",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "021 Baseline active reader before normal shutdown",
      "payload": {
        "grab": {
          "target": "comicReaderShell",
          "timeoutMs": 6000
        }
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
      ]
    }
  ]
}
