{
  "name": "reader-comic-restart",
  "comment": "1.1.9 authored native Lanista journey. NOT RUN until qualified against the candidate; every protocol command explicitly requires type=reply. Seeded Recent/config setup is distinct from native picker interaction.",
  "steps": [
    {
      "cmd": "ping",
      "label": "001 Prove native protocol and drive gate",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "schema",
          "op": "matches",
          "value": "^colosseum\\.dev\\.v1"
        },
        {
          "path": "gates.drive",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "002 Prove visible owned disposable profile",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "windows.0.visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "appDataRoot",
          "op": "contains",
          "value": "Colosseum-dltest-"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "003 bootSplash.visible reaches False",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "004 accountHost.visible reaches False",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "accountHost",
        "prop": "visible",
        "value": false,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "005 Wait for asynchronously created Home Continue action",
      "payload": {
        "object": "continueResume_${COMIC_A_ID}",
        "prop": "visible",
        "value": true,
        "timeout_ms": 20000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-query",
      "label": "006 continueResume_${COMIC_A_ID} is visible, enabled, and within window",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "enabled",
          "op": "==",
          "value": "true"
        },
        {
          "path": "clippedByWindow",
          "op": "==",
          "value": "false"
        },
        {
          "path": "localRect.width",
          "op": ">",
          "value": "0"
        },
        {
          "path": "localRect.height",
          "op": ">",
          "value": "0"
        }
      ],
      "payload": {
        "object": "continueResume_${COMIC_A_ID}"
      }
    },
    {
      "cmd": "ui-click",
      "label": "007 Activate Home Continue for file A after process restart",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "clicked",
          "op": "==",
          "value": "continueResume_${COMIC_A_ID}"
        }
      ],
      "payload": {
        "target": "continueResume_${COMIC_A_ID}"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "008 comicReaderShell.readerSourceId reaches ${FIXTURE_ROOT}/comics/a/twin.cbz",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "comicReaderShell",
        "prop": "readerSourceId",
        "value": "${FIXTURE_ROOT}/comics/a/twin.cbz",
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "009 comicReaderShell.currentPage reaches 4",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "comicReaderShell",
        "prop": "currentPage",
        "value": 4,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "010 comicReaderShell.readerReady reaches True",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "comicReaderShell",
        "prop": "readerReady",
        "value": true,
        "timeout_ms": 40000
      }
    },
    {
      "cmd": "qml-get",
      "label": "011 Exact standalone identity and presented page",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.readerSourceId",
          "op": "==",
          "value": "${FIXTURE_ROOT}/comics/a/twin.cbz"
        },
        {
          "path": "props.seriesId",
          "op": "==",
          "value": "${COMIC_A_ID}"
        },
        {
          "path": "props.readerPageCount",
          "op": "==",
          "value": "8"
        },
        {
          "path": "props.readerPageIndex",
          "op": "==",
          "value": "3"
        },
        {
          "path": "props.presentedPage",
          "op": "==",
          "value": "4"
        },
        {
          "path": "props.layout",
          "op": "==",
          "value": "single_page"
        },
        {
          "path": "props.readerReady",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "comicReaderShell",
        "props": [
          "readerSourceId",
          "seriesId",
          "readerPageCount",
          "readerPageIndex",
          "presentedPage",
          "layout",
          "readerReady"
        ]
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "012 singleSurface.contentRendered reaches True",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "singleSurface",
        "prop": "contentRendered",
        "value": true,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "qml-get",
      "label": "013 Actual visible Image.Ready evidence, not an error placard",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.active",
          "op": "==",
          "value": "true"
        },
        {
          "path": "props.pageIndex",
          "op": "==",
          "value": "3"
        },
        {
          "path": "props.contentRendered",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "singleSurface",
        "props": [
          "active",
          "pageIndex",
          "contentRendered"
        ]
      }
    },
    {
      "cmd": "get-state",
      "label": "014 Continue restored exact A04 identity/page",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "grabPath",
          "op": "exists"
        }
      ],
      "payload": {
        "grab": {
          "target": "comicReaderShell",
          "timeoutMs": 6000
        }
      }
    },
    {
      "cmd": "ui-click",
      "label": "015 Use visible reader Back; flush progress",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "clicked",
          "op": "==",
          "value": "hudBackAction"
        }
      ],
      "payload": {
        "target": "hudBackAction"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "016 homePageFlickable.visible reaches True",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "homePageFlickable",
        "prop": "visible",
        "value": true,
        "timeout_ms": 20000
      }
    }
  ]
}
