{
  "name": "vault-empty",
  "comment": "1.1.9 authored native Lanista journey. NOT RUN until qualified against the candidate; every protocol command explicitly requires type=reply. Seeded Recent/config setup is distinct from native picker interaction.",
  "steps": [
    {
      "cmd": "ping",
      "label": "001 Prove native protocol and drive gate",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "schema",
          "op": "matches",
          "value": "^colosseum\\.dev\\.v1"
        },
        {
          "path": "gates.drive",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "002 Prove visible owned disposable profile",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "windows.0.visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "appDataRoot",
          "op": "contains",
          "value": "Colosseum-dltest-"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "003 bootSplash.visible reaches False",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      }
    },
    {
      "cmd": "ui-click",
      "label": "004 Continue locally without account sign-in",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "clicked",
          "op": "==",
          "value": "accountWelcomeContinueLocal"
        }
      ],
      "payload": {
        "target": "accountWelcomeContinueLocal"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "005 accountHost.visible reaches False",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "accountHost",
        "prop": "visible",
        "value": false,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-click",
      "label": "006 Enter Vault through its separate door",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "clicked",
          "op": "==",
          "value": "taskbarVaultDoor"
        }
      ],
      "payload": {
        "target": "taskbarVaultDoor"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "007 vaultPage.hasConfirmedStorage reaches True",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "vaultPage",
        "prop": "hasConfirmedStorage",
        "value": true,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "008 vaultPage.scanning reaches False",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "vaultPage",
        "prop": "scanning",
        "value": false,
        "timeout_ms": 60000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "009 vaultPage.currentBrowsePath reaches ${VAULT_EMPTY_ROOT}",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "vaultPage",
        "prop": "currentBrowsePath",
        "value": "${VAULT_EMPTY_ROOT}",
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "vault-forensics",
      "label": "010 Confirm exact owned fixture root",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "schema",
          "op": "==",
          "value": "colosseum.vault.forensics.v1"
        },
        {
          "path": "roots.count",
          "op": "==",
          "value": "1"
        },
        {
          "path": "roots.rows.0.path",
          "op": "==",
          "value": "${VAULT_EMPTY_ROOT}"
        },
        {
          "path": "truncated",
          "op": "==",
          "value": "false"
        }
      ],
      "payload": {
        "scope": "summary",
        "limit": 10
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "011 vaultBrowseGrid.count reaches 0",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "vaultBrowseGrid",
        "prop": "count",
        "value": 0,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "qml-get",
      "label": "012 Confirmed empty root has the correct visible empty state",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.cause",
          "op": "==",
          "value": "emptyFolder"
        },
        {
          "path": "props.headingText",
          "op": "==",
          "value": "This folder is empty"
        }
      ],
      "payload": {
        "object": "vaultBrowseGridEmpty",
        "props": [
          "cause",
          "headingText"
        ]
      }
    },
    {
      "cmd": "ui-query",
      "label": "013 vaultBrowseGridEmpty is visible, enabled, and within window",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "enabled",
          "op": "==",
          "value": "true"
        },
        {
          "path": "clippedByWindow",
          "op": "==",
          "value": "false"
        },
        {
          "path": "localRect.width",
          "op": ">",
          "value": "0"
        },
        {
          "path": "localRect.height",
          "op": ">",
          "value": "0"
        }
      ],
      "payload": {
        "object": "vaultBrowseGridEmpty"
      }
    },
    {
      "cmd": "get-state",
      "label": "014 Empty configured Vault root",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "grabPath",
          "op": "exists"
        }
      ],
      "payload": {
        "grab": {
          "target": "vaultPage",
          "timeoutMs": 6000
        }
      }
    }
  ]
}
