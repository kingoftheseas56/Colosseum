        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "vaultPage",
        "prop": "currentBrowsePath",
        "value": "${VAULT_NESTED_ROOT}",
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "vault-forensics",
      "label": "010 Confirm exact owned fixture root",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "schema",
          "op": "==",
          "value": "colosseum.vault.forensics.v1"
        },
        {
          "path": "roots.count",
          "op": "==",
          "value": "1"
        },
        {
          "path": "roots.rows.0.path",
          "op": "==",
          "value": "${VAULT_NESTED_ROOT}"
        },
        {
          "path": "truncated",
          "op": "==",
          "value": "false"
        }
      ],
      "payload": {
        "scope": "summary",
        "limit": 10
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "011 vaultBrowseGrid.count reaches 1",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "vaultBrowseGrid",
        "prop": "count",
        "value": 1,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "qml-get",
      "label": "012 Fresh current UI starts with expanded rail",
