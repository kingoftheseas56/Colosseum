{
  "name": "SHELL-LOCAL-RESTART",
  "steps": [
    {
      "cmd": "ping",
      "label": "owned protocol drive enabled",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "gates.drive",
          "op": "==",
          "value": "true"
        },
        {
          "path": "gates.write",
          "op": "==",
          "value": "false"
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "visible isolated app",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "windows.0.visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "appDataRoot",
          "op": "contains",
          "value": "Colosseum-dltest-"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "bootSplash.visible",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "accountHost.visible",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "accountHost",
        "prop": "visible",
        "value": false,
        "timeout_ms": 15000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "homePageFlickable.visible",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "homePageFlickable",
        "prop": "visible",
        "value": true,
        "timeout_ms": 15000
      }
    },
    {
      "cmd": "qml-get",
      "label": "restart retains Device identity",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.text",
          "op": "==",
          "value": "Device"
        },
        {
          "path": "props.visible",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "colosseumTopbarDeviceLabel",
        "props": [
          "text",
          "visible"
        ]
      }
    },
    {
      "cmd": "get-state",
      "label": "local restart with no onboarding",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "grabPath",
          "op": "exists",
          "value": ""
        }
      ],
      "payload": {
        "grab": {
          "target": "window",
          "timeoutMs": 4000
        }
      }
    }
  ]
}
