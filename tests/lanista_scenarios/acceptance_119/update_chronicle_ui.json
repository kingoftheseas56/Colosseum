{
  "name": "UPD-CHRONICLE-UI",
  "comment": "Shipping-build fresh-profile journey. The outer runner must assert candidate executable/source identity, unique pipe and tagged roots. Real UI controls inspect all six signed 1.1.9 chapters, keyboard Escape and visible Back/reopen. No update presentation injection, no live feed activation, no install claim; GUI download/restart remains separate. On remount the actual Loader constructs chapter one again.",
  "steps": [
    {
      "cmd": "ping",
      "label": "01: Unique owned session answers a valid protocol request",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "schema",
          "op": "matches",
          "value": "^colosseum\\.dev\\.v1"
        },
        {
          "path": "gates.drive",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "02: Visible assembled app and both resolved roots are observable",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "windows.0.visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "appDataRoot",
          "op": "exists"
        },
        {
          "path": "cacheRoot",
          "op": "exists"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "03: Cold boot splash completes",
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "04: Continue fresh onboarding locally with no account",
      "payload": {
        "target": "accountWelcomeContinueLocal"
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "05: Local onboarding releases the shell",
      "payload": {
        "object": "accountHost",
        "prop": "visible",
        "value": false,
        "timeout_ms": 12000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "06: Installed chronicle entry is visible",
      "payload": {
        "object": "colosseumTopbarUpdateButton",
        "prop": "visible",
        "value": true,
        "timeout_ms": 12000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "07: Open installed chronicle through the top bar",
      "payload": {
        "target": "colosseumTopbarUpdateButton"
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
