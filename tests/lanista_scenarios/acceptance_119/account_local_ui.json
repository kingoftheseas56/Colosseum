{
  "name": "ACC-LOCAL-UI",
  "comment": "Fresh pinned-candidate local journey: explicit Continue locally, accountPresent=false and actual Not signed in identity presentation, keyboard Sign in entry, and local return. Rebound from the stale account_local_device_happy_path scenario; this candidate has no six-digit device-label/local-menu contract. Credentials are never entered. Outer runner attests profile/source/version isolation and normal shutdown.",
  "steps": [
    {
      "cmd": "ping",
      "label": "isolated local-device session is alive",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "gates.drive",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "visible assembled app answers state exchange",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "windows.0.visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "appDataRoot",
          "op": "exists"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "boot splash is gone",
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "explicitly continue locally from fresh onboarding",
      "payload": {
        "target": "accountWelcomeContinueLocal"
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "local continuation removes the blocking auth host",
      "payload": {
        "object": "accountHost",
        "prop": "visible",
        "value": false,
        "timeout_ms": 15000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "Device control is visible",
      "payload": {
        "object": "colosseumTopbarAccountButton",
        "prop": "visible",
        "value": true,
        "timeout_ms": 10000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "top bar uses the generic Device label",
      "payload": {
        "object": "colosseumTopbarDeviceLabel",
        "props": [
          "text",
          "visible"
        ]
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "props.text",
          "op": "==",
          "value": "Device"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "open local AccountFlyout from Device",
      "payload": {
        "target": "colosseumTopbarAccountButton"
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "local AccountFlyout is visible",
      "payload": {
        "object": "accountFlyout",
        "prop": "visible",
        "value": true,
        "timeout_ms": 10000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "actual flyout state remains account-free",
      "payload": {
        "object": "accountFlyout",
        "props": [
          "visible",
          "accountPresent",
          "onlineAccount"
        ]
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "props.accountPresent",
          "op": "==",
          "value": "false"
        },
        {
          "path": "props.onlineAccount",
          "op": "==",
          "value": "false"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "actual local identity presentation is Not signed in",
      "payload": {
        "object": "accountFlyoutUsername",
        "props": [
          "text",
          "visible"
        ]
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.text",
          "op": "==",
          "value": "Not signed in"
        },
        {
          "path": "props.visible",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "actual Sign in action receives keyboard focus",
      "payload": {
        "object": "accountFlyoutSessionAction",
        "prop": "activeFocus",
        "value": true,
        "timeout_ms": 5000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "Sign in action is visible enabled and reachable",
      "payload": {
        "object": "accountFlyoutSessionAction",
        "props": [
          "visible",
          "enabled",
          "activeFocus"
        ]
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "props.enabled",
          "op": "==",
          "value": "true"
        },
        {
          "path": "props.activeFocus",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-keypress",
      "label": "keyboard Enter activates actual Sign in control",
      "payload": {
        "key": "Enter"
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "existing Sign in surface is visible",
      "payload": {
        "object": "accountSignIn",
        "prop": "visible",
        "value": true,
        "timeout_ms": 8000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "continue without an account",
      "payload": {
        "target": "accountSignInContinueLocal"
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "auth host closes back into the local shell",
      "payload": {
        "object": "accountHost",
        "prop": "visible",
        "value": false,
        "timeout_ms": 10000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "local shell still exposes generic Device after returning",
      "payload": {
        "object": "colosseumTopbarDeviceLabel",
        "props": [
          "text",
          "visible"
        ]
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "props.text",
          "op": "==",
          "value": "Device"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "reopen Account menu after local return",
      "payload": {
        "target": "colosseumTopbarAccountButton"
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "flyout reaches its keyboard action",
      "payload": {
        "object": "accountFlyoutSessionAction",
        "prop": "activeFocus",
        "value": true,
        "timeout_ms": 5000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-keypress",
      "label": "Escape dismisses local account menu",
      "payload": {
        "key": "Escape"
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "flyout is dismissed",
      "payload": {
        "object": "accountFlyout",
        "prop": "visible",
        "value": false,
        "timeout_ms": 5000
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "local account return screenshot",
      "payload": {
        "grab": {
          "target": "window",
          "timeoutMs": 4000
        }
      },
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "windows.0.visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "grabPath",
          "op": "exists"
        }
      ]
    }
  ]
}
