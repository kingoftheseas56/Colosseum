{
  "name": "EXT-HOUSE-STATE",
  "comment": "Uses extensions-house-fixture seed only. Native House is the default. Three bundled wallpapers load offline. Fixed House tile ids bind one explicitly reviewed inert Nyaa fixture; UI disable/enable and later disable are persisted. Tankoyomi is deliberately absent and its toggle disabled. House/Chain/Store mouse and keyboard routes exercise real controls. Live Store catalogue/provider success is not inferred from route visibility.",
  "steps": [
    {
      "cmd": "ping",
      "label": "001 Native protocol and isolated drive-only session",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "schema",
          "op": "==",
          "value": "colosseum.dev.v1.0"
        },
        {
          "path": "gates.drive",
          "op": "==",
          "value": true
        },
        {
          "path": "gates.write",
          "op": "==",
          "value": false
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "002 App window and tagged profile are observable",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "windows.0.visible",
          "op": "==",
          "value": true
        },
        {
          "path": "appDataRoot",
          "op": "contains",
          "value": "Colosseum-dltest"
        },
        {
          "path": "cacheRoot",
          "op": "contains",
          "value": "Colosseum-dltest"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "003 bootSplash.visible reaches False",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": true
        },
        {
          "path": "value",
          "op": "==",
          "value": false
        }
      ],
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "004 accountWelcomeContinueLocal.visible reaches True",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": true
        },
        {
          "path": "value",
          "op": "==",
          "value": true
        }
      ],
      "payload": {
        "object": "accountWelcomeContinueLocal",
        "prop": "visible",
        "value": true,
        "timeout_ms": 15000
      }
    },
    {
      "cmd": "ui-query",
      "label": "005 accountWelcomeContinueLocal has a visible, enabled in-window hit target",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "visible",
          "op": "==",
          "value": true
        },
        {
          "path": "enabled",
          "op": "==",
          "value": true
        },
        {
          "path": "clippedByWindow",
          "op": "==",
          "value": false
        },
        {
          "path": "rect.width",
          "op": ">=",
          "value": 1
        },
        {
          "path": "rect.height",
          "op": ">=",
          "value": 1
        }
      ],
      "payload": {
        "object": "accountWelcomeContinueLocal"
      }
    },
    {
      "cmd": "ui-click",
      "label": "006 Continue locally through onboarding",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "clicked",
          "op": "==",
          "value": "accountWelcomeContinueLocal"
