{
  "name": "EXT-MISSING-ART-NEG",
  "comment": "Deliberately missing local manifest background; must observe Image.Error and then FAIL an Image.Ready assertion. This also exposes that the candidate House only chooses its bundled fallback when manifest.background is absent, not when supplied art errors. An expected negative-control failure validates detection only; it does not qualify offline recovery.",
  "steps": [
    {
      "cmd": "ping",
      "label": "001 Native protocol and isolated drive-only session",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "schema",
          "op": "==",
          "value": "colosseum.dev.v1.0"
        },
        {
          "path": "gates.drive",
          "op": "==",
          "value": true
        },
        {
          "path": "gates.write",
          "op": "==",
          "value": false
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "002 App window and tagged profile are observable",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "windows.0.visible",
          "op": "==",
          "value": true
        },
        {
          "path": "appDataRoot",
          "op": "contains",
          "value": "Colosseum-dltest"
        },
        {
          "path": "cacheRoot",
          "op": "contains",
          "value": "Colosseum-dltest"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "003 bootSplash.visible reaches False",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": true
        },
        {
          "path": "value",
          "op": "==",
          "value": false
        }
      ],
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "004 accountWelcomeContinueLocal.visible reaches True",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": true
        },
        {
          "path": "value",
          "op": "==",
          "value": true
        }
      ],
      "payload": {
        "object": "accountWelcomeContinueLocal",
        "prop": "visible",
        "value": true,
        "timeout_ms": 15000
      }
    },
    {
      "cmd": "ui-query",
      "label": "005 accountWelcomeContinueLocal has a visible, enabled in-window hit target",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "visible",
          "op": "==",
          "value": true
        },
        {
          "path": "enabled",
          "op": "==",
          "value": true
        },
        {
          "path": "clippedByWindow",
          "op": "==",
          "value": false
        },
        {
          "path": "rect.width",
          "op": ">=",
          "value": 1
        },
        {
          "path": "rect.height",
          "op": ">=",
          "value": 1
        }
      ],
      "payload": {
        "object": "accountWelcomeContinueLocal"
      }
    },
    {
      "cmd": "ui-click",
      "label": "006 Continue locally through onboarding",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "clicked",
          "op": "==",
          "value": "accountWelcomeContinueLocal"
        }
      ],
      "payload": {
        "target": "accountWelcomeContinueLocal"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "007 accountHost.visible reaches False",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": true
        },
        {
          "path": "value",
          "op": "==",
          "value": false
        }
      ],
      "payload": {
        "object": "accountHost",
        "prop": "visible",
        "value": false,
        "timeout_ms": 15000
      }
    },
    {
      "cmd": "ui-keypress",
      "label": "008 Open Extensions with the production keyboard shortcut",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "pressed",
          "op": "==",
          "value": "Ctrl+Shift+E"
        }
      ],
      "payload": {
        "key": "Ctrl+Shift+E"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "009 extensionsLayer.active reaches True",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": true
        },
        {
          "path": "value",
          "op": "==",
          "value": true
        }
      ],
      "payload": {
        "object": "extensionsLayer",
        "prop": "active",
        "value": true,
        "timeout_ms": 10000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "010 extensionsHousePage.visible reaches True",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": true
        },
        {
          "path": "value",
          "op": "==",
          "value": true
        }
      ],
      "payload": {
        "object": "extensionsHousePage",
        "prop": "visible",
        "value": true,
        "timeout_ms": 10000
      }
    },
    {
      "cmd": "qml-get",
      "label": "011 Observe extensionsStorePage",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.section",
          "op": "==",
          "value": "house"
        }
      ],
      "payload": {
        "object": "extensionsStorePage",
        "props": [
          "section"
        ]
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "012 extensionsHouseTab_house.activeFocus reaches True",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": true
        },
        {
          "path": "value",
          "op": "==",
          "value": true
        }
      ],
      "payload": {
        "object": "extensionsHouseTab_house",
        "prop": "activeFocus",
        "value": true,
        "timeout_ms": 10000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "013 extensionsHouseWallpaper_starwars.status reaches Error",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": true
        },
        {
          "path": "value",
          "op": "==",
          "value": "Error"
        }
      ],
      "payload": {
        "object": "extensionsHouseWallpaper_starwars",
        "prop": "status",
        "value": "Error",
        "timeout_ms": 15000
      }
    },
    {
      "cmd": "qml-get",
      "label": "014 Observe extensionsHouseWallpaper_starwars",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.status",
          "op": "==",
          "value": "Error"
        },
        {
          "path": "props.source",
          "op": "contains",
          "value": "intentionally-missing-house-banner.png"
        },
        {
          "path": "grabPath",
          "op": "exists"
        },
        {
          "path": "grabPath",
          "op": "matches",
          "value": "\\.png$"
        }
      ],
      "payload": {
        "object": "extensionsHouseWallpaper_starwars",
        "props": [
          "status",
          "source"
        ],
        "grab": {
          "target": "window",
          "timeoutMs": 4000
        }
      }
    },
    {
      "cmd": "qml-get",
      "label": "015 NEGATIVE CONTROL: missing asset must FAIL the Image.Ready acceptance assertion",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "props.status",
          "op": "==",
          "value": "Ready"
        }
      ],
      "payload": {
        "object": "extensionsHouseWallpaper_starwars",
        "props": [
          "status"
        ]
      }
    },
    {
      "cmd": "ui-keypress",
      "label": "016 Request normal application shutdown; runner checks owned PID exit",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "pressed",
          "op": "==",
          "value": "Ctrl+Q"
        }
      ],
      "payload": {
        "key": "Ctrl+Q"
      }
    }
  ]
}
