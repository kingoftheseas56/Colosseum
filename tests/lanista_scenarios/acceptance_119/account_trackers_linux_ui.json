  "comment": "Linux-only assembled UI assertions for intentionally unavailable tracker vault providers. Uses actual mouse scroll/click and keyboard controls, Image.Ready provider marks, disabled connection, exact selected identity, and return focus. Live provider credentials/network are outside this deterministic case. Run in a fresh suite-owned account-free profile.",
  "steps": [
    {
      "cmd": "ping",
      "label": "001 driven session exchanges valid protocol",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "gates.drive",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "002 assembled app state is visible",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "windows.0.visible",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "003 bootSplash.visible becomes False",
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        },
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ],
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      }
    },
    {
