{
  "name": "biblio-scroll-probe3",
  "description": "Diagnostic: after the header-wheel scroll lands, does the VISIBLE window show the scrolled position, and does an item grab reset contentY?",
  "app": {
    "exe": "native/build-msvc/colosseum.exe"
  },
  "steps": [
    {
      "cmd": "ping",
      "label": "runner ping",
      "expect": [
        {
          "path": "schema",
          "op": "matches",
          "value": "^colosseum\\.dev\\.v1"
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "one visible window",
      "expect": [
        {
          "path": "windows.0.visible",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "boot splash gone",
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 30000
      }
    },
    {
      "cmd": "ui-click",
      "label": "open Biblio mode",
      "payload": {
        "target": "modePill_Biblio"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "biblio tab bar visible",
      "payload": {
        "object": "biblioTabBar",
        "prop": "visible",
        "value": true,
        "timeout_ms": 30000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "the Explore pill resolves",
      "payload": {
        "object": "biblioTab_explore",
        "prop": "visible",
        "value": true,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-click",
      "label": "open Explore",
      "payload": {
        "target": "biblioTab_explore"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "rail model built",
      "payload": {
        "object": "biblioExplorePage",
        "prop": "railKeysCsv",
        "value": "top-10,popular,top-rated,new-releases,trending,most-read,classics",
        "timeout_ms": 30000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "settle: delegates finish laying out",
      "payload": {
        "object": "biblioExploreFlick",
        "prop": "contentY",
        "value": -12345,
        "timeout_ms": 6000
      }
    },
    {
      "cmd": "ui-scroll",
      "label": "one big wheel at the header strip",
      "payload": {
        "target": "biblioExploreHeaderStrip",
        "dy": -6000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "let the glide settle",
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": true,
        "timeout_ms": 5000
      }
    },
    {
      "cmd": "qml-get",
      "label": "contentY before any grab",
      "payload": {
        "object": "biblioExploreFlick",
        "props": [
          "contentY"
        ]
      }
    },
    {
      "cmd": "get-state",
      "label": "WINDOW grab: what the visible screen shows",
      "payload": {
        "grab": {
          "target": "window"
        }
      },
      "expect": [
        {
          "path": "grabPath",
          "op": "exists"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "contentY after the window grab",
      "payload": {
        "object": "biblioExploreFlick",
        "props": [
          "contentY"
        ]
      }
    },
    {
      "cmd": "get-state",
      "label": "ITEM grab of the page",
      "payload": {
        "grab": {
          "target": "biblioExplorePage",
          "timeoutMs": 4000
        }
      },
      "expect": [
        {
          "path": "grabPath",
          "op": "exists"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "contentY after the item grab",
      "payload": {
        "object": "biblioExploreFlick",
        "props": [
          "contentY"
        ]
      }
    }
  ]
}