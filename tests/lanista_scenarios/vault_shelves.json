{
  "name": "vault-shelves",
  "comment": "Vault execution Slice 11: a Vault with a pre-existing published index paints its shelves on open, without a fresh scan (acceptance test). Opens the Vault door and asserts the page reaches the populated state, then grabs the shelves. Run against a tag whose <appdata>/vault/index-v1.sqlite already has rows.",
  "steps": [
    { "cmd": "ping", "label": "the session answers, drive gated on",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "one visible window, isolated data root",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" },
                  { "path": "appDataRoot", "op": "contains", "value": "Colosseum-dltest" } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash has left the screen",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the Vault via the folder door",
      "payload": { "target": "taskbarVaultDoor" } },
    { "cmd": "ui-wait-for", "label": "a pre-existing index paints the populated Vault (no fresh scan)",
      "payload": { "object": "vaultPage", "prop": "vaultState", "value": "populated", "timeout_ms": 10000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the page reports its populated state",
      "payload": { "object": "vaultPage", "props": ["vaultState", "cardVisible"] },
      "expect": [ { "path": "props.vaultState", "op": "==", "value": "populated" },
                  { "path": "props.cardVisible", "op": "==", "value": "false" } ] },
    { "cmd": "ui-query", "label": "grab the populated shelves",
      "payload": { "object": "vaultPage", "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] }
  ]
}
