{
  "name": "biblio-tab-probe4",
  "comment": "Diagnostic (Slice 6): does the Explore pill EVENTUALLY appear if we wait for it by name (boot-timer world-warmup race hypothesis)? Also reads the full-window dump for every WorldTabBar instance. Read + one click.",
  "steps": [
    { "cmd": "ping", "label": "app answers", "expect": [ { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "boot splash gone",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 } },
    { "cmd": "ui-click", "label": "open the Biblio mode",
      "payload": { "target": "modePill_Biblio" } },
    { "cmd": "ui-wait-for", "label": "Biblio's tab bar appears",
      "payload": { "object": "biblioTabBar", "prop": "visible", "value": true, "timeout_ms": 8000 } },
    { "cmd": "ui-wait-for", "label": "the Explore pill resolves given 20s (warmup race?)",
      "payload": { "object": "biblioTab_explore", "prop": "visible", "value": true, "timeout_ms": 20000 } },
    { "cmd": "dump-ui", "label": "full window dump, count WorldTabBar instances and pills",
      "payload": { "maxDepth": 40 } },
    { "cmd": "ui-click", "label": "click the Explore tab",
      "payload": { "target": "biblioTab_explore" } },
    { "cmd": "ui-wait-for", "label": "the Explore page is on screen",
      "payload": { "object": "biblioExplorePage", "prop": "visible", "value": true, "timeout_ms": 8000 } }
  ]
}
