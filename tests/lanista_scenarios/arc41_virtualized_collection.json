      }
    },
    {
      "cmd": "ui-keypress",
      "label": "ordinary Down crosses one virtualized GridView row",
      "payload": {
        "key": "Down"
      }
    },
    {
      "cmd": "__runner_local_presentation__",
      "label": "let GridView realization and reveal settle",
      "presentation_wait_ms": 700,
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "deep ordinary-key landing changes identity and advances viewport",
      "payload": {
        "object": "biblioLibraryGrid",
        "props": [
          "activeFocus",
          "count",
          "currentIndex",
          "contentY",
          "automationLiveDelegateCount",
          "automationCurrentIdentity",
          "automationCurrentItemObjectName",
          "automationCurrentItemFullyVisible"
        ]
      },
      "expect": [
        {
          "path": "props.activeFocus",
          "op": "==",
          "value": true
        },
        {
          "path": "props.currentIndex",
          "op": ">",
          "value": 100
        },
        {
          "path": "props.contentY",
          "op": ">",
          "value": 0
        },
        {
          "path": "props.automationLiveDelegateCount",
          "op": ">",
          "value": 0
        },
        {
          "path": "props.automationLiveDelegateCount",
          "op": "<",
          "value": 160
        },
        {
          "path": "props.automationCurrentIdentity",
          "op": "==",
          "value": "arc41-virtual-120|author-120"
        },
        {
          "path": "props.automationCurrentItemObjectName",
          "op": "==",
          "value": "biblioLibraryCard_arc41-virtual-120|author-120"
        },
        {
          "path": "props.automationCurrentItemFullyVisible",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "deep selected delegate is realized and selected",
      "payload": {
        "object": "biblioLibraryCard_arc41-virtual-120|author-120",
        "props": [
          "keyboardSelected",
          "index",
          "visible"
        ]
      },
      "expect": [
        {
          "path": "props.keyboardSelected",
          "op": "==",
          "value": true
        },
        {
          "path": "props.index",
          "op": "==",
          "value": 120
        },
        {
          "path": "props.visible",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "ui-query",
      "label": "deep selected delegate is visible and unclipped",
      "payload": {
        "object": "biblioLibraryCard_arc41-virtual-120|author-120"
      },
      "expect": [
        {
          "path": "visible",
          "op": "==",
          "value": true
        },
        {
          "path": "clippedByWindow",
          "op": "==",
          "value": false
        }
      ]
    },
    {
      "cmd": "ping",
      "label": "session remains live after virtualized navigation",
      "expect": [
        {
          "path": "gates.drive",
          "op": "==",
          "value": true
        },
        {
          "path": "gates.read",
          "op": "==",
          "value": true
        }
      ]
    }
  ]
