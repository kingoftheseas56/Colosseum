      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "__runner_local_presentation__",
      "presentation_wait_ms": 1200,
      "expect": [
        {
          "path": "type",
          "op": "==",
          "value": "reply"
