{
  "name": "theatre_one_piece_virtualization",
  "comment": "Production One Piece (IMDb tt0388629) must keep its absolute long-run episode ledger virtualized while scrolling deep.",
  "steps": [
    {
      "cmd": "ping",
      "expect": [
        {
          "path": "gates.drive",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "payload": {
        "object": "accountWelcomeContinueLocal",
        "prop": "visible",
        "value": true,
        "timeout_ms": 10000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "cmd": "ui-click",
      "payload": {
        "target": "accountWelcomeContinueLocal"
      }
    },
    {
      "cmd": "ui-click",
      "payload": {
        "target": "modePill_Theatre"
      }
    },
    {
      "cmd": "ui-wait-for",
