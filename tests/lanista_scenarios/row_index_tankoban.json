{
  "name": "row-index-tankoban",
  "steps": [
    { "cmd": "ping", "label": "session", "expect": [ { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "boot", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "continue local", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "shell", "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open Tankoban", "payload": { "target": "modePill_Tankoban" } },
    { "cmd": "ui-wait-for", "label": "Tankoban world", "payload": { "object": "tankobanWorld", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "Manga tab", "payload": { "object": "tankobanTab_manga", "prop": "visible", "value": true, "timeout_ms": 15000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "__runner_local_presentation__", "label": "let Tankoban settle", "presentation_wait_ms": 3000, "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "ui-click", "label": "open Manga", "payload": { "target": "tankobanTab_manga" } },
    { "cmd": "ui-wait-for", "label": "Manga index starts closed", "payload": { "object": "tankobanRowIndexSidebar", "prop": "collapsed", "value": true, "timeout_ms": 20000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "bring the Manga index into view", "payload": { "target": "tankobanWorldScroll", "dy": -1200 } },
    { "cmd": "__runner_local_presentation__", "label": "let the Manga index pin", "presentation_wait_ms": 1500, "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "qml-get", "label": "closed Manga row index", "payload": { "object": "tankobanRowIndexSidebar", "props": ["width", "automationRows", "automationSidebarPinned"], "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "props.width", "op": "==", "value": "52" }, { "path": "props.automationRows", "op": "contains", "value": "Explore by Genre — Manga" }, { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "ui-click", "label": "open Manga row index", "payload": { "target": "tankobanRowIndexCollapse" } },
    { "cmd": "ui-wait-for", "label": "Manga index opens", "payload": { "object": "tankobanRowIndexSidebar", "prop": "width", "value": 240, "timeout_ms": 3000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "park Manga genres", "payload": { "target": "tankobanRowIndexRow_genres" } },
    { "cmd": "__runner_local_presentation__", "label": "let the Manga park settle", "presentation_wait_ms": 1500, "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "qml-get", "label": "Manga genres current", "payload": { "object": "tankobanRowIndexSidebar", "props": ["automationCurrentRow", "automationSidebarPinned"] },
      "expect": [ { "path": "props.automationCurrentRow", "op": "==", "value": "Explore by Genre — Manga" }, { "path": "props.automationSidebarPinned", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open Comics", "payload": { "target": "tankobanTabDock_comics" } },
    { "cmd": "ui-wait-for", "label": "Comics index starts closed", "payload": { "object": "tankobanRowIndexSidebar", "prop": "collapsed", "value": true, "timeout_ms": 20000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "bring the Comics index into view", "payload": { "target": "tankobanWorldScroll", "dy": -1200 } },
    { "cmd": "__runner_local_presentation__", "label": "let the Comics index pin", "presentation_wait_ms": 1500, "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "qml-get", "label": "Comics rows are indexed", "payload": { "object": "tankobanRowIndexSidebar", "props": ["automationRows"] },
      "expect": [ { "path": "props.automationRows", "op": "contains", "value": "Explore Comics" } ] },
    { "cmd": "ui-click", "label": "open Comics row index", "payload": { "target": "tankobanRowIndexCollapse" } },
    { "cmd": "ui-wait-for", "label": "Comics index opens", "payload": { "object": "tankobanRowIndexSidebar", "prop": "width", "value": 240, "timeout_ms": 3000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "reveal Explore Comics", "payload": { "target": "tankobanRowIndexList", "dy": -6000 } },
    { "cmd": "__runner_local_presentation__", "label": "let the Comics index settle", "presentation_wait_ms": 1500, "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "ui-click", "label": "park Explore Comics", "payload": { "target": "tankobanRowIndexRow_explore" } },
    { "cmd": "__runner_local_presentation__", "label": "let the Comics park settle", "presentation_wait_ms": 1500, "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "qml-get", "label": "Explore Comics current", "payload": { "object": "tankobanRowIndexSidebar", "props": ["automationCurrentRow", "automationSidebarPinned"] },
      "expect": [ { "path": "props.automationCurrentRow", "op": "==", "value": "Explore Comics" }, { "path": "props.automationSidebarPinned", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "Tankoban park and open-rail evidence", "payload": { "object": "tankobanWorldScroll", "props": ["contentY"], "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "props.contentY", "op": ">", "value": 0 }, { "path": "grabPath", "op": "exists" } ] }
  ]
}
