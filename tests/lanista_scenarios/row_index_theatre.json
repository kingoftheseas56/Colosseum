{
  "name": "row-index-theatre",
  "steps": [
    { "cmd": "ping", "label": "session", "expect": [ { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "boot", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "continue local", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "shell", "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open Theatre", "payload": { "target": "modePill_Theatre" } },
    { "cmd": "ui-wait-for", "label": "Theatre world", "payload": { "object": "theatreWorld", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "Movies tab", "payload": { "object": "theatreTab_movies", "prop": "visible", "value": true, "timeout_ms": 15000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "__runner_local_presentation__", "label": "let Theatre settle", "presentation_wait_ms": 3000, "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "qml-get", "label": "catalogue rail stays hidden on Discover", "payload": { "object": "theatreRowIndexSidebar", "props": ["visible"], "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "props.visible", "op": "==", "value": "false" }, { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "ui-click", "label": "open Movies", "payload": { "target": "theatreTab_movies" } },
    { "cmd": "ui-wait-for", "label": "row index starts closed", "payload": { "object": "theatreRowIndexSidebar", "prop": "collapsed", "value": true, "timeout_ms": 20000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "closed Theatre rail starts below featured content", "payload": { "object": "theatreRowIndexSidebar", "props": ["width", "y", "visible", "automationRows", "automationCurrentRow"], "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "props.width", "op": "==", "value": "52" }, { "path": "props.y", "op": ">", "value": 450 }, { "path": "props.visible", "op": "==", "value": "true" }, { "path": "props.automationRows", "op": "contains", "value": "Movie Genres" }, { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "ui-click", "label": "return to Discover", "payload": { "target": "theatreTab_discover" } },
    { "cmd": "ui-wait-for", "label": "catalogue rail hides after leaving Movies", "payload": { "object": "theatreRowIndexSidebar", "prop": "visible", "value": false, "timeout_ms": 3000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "featured content remains clear after tab roundtrip", "payload": { "object": "theatreRowIndexSidebar", "props": ["visible"], "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "props.visible", "op": "==", "value": "false" }, { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "ui-click", "label": "return to Movies", "payload": { "target": "theatreTab_movies" } },
    { "cmd": "ui-wait-for", "label": "catalogue rail returns with Movies", "payload": { "object": "theatreRowIndexSidebar", "prop": "visible", "value": true, "timeout_ms": 3000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "bring the catalogue rail into view", "payload": { "target": "theatreWorldScroll", "dy": -1200 } },
    { "cmd": "__runner_local_presentation__", "label": "let the catalogue rail pin", "presentation_wait_ms": 1500, "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "ui-click", "label": "open Theatre row index", "payload": { "target": "theatreRowIndexCollapse" } },
    { "cmd": "ui-wait-for", "label": "row index opens", "payload": { "object": "theatreRowIndexSidebar", "prop": "width", "value": 240, "timeout_ms": 3000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "reveal the final index entry", "payload": { "target": "theatreRowIndexList", "dy": -6000 } },
    { "cmd": "__runner_local_presentation__", "label": "let the index scroll settle", "presentation_wait_ms": 1500, "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "ui-click", "label": "park Movie Genres", "payload": { "target": "theatreRowIndexRow_genres" } },
    { "cmd": "__runner_local_presentation__", "label": "let the Theatre park settle", "presentation_wait_ms": 1500, "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "qml-get", "label": "Theatre scroll geometry", "payload": { "object": "theatreWorldScroll", "props": ["contentY", "contentHeight", "height"] },
      "expect": [ { "path": "props.contentY", "op": ">", "value": 0 } ] },
    { "cmd": "qml-get", "label": "Movie Genres becomes current", "payload": { "object": "theatreRowIndexSidebar", "props": ["automationCurrentRow", "automationSidebarPinned"] },
      "expect": [ { "path": "props.automationCurrentRow", "op": "==", "value": "Movie Genres" }, { "path": "props.automationSidebarPinned", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "Theatre park and open-rail evidence", "payload": { "object": "theatreWorldScroll", "props": ["contentY"], "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "props.contentY", "op": ">", "value": 0 }, { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "__runner_local_presentation__", "label": "let lazy Theatre shelves finish", "presentation_wait_ms": 3000, "expect": [ { "path": "type", "op": "==", "value": "reply" } ] }
  ]
}
