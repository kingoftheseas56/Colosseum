{
  "name": "keyboard-ignition-shortcuts",
  "comment": "Guards the other half of the split: the ignition item holds focus at rest and must stay transparent to keys it does not own. It accepts navigation keys only — the ApplicationShortcut chords and Escape have to keep working underneath it.",
  "steps": [
    { "cmd": "ping", "label": "isolated drive session answers",
      "expect": [
        { "path": "schema", "op": "matches", "value": "^colosseum\.dev\.v1" },
        { "path": "gates.drive", "op": "==", "value": "true" }
      ] },
    { "cmd": "ui-wait-for", "label": "boot splash leaves",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "fresh tag starts at onboarding",
      "payload": { "object": "accountWelcomeContinueLocal", "prop": "visible", "value": true, "timeout_ms": 30000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "leave onboarding for the shell", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "shell is the live surface",
      "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 30000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "ignition holds focus at rest",
      "payload": { "object": "keyboardIgnition", "prop": "activeFocus", "value": true, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },

    { "cmd": "ui-keypress", "label": "global chord still opens the Vault", "payload": { "key": "Ctrl+Shift+V" } },
    { "cmd": "ui-wait-for", "label": "Vault opens past the ignition item",
      "payload": { "object": "vaultState", "prop": "pageOpen", "value": true, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Escape still closes the topmost surface", "payload": { "key": "Esc" } },
    { "cmd": "ui-wait-for", "label": "Vault closes",
      "payload": { "object": "vaultState", "prop": "pageOpen", "value": false, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "F11 enters windowed shell mode", "payload": { "key": "F11" } },
    { "cmd": "get-state", "label": "windowed state is observable",
      "expect": [ { "path": "windows.0.state", "op": "==", "value": "normal" } ] }
  ]
}
