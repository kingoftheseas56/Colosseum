{
  "name": "biblio-scroll-probe2",
  "description": "Diagnostic: does a wheel event aimed at the header strip (no inner flickable under it) move mainFlick.contentY in one shot?",
  "app": {
    "exe": "native/build-msvc/colosseum.exe"
  },
  "steps": [
    {
      "cmd": "ping",
      "label": "runner ping",
      "expect": [
        {
          "path": "schema",
          "op": "matches",
          "value": "^colosseum\\.dev\\.v1"
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "one visible window",
      "expect": [
        {
          "path": "windows.0.visible",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "boot splash gone",
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 30000
      }
    },
    {
      "cmd": "ui-click",
      "label": "open Biblio mode",
      "payload": {
        "target": "modePill_Biblio"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "biblio tab bar visible",
      "payload": {
        "object": "biblioTabBar",
        "prop": "visible",
        "value": true,
        "timeout_ms": 30000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "the Explore pill resolves",
      "payload": {
        "object": "biblioTab_explore",
        "prop": "visible",
        "value": true,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-click",
      "label": "open Explore",
      "payload": {
        "target": "biblioTab_explore"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "explore page visible",
      "payload": {
        "object": "biblioExplorePage",
        "prop": "visible",
        "value": true,
        "timeout_ms": 20000
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "houses loaded",
      "payload": {
        "object": "biblioExplorePage",
        "prop": "housesLoading",
        "value": false,
        "timeout_ms": 30000
      }
    },
    {
      "cmd": "qml-get",
      "label": "contentY at rest",
      "payload": {
        "object": "biblioExploreFlick",
        "props": [
          "contentY",
          "contentHeight"
        ]
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "rail model built",
      "payload": {
        "object": "biblioExplorePage",
        "prop": "railKeysCsv",
        "value": "top-10,popular,top-rated,new-releases,trending,most-read,classics",
        "timeout_ms": 30000
      }
    },
    {
      "cmd": "qml-get",
      "label": "contentHeight once rails laid out",
      "payload": {
        "object": "biblioExploreFlick",
        "props": [
          "contentY",
          "contentHeight"
        ]
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "settle: burn 6s while rail delegates lay out (never-true wait is the sleep)",
      "payload": {
        "object": "biblioExploreFlick",
        "prop": "contentY",
        "value": -12345,
        "timeout_ms": 6000
      }
    },
    {
      "cmd": "ui-scroll",
      "label": "one big wheel at the header strip",
      "payload": {
        "target": "biblioExploreHeaderStrip",
        "dy": -6000
      }
    },
    {
      "cmd": "qml-get",
      "label": "contentY after the big wheel",
      "payload": {
        "object": "biblioExploreFlick",
        "props": [
          "contentY",
          "contentHeight"
        ]
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "give delegates a beat to instantiate",
      "payload": {
        "object": "biblioExplorePage",
        "prop": "housesLoading",
        "value": false,
        "timeout_ms": 3000
      }
    },
    {
      "cmd": "qml-get",
      "label": "contentY after settle",
      "payload": {
        "object": "biblioExploreFlick",
        "props": [
          "contentY"
        ]
      }
    }
  ]
}