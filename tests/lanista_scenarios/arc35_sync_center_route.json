{
  "name": "arc35-sync-center-route",
  "comment": "Arc 35 Slice 9 production route proof: the Connections taskbar destination opens independently, unavailable tracker details stay non-actionable, Escape returns focus, and Main Sync remains a separate Stremio destination.",
  "steps": [
    { "cmd": "ping", "label": "isolated production app answers", "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" }, { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "boot splash releases input", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "fresh tagged profile offers local mode", "payload": { "object": "accountWelcomeContinueLocal", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "continue without an account", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "account welcome leaves the shell", "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the production taskbar", "payload": { "target": "colosseumTaskbarHomeButton" } },
    { "cmd": "ui-wait-for", "label": "taskbar utility row is expanded", "payload": { "object": "taskbarHistoryStats", "prop": "width", "value": 46, "timeout_ms": 5000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "Trackers door is visible in the home top bar", "payload": { "object": "topBarTrackersButton" }, "expect": [ { "path": "visible", "op": "==", "value": "true" }, { "path": "enabled", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open Connections from the top-bar trackers door", "payload": { "target": "topBarTrackersButton" } },
    { "cmd": "ui-wait-for", "label": "Connections route becomes active", "payload": { "object": "syncCenterLayer", "prop": "active", "value": true, "timeout_ms": 5000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "empty model reports no waiting tracker work", "payload": { "object": "trackerSyncCenterPage", "prop": "waitingCount", "value": 0, "timeout_ms": 4000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "empty model reports no active tracker sync", "payload": { "object": "trackerSyncCenterPage", "prop": "syncing", "value": false, "timeout_ms": 4000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "empty no-account tracker state exposes unavailable owners and stays fail closed", "payload": { "object": "trackerSyncCenterPage", "props": ["connectedCount", "waitingCount", "unresolvedCount", "attentionProviderCount", "attentionBadgeCount", "syncing", "syncAllEnabled", "globalSettings", "aggregateState"] }, "expect": [ { "path": "props.connectedCount", "op": "==", "value": "0" }, { "path": "props.waitingCount", "op": "==", "value": "0" }, { "path": "props.unresolvedCount", "op": "==", "value": "0" }, { "path": "props.attentionProviderCount", "op": "==", "value": "0" }, { "path": "props.attentionBadgeCount", "op": "==", "value": "0" }, { "path": "props.syncing", "op": "==", "value": "false" }, { "path": "props.syncAllEnabled", "op": "==", "value": "false" }, { "path": "props.globalSettings.profileAvailable", "op": "==", "value": "false" }, { "path": "props.globalSettings.editable", "op": "==", "value": "false" }, { "path": "props.aggregateState.status", "op": "==", "value": "Empty" }, { "path": "props.aggregateState.healthy", "op": "==", "value": "false" }, { "path": "props.aggregateState.ownerHealthy", "op": "==", "value": "false" }, { "path": "props.aggregateState.ownerUnavailable", "op": "==", "value": "true" }, { "path": "props.aggregateState.syncing", "op": "==", "value": "false" }, { "path": "props.aggregateState.connectedCount", "op": "==", "value": "0" }, { "path": "props.aggregateState.waitingCount", "op": "==", "value": "0" }, { "path": "props.aggregateState.unresolvedCount", "op": "==", "value": "0" }, { "path": "props.aggregateState.attentionProviderCount", "op": "==", "value": "0" }, { "path": "props.aggregateState.canSyncAll", "op": "==", "value": "false" }, { "path": "props.aggregateState.currentActionKind", "op": "==", "value": "none" } ] },
    { "cmd": "ui-query", "label": "empty-state reassurance and disabled Sync all are visible", "payload": { "object": "trackerEmptyState" }, "expect": [ { "path": "visible", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "Main Sync remains a separate available destination", "payload": { "object": "trackerMainSyncButton" }, "expect": [ { "path": "visible", "op": "==", "value": "true" }, { "path": "enabled", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "capture the production empty Connections page", "payload": { "object": "trackerSyncCenterPage", "grab": { "target": "window", "timeoutMs": 4000 } }, "expect": [ { "path": "visible", "op": "==", "value": "true" }, { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "ui-scroll", "label": "bring the available tracker catalogue into the real page viewport", "payload": { "target": "trackerSyncCenterScroll", "dy": -800 } },
    { "cmd": "ui-wait-for", "label": "first page scroll settles", "payload": { "object": "trackerSyncCenterScroll", "prop": "moving", "value": false, "timeout_ms": 4000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-scroll", "label": "settle the catalogue card inside the viewport", "payload": { "target": "trackerSyncCenterScroll", "dy": -800 } },
    { "cmd": "ui-wait-for", "label": "catalogue page scroll settles", "payload": { "object": "trackerSyncCenterScroll", "prop": "moving", "value": false, "timeout_ms": 4000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "Connections page scroll moves to the catalogue", "payload": { "object": "trackerSyncCenterScroll", "props": ["contentY", "contentHeight", "height"] }, "expect": [ { "path": "props.contentY", "op": ">", "value": 0 } ] },
    { "cmd": "ui-query", "label": "SIMKL remains visibly unavailable in this build", "payload": { "object": "trackerCatalogue_simkl" }, "expect": [ { "path": "visible", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the unavailable SIMKL dossier", "payload": { "target": "trackerCatalogue_simkl" } },
    { "cmd": "ui-wait-for", "label": "provider dossier opens without connecting", "payload": { "object": "trackerDossierVeil", "prop": "visible", "value": true, "timeout_ms": 4000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "Connect is visible but disabled behind the provider gate", "payload": { "object": "trackerConnectButton" }, "expect": [ { "path": "visible", "op": "==", "value": "true" }, { "path": "enabled", "op": "==", "value": "false" } ] },
    { "cmd": "ui-keypress", "label": "Escape closes the dossier first", "payload": { "key": "Escape" } },
    { "cmd": "ui-wait-for", "label": "dossier closes and Connections remains active", "payload": { "object": "trackerDossierVeil", "prop": "visible", "value": false, "timeout_ms": 4000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "dossier Back restores focus to its catalogue card", "payload": { "object": "trackerCatalogue_simkl", "props": ["activeFocus"] }, "expect": [ { "path": "props.activeFocus", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Escape leaves Connections after the dossier", "payload": { "key": "Escape" } },
    { "cmd": "ui-wait-for", "label": "Connections closes while the taskbar regains focus", "payload": { "object": "syncCenterLayer", "prop": "active", "value": false, "timeout_ms": 4000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "focus returns to the top-bar trackers door", "payload": { "object": "topBarTrackersInput", "props": ["activeFocus"] }, "expect": [ { "path": "props.activeFocus", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "reopen Connections independently", "payload": { "target": "topBarTrackersButton" } },
    { "cmd": "ui-wait-for", "label": "reopened Connections page is active", "payload": { "object": "syncCenterLayer", "prop": "active", "value": true, "timeout_ms": 4000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open Stremio Main Sync from its separate action", "payload": { "target": "trackerMainSyncButton" } },
    { "cmd": "ui-wait-for", "label": "Main Sync opens Stremio over the still-active Connections page", "payload": { "object": "stremioSyncOverlay", "prop": "shown", "value": true, "timeout_ms": 5000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "Connections remains active beneath the Stremio overlay", "payload": { "object": "syncCenterLayer", "props": ["active"] }, "expect": [ { "path": "props.active", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Escape closes only the Stremio overlay", "payload": { "key": "Escape" } },
    { "cmd": "ui-wait-for", "label": "Stremio overlay closes", "payload": { "object": "stremioSyncOverlay", "prop": "shown", "value": false, "timeout_ms": 4000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] }
  ]
}
