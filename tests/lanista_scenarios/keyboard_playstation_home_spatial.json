{
  "name": "keyboard-playstation-home-spatial",
  "comment": "PlayStation-style Home acceptance: after onboarding, the first directional key reaches the visible Home primary action; Up/Down follow visible hero geometry; Enter opens the focused destination; Escape unwinds exactly one level and restores the invoker. Onboarding is dismissed through its named action so this scenario isolates Home focus geometry.",
  "steps": [
    { "cmd": "ping", "label": "isolated drive session answers",
      "expect": [ { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "boot splash leaves",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "dismiss onboarding if this isolated profile still shows it",
      "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "Home shell is live",
      "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 30000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "shell holds keyboard ignition at rest",
      "payload": { "object": "keyboardIgnition", "prop": "activeFocus", "value": true, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },

    { "cmd": "ui-keypress", "label": "first D-pad Down enters visible Home content", "payload": { "key": "Down" } },
    { "cmd": "ui-wait-for", "label": "Home primary hero owns focus",
      "payload": { "object": "homeHeroExplore", "prop": "activeFocus", "value": true, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },

    { "cmd": "ui-keypress", "label": "Up follows visible hero geometry", "payload": { "key": "Up" } },
    { "cmd": "ui-wait-for", "label": "Hall of Worlds above the hero action owns focus",
      "payload": { "object": "homeUniverseHall", "prop": "activeFocus", "value": true, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Down returns to the hero primary action", "payload": { "key": "Down" } },
    { "cmd": "ui-wait-for", "label": "Home hero owns focus again",
      "payload": { "object": "homeHeroExplore", "prop": "activeFocus", "value": true, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },

    { "cmd": "ui-keypress", "label": "Enter activates the focused hero action", "payload": { "key": "Enter" } },
    { "cmd": "ui-wait-for", "label": "Universe opens exactly one level above Home",
      "payload": { "object": "universeLayer", "prop": "active", "value": true, "timeout_ms": 30000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Escape closes only the Universe", "payload": { "key": "Escape" } },
    { "cmd": "ui-wait-for", "label": "Universe closes",
      "payload": { "object": "universeLayer", "prop": "active", "value": false, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "Universe close restores the hero invoker",
      "payload": { "object": "homeHeroExplore", "prop": "activeFocus", "value": true, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },

    { "cmd": "ui-keypress", "label": "Up returns to Hall of Worlds", "payload": { "key": "Up" } },
    { "cmd": "ui-wait-for", "label": "Hall action is focused",
      "payload": { "object": "homeUniverseHall", "prop": "activeFocus", "value": true, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Enter opens Hall of Worlds", "payload": { "key": "Enter" } },
    { "cmd": "ui-wait-for", "label": "Hall opens exactly one level above Home",
      "payload": { "object": "universeHallLayer", "prop": "active", "value": true, "timeout_ms": 30000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Escape closes only Hall of Worlds", "payload": { "key": "Escape" } },
    { "cmd": "ui-wait-for", "label": "Hall closes",
      "payload": { "object": "universeHallLayer", "prop": "active", "value": false, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "Hall close restores the Hall invoker",
      "payload": { "object": "homeUniverseHall", "prop": "activeFocus", "value": true, "timeout_ms": 15000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] }
  ]
}
