{
  "name": "update-idle",
  "comment": "Installed-release chronicle: a disposable shipping-build session with no update fixture and no test presentation state renders the bundled installed 1.1.6 chronicle at rest (six real chapters, fallback visual stage, installed version title), not the single-chapter fallback.",
  "steps": [
    { "cmd": "ping", "label": "the idle shipping session answers",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "one visible window",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" },
                  { "path": "windows.0.width", "op": "==", "value": 1280 },
                  { "path": "windows.0.height", "op": "==", "value": 720 } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash has left the screen",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "fresh profile offers local-only onboarding",
      "payload": { "object": "accountWelcomeContinueLocal", "prop": "visible", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "continue locally in the disposable profile",
      "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "local-only onboarding has closed",
      "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the home topbar Update glyph is visible",
      "payload": { "object": "colosseumTopbarUpdateButton", "prop": "visible", "value": true, "timeout_ms": 30000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open the update page from the topbar glyph",
      "payload": { "target": "colosseumTopbarUpdateButton" } },
    { "cmd": "ui-wait-for", "label": "the update page is on screen",
      "payload": { "object": "colosseumUpdatePage", "prop": "visible", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the page reports the idle state at rest",
      "payload": { "object": "colosseumUpdatePage", "prop": "automationState", "value": "Idle", "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the installed chronicle's first chapter title has rendered",
      "payload": { "object": "colosseumUpdateChapterTitle", "prop": "text", "value": "Arrows keep moving", "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the installed chronicle's first chapter body has rendered",
      "payload": { "object": "colosseumUpdateChapterBody", "prop": "text", "value": "Spatial navigation now follows visual direction across worlds and continues through overflowing content instead of stopping at the viewport edge.", "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the rendered fallback stage has settled",
      "payload": { "object": "colosseumUpdateGallery", "prop": "automationStageSettled", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the installed chronicle gallery has presented a visual frame",
      "payload": { "object": "colosseumUpdateGallery", "prop": "automationVisualReady", "value": true, "timeout_ms": 8000 },
      "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "the gallery exposes six installed chapters at rest",
      "payload": { "object": "colosseumUpdateGallery", "props": ["chapterCount", "currentIndex"] },
      "expect": [ { "path": "props.chapterCount", "op": "==", "value": 6 },
                  { "path": "props.currentIndex", "op": "==", "value": 0 } ] },
    { "cmd": "qml-get", "label": "the version title reads the installed release",
      "payload": { "object": "colosseumUpdateVersionTitle", "props": ["text"] },
      "expect": [ { "path": "props.text", "op": "==", "value": "1.1.6" } ] },
    { "cmd": "qml-get", "label": "the chapter label and count reflect the installed chronicle",
      "payload": { "object": "colosseumUpdateChapterCount", "props": ["text"] },
      "expect": [ { "path": "props.text", "op": "==", "value": "01 / 06" } ] },
    { "cmd": "get-state", "label": "evidence: the whole window with the installed chronicle at rest",
      "payload": { "grab": { "target": "window", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] }
  ]
}
