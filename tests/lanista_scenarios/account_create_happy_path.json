{
  "name": "account-create-happy-path",
  "comment": "Mock-backed production-QML account creation. Never reads the recovery-key plaintext; requires saved acknowledgement and verifies shell identity.",
  "steps": [
    {
      "cmd": "ping",
      "label": "isolated driven session is alive",
      "expect": [
        {
          "path": "gates.drive",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "boot splash is gone",
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "account onboarding is visible",
      "payload": {
        "object": "accountHost",
        "prop": "visible",
        "value": true,
        "timeout_ms": 15000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "choose Create account",
      "payload": {
        "target": "accountWelcomeCreateAccount"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "create-account surface is visible",
      "payload": {
        "object": "accountCreate",
        "prop": "visible",
        "value": true,
        "timeout_ms": 8000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-text-input",
      "label": "enter username",
      "payload": {
        "target": "accountCreateUsername",
        "text": "LanistaAccountOwner"
      }
    },
    {
      "cmd": "ui-text-input",
      "label": "enter password",
      "payload": {
        "target": "accountCreatePassword",
        "text": "Lanista-Account-Pass-2026!"
      }
    },
    {
      "cmd": "ui-text-input",
      "label": "confirm password",
      "payload": {
        "target": "accountCreateConfirmPassword",
        "text": "Lanista-Account-Pass-2026!"
      }
    },
    {
      "cmd": "ui-click",
      "label": "submit account creation",
      "payload": {
        "target": "accountCreateSubmit"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "one-time recovery-key screen is reached without reading its secret",
      "payload": {
        "object": "accountRecoveryKeyValue",
        "prop": "visible",
        "value": true,
        "timeout_ms": 15000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "saved acknowledgement is visible",
      "payload": {
        "object": "accountRecoveryKeySaved",
        "prop": "visible",
        "value": true,
        "timeout_ms": 5000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "explicitly acknowledge the recovery key was saved",
      "payload": {
        "target": "accountRecoveryKeySaved"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "onboarding closes after acknowledgement",
      "payload": {
        "object": "accountHost",
        "prop": "visible",
        "value": false,
        "timeout_ms": 15000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "open the real account flyout",
      "payload": {
        "target": "colosseumTopbarAccountButton"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "created identity is visible",
      "payload": {
        "object": "accountFlyoutUsername",
        "prop": "visible",
        "value": true,
        "timeout_ms": 5000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "created username is authoritative in shell",
      "payload": {
        "object": "accountFlyoutUsername",
        "props": [
          "text"
        ]
      },
      "expect": [
        {
          "path": "props.text",
          "op": "==",
          "value": "LanistaAccountOwner"
        }
      ]
    }
  ]
}
