{
  "name": "arc41-biblio-poster-route-return",
  "comment": "Arc41 family3 acceptance derived from the committed biblio_downloaded_epub_read_journey donor. Setup reaches the real seeded Biblio Library card; acceptance uses Tab/Home/Enter/Escape only, records the stable card id, grid focus/index and card geometry, and requires the same poster to regain focus and remain fully visible after detail-route return.",
  "steps": [
    { "cmd": "ping", "label": "isolated session answers with drive enabled", "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" }, { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "fresh tagged window is visible", "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" }, { "path": "appDataRoot", "op": "contains", "value": "Colosseum-dltest" } ] },
    { "cmd": "ui-wait-for", "label": "boot splash leaves", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "ui-click", "label": "dismiss account onboarding", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "account host closes", "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 15000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "ui-click", "label": "enter Biblio", "payload": { "target": "modePill_Biblio" } },
    { "cmd": "ui-wait-for", "label": "Biblio tab bar appears", "payload": { "object": "biblioTabBar", "prop": "visible", "value": true, "timeout_ms": 30000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "ui-wait-for", "label": "retained Discover load settles", "payload": { "object": "biblioDiscoverPage", "prop": "loading", "value": false, "timeout_ms": 30000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "ui-wait-for", "label": "Library tab action materializes", "payload": { "object": "biblioTab_library", "prop": "visible", "value": true, "timeout_ms": 30000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "ui-click", "label": "switch to Library", "payload": { "target": "biblioTab_library" } },
    { "cmd": "__runner_local_presentation__", "label": "let the Library tab activation settle", "presentation_wait_ms": 500, "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "ui-click", "label": "retry the idempotent Library tab activation", "payload": { "target": "biblioTab_library" } },
    { "cmd": "ui-wait-for", "label": "Library page is visible", "payload": { "object": "biblioLibraryPage", "prop": "visible", "value": true, "timeout_ms": 30000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "ui-wait-for", "label": "the seeded Collection poster renders", "payload": { "object": "biblioLibraryCard_arc 19 book|test author", "prop": "visible", "value": true, "timeout_ms": 30000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "qml-get", "label": "one real Collection poster exists", "payload": { "object": "biblioLibraryPage", "props": [ "rowCount" ] }, "expect": [ { "path": "props.rowCount", "op": "==", "value": 1 } ] },
    { "cmd": "ui-scroll", "label": "donor setup scrolls the retained Biblio page to the poster wall", "payload": { "target": "biblioTabBar", "dy": -500 } },
    { "cmd": "ui-scroll", "label": "donor setup scroll continues to the poster wall", "payload": { "target": "biblioTabBar", "dy": -800 } },
    { "cmd": "ui-scroll", "label": "donor setup settles the poster wall in the viewport", "payload": { "target": "biblioTabBar", "dy": -800 } },
    { "cmd": "__runner_local_presentation__", "label": "the page scroll glide settles", "presentation_wait_ms": 700, "expect": [ { "path": "type", "op": "==", "value": "reply" } ] },
    { "cmd": "ui-keypress", "label": "ordinary Down enters the production GridView from the visible WorldTabBar", "payload": { "key": "Down" } },
    { "cmd": "ui-wait-for", "label": "ordinary keys establish the real GridView focus owner", "payload": { "object": "biblioLibraryGrid", "prop": "activeFocus", "value": true, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "ui-keypress", "label": "Home selects the first poster through ordinary input", "payload": { "key": "Home" } },
    { "cmd": "qml-get", "label": "the Library wall owns settled focus at poster index zero", "payload": { "object": "biblioLibraryGrid", "props": [ "activeFocus", "currentIndex", "contentY", "width", "height" ] }, "expect": [ { "path": "props.activeFocus", "op": "==", "value": true }, { "path": "props.currentIndex", "op": "==", "value": 0 } ] },
    { "cmd": "qml-get", "label": "the focused poster records stable id and geometry", "payload": { "object": "biblioLibraryCard_arc 19 book|test author", "props": [ "keyboardSelected", "index", "width", "height", "visible" ] }, "expect": [ { "path": "props.keyboardSelected", "op": "==", "value": true }, { "path": "props.index", "op": "==", "value": 0 }, { "path": "props.visible", "op": "==", "value": true } ] },
    { "cmd": "ui-query", "label": "the focused poster is fully visible and unclipped before route", "payload": { "object": "biblioLibraryCard_arc 19 book|test author" }, "expect": [ { "path": "visible", "op": "==", "value": true }, { "path": "clippedByWindow", "op": "==", "value": false } ] },
    { "cmd": "ui-keypress", "label": "Enter opens the focused poster detail route", "payload": { "key": "Enter" } },
    { "cmd": "ui-wait-for", "label": "Biblio detail route opens", "payload": { "object": "biblioBookDetail", "prop": "visible", "value": true, "timeout_ms": 20000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "qml-get", "label": "detail route is the selected book", "payload": { "object": "biblioBookDetail", "props": [ "visible", "book.title", "book.author" ] }, "expect": [ { "path": "props.visible", "op": "==", "value": true } ] },
    { "cmd": "ui-keypress", "label": "Tab enters the detail route's real BackAction", "payload": { "key": "Tab" } },
    { "cmd": "ui-wait-for", "label": "the real BackAction owns detail focus", "payload": { "object": "biblioBookBack", "prop": "automationActiveFocus", "value": true, "timeout_ms": 5000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "ui-keypress", "label": "Enter activates the detail route BackAction", "payload": { "key": "Enter" } },
    { "cmd": "ui-wait-for", "label": "the stable detail route owner closes", "payload": { "object": "biblioBookRouteState", "prop": "active", "value": false, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": true } ] },
    { "cmd": "qml-get", "label": "route return restores the same wall focus and index", "payload": { "object": "biblioLibraryGrid", "props": [ "activeFocus", "currentIndex", "contentY", "width", "height" ] }, "expect": [ { "path": "props.activeFocus", "op": "==", "value": true }, { "path": "props.currentIndex", "op": "==", "value": 0 } ] },
    { "cmd": "qml-get", "label": "route return restores the same poster selection and geometry", "payload": { "object": "biblioLibraryCard_arc 19 book|test author", "props": [ "keyboardSelected", "index", "width", "height", "visible" ] }, "expect": [ { "path": "props.keyboardSelected", "op": "==", "value": true }, { "path": "props.index", "op": "==", "value": 0 }, { "path": "props.visible", "op": "==", "value": true } ] },
    { "cmd": "ui-query", "label": "route return leaves the same poster fully visible and unclipped", "payload": { "object": "biblioLibraryCard_arc 19 book|test author" }, "expect": [ { "path": "visible", "op": "==", "value": true }, { "path": "clippedByWindow", "op": "==", "value": false } ] },
    { "cmd": "ping", "label": "session remains live after route return", "expect": [ { "path": "gates.drive", "op": "==", "value": true }, { "path": "gates.read", "op": "==", "value": true } ] }
  ]
}
