{
  "name": "biblio-covers-pilot",
  "comment": "Lanista pilot (decision brief 2026-08-06): prove the 5b28b5a cover fix in a DISPOSABLE session. Run via `lanista session run` with --drive — never against the daily pipe. Asserts by shape and by the BiblioImageDiag recorder: after the Discover wall loads, normalized 600x600bb.jpg fetches must exist and answer 200. Per-card walking is the next slice; this run proves session isolation, navigation, recorder, and pixels end to end.",
  "steps": [
    { "cmd": "ping", "label": "session app answers on its own pipe",
      "expect": [ { "path": "schema", "op": "matches", "value": "^colosseum\\.dev\\.v1" },
                  { "path": "gates.drive", "op": "==", "value": "true" } ] },
    { "cmd": "get-state", "label": "one visible window",
      "expect": [ { "path": "windows.0.visible", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "the boot splash has left the screen",
      "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 } },
    { "cmd": "log-mark", "label": "mark: navigating to Biblio",
      "payload": { "label": "pilot-biblio-nav" } },
    { "cmd": "ui-click", "label": "open the Biblio mode",
      "payload": { "target": "modePill_Biblio" } },
    { "cmd": "ui-wait-for", "label": "Biblio's tab bar appears",
      "payload": { "object": "biblioTabBar", "prop": "visible", "value": true, "timeout_ms": 8000 } },
    { "cmd": "ui-wait-for", "label": "the Discover wall finished loading",
      "payload": { "object": "biblioDiscoverPage", "prop": "loading", "value": false, "timeout_ms": 20000 } },
    { "cmd": "ui-wait-for", "label": "the wall is showing LIVE catalog rows, not the built-in fallback",
      "payload": { "object": "biblioDiscoverPage", "prop": "freshness", "value": "fresh", "timeout_ms": 30000 } },
    { "cmd": "ui-query", "label": "the Discover page is really on screen",
      "payload": { "object": "biblioDiscoverPage" },
      "expect": [ { "path": "visible", "op": "==", "value": "true" } ] },
    { "cmd": "invoke-read", "label": "image fetches happened at all (recorder sanity)",
      "payload": { "object": "BiblioImageDiag", "method": "recentRows", "args": ["50"] },
      "expect": [ { "path": "result.0.url", "op": "exists" } ] },
    { "cmd": "invoke-read", "label": "healed Apple covers were fetched (600x600 shape, HTTP 200)",
      "payload": { "object": "BiblioImageDiag", "method": "rowsForUrl", "args": ["600x600bb.jpg"] },
      "expect": [ { "path": "result.0.url", "op": "contains", "value": "600x600bb.jpg" },
                  { "path": "result.0.httpStatus", "op": "==", "value": "200" },
                  { "path": "result.0.networkError", "op": "==", "value": "0" } ] },
    { "cmd": "get-state", "label": "evidence: the whole window, pixels",
      "payload": { "grab": { "target": "window" } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "get-state", "label": "evidence: the Discover wall itself (item grab, scroll-independent)",
      "payload": { "grab": { "target": "biblioDiscoverPage", "timeoutMs": 4000 } },
      "expect": [ { "path": "grabPath", "op": "exists" } ] }
  ]
}
