{
  "name": "probe-k02-biblio-reorder",
  "steps": [
    {
      "cmd": "ping",
      "label": "session"
    },
    {
      "cmd": "ui-wait-for",
      "label": "boot",
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "continue local",
      "payload": {
        "target": "accountWelcomeContinueLocal"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "shell",
      "payload": {
        "object": "accountHost",
        "prop": "visible",
        "value": false,
        "timeout_ms": 10000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "open Biblio",
      "payload": {
        "target": "modePill_Biblio"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "Explore tab materializes",
      "payload": {
        "object": "biblioTab_explore",
        "prop": "visible",
        "value": true,
        "timeout_ms": 15000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "sleep",
      "label": "let Biblio settle",
      "payload": {
        "ms": 2500
      }
    },
    {
      "cmd": "ui-click",
      "label": "open Explore",
      "payload": {
        "target": "biblioTab_explore"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "Explore page visible",
      "payload": {
        "object": "biblioExplorePage",
        "prop": "visible",
        "value": true,
        "timeout_ms": 5000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "tab bar owns Explore focus",
      "payload": {
        "object": "biblioTabBar",
        "props": [
          "activeFocus",
          "currentTab"
        ]
      },
      "expect": [
        {
          "path": "props.activeFocus",
          "op": "==",
          "value": "true"
        },
        {
          "path": "props.currentTab",
          "op": "==",
          "value": "explore"
        }
      ]
    },
    {
      "cmd": "ui-keypress",
      "label": "Tab reaches Customize",
      "payload": {
        "key": "Tab"
      }
    },
    {
      "cmd": "qml-get",
      "label": "Customize owns focus",
      "payload": {
        "object": "biblioExploreCustomizeAction",
        "props": [
          "activeFocus"
        ]
      },
      "expect": [
        {
          "path": "props.activeFocus",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-keypress",
      "label": "Enter enables edit mode",
      "payload": {
        "key": "Enter"
      }
    },
    {
      "cmd": "qml-get",
      "label": "edit mode is live and default adjacency is intact",
      "payload": {
        "object": "biblioExplorePage",
        "props": [
          "editMode",
          "rowOrderSignature"
        ]
      },
      "expect": [
        {
          "path": "props.editMode",
          "op": "==",
          "value": "true"
        },
        {
          "path": "props.rowOrderSignature",
          "op": "contains",
          "value": "popular,top-rated"
        }
      ]
    },
    {
      "cmd": "ui-text-input",
      "label": "focus Popular drag handle",
      "payload": {
        "target": "biblioExploreDrag_popular",
        "text": ""
      }
    },
    {
      "cmd": "qml-get",
      "label": "Popular drag handle owns focus",
      "payload": {
        "object": "biblioExploreDrag_popular",
        "props": [
          "activeFocus"
        ]
      },
      "expect": [
        {
          "path": "props.activeFocus",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-keypress",
      "label": "Ctrl Shift Down moves Popular",
      "payload": {
        "key": "Ctrl+Shift+Down"
      }
    },
    {
      "cmd": "qml-get",
      "label": "keyboard move persisted one slot down",
      "payload": {
        "object": "biblioExplorePage",
        "props": [
          "rowOrderSignature"
        ]
      },
      "expect": [
        {
          "path": "props.rowOrderSignature",
          "op": "contains",
          "value": "top-rated,popular"
        }
      ]
    },
    {
      "cmd": "ui-keypress",
      "label": "Ctrl Shift Up restores Popular",
      "payload": {
        "key": "Ctrl+Shift+Up"
      }
    },
    {
      "cmd": "qml-get",
      "label": "keyboard move restores original order",
      "payload": {
        "object": "biblioExplorePage",
        "props": [
          "rowOrderSignature"
        ]
      },
      "expect": [
        {
          "path": "props.rowOrderSignature",
          "op": "contains",
          "value": "popular,top-rated"
        }
      ]
    }
  ]
}
