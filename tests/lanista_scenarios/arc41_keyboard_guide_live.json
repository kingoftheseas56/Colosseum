{
  "name": "arc41-keyboard-guide-live",
  "comment": "Integrated Brotherhood proof: taskbar Guide beside Settings opens the native guide; guide stays keyboard-operable; Escape closes it; utility chords remain live.",
  "steps": [
    { "cmd": "ping", "label": "isolated Brotherhood app answers" },
    { "cmd": "ui-wait-for", "label": "boot splash has released input", "payload": { "object": "bootSplash", "prop": "visible", "value": false, "timeout_ms": 60000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "fresh profile offers local mode", "payload": { "object": "accountWelcomeContinueLocal", "prop": "visible", "value": true, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "continue without account", "payload": { "target": "accountWelcomeContinueLocal" } },
    { "cmd": "ui-wait-for", "label": "account onboarding releases the shell", "payload": { "object": "accountHost", "prop": "visible", "value": false, "timeout_ms": 10000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-click", "label": "open taskbar", "payload": { "target": "colosseumTaskbarHomeButton" } },
    { "cmd": "ui-query", "label": "settle the taskbar open", "payload": { "object": "colosseumTaskbarHomeButton" }, "expect": [ { "path": "visible", "op": "==", "value": "true" } ] },
    { "cmd": "ui-wait-for", "label": "taskbar utility row finishes expanding", "payload": { "object": "taskbarKeyboardGuide", "prop": "width", "value": 46, "timeout_ms": 5000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "Settings button is visible", "payload": { "object": "taskbarSettings" }, "expect": [ { "path": "visible", "op": "==", "value": "true" } ] },
    { "cmd": "ui-query", "label": "Keyboard Guide button is visible beside Settings", "payload": { "object": "taskbarKeyboardGuide", "grab": { "target": "window", "timeoutMs": 4000 } }, "expect": [ { "path": "visible", "op": "==", "value": "true" }, { "path": "grabPath", "op": "exists" } ] },
    { "cmd": "ui-click", "label": "open Keyboard Guide from taskbar", "payload": { "target": "taskbarKeyboardGuide" } },
    { "cmd": "ui-wait-for", "label": "guide layer becomes active", "payload": { "object": "keyboardGuideLayer", "prop": "active", "value": true, "timeout_ms": 3000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "qml-get", "label": "guide default accordion state", "payload": { "object": "keyboardGuidePage", "props": ["featuresOpen", "readingOpen", "shortcutsOpen"] }, "expect": [ { "path": "props.featuresOpen", "op": "==", "value": "true" }, { "path": "props.readingOpen", "op": "==", "value": "false" }, { "path": "props.shortcutsOpen", "op": "==", "value": "false" } ] },
    { "cmd": "qml-get", "label": "Guide entry hands focus to Features", "payload": { "object": "keyboardGuideFeaturesHeader", "props": ["activeFocus"] }, "expect": [ { "path": "props.activeFocus", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Enter collapses Features", "payload": { "key": "Enter" } },
    { "cmd": "ui-wait-for", "label": "Features collapsed through keyboard", "payload": { "object": "keyboardGuidePage", "prop": "featuresOpen", "value": false, "timeout_ms": 3000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Tab moves to Reading and Playback", "payload": { "key": "Tab" } },
    { "cmd": "qml-get", "label": "Reading header owns focus", "payload": { "object": "keyboardGuideReadingHeader", "props": ["activeFocus"] }, "expect": [ { "path": "props.activeFocus", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Space expands Reading and Playback", "payload": { "key": "Space" } },
    { "cmd": "ui-wait-for", "label": "Reading expanded through keyboard", "payload": { "object": "keyboardGuidePage", "prop": "readingOpen", "value": true, "timeout_ms": 3000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Tab moves to Shortcuts", "payload": { "key": "Tab" } },
    { "cmd": "qml-get", "label": "Shortcuts header owns focus", "payload": { "object": "keyboardGuideShortcutsHeader", "props": ["activeFocus"] }, "expect": [ { "path": "props.activeFocus", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Enter expands Shortcuts", "payload": { "key": "Enter" } },
    { "cmd": "ui-wait-for", "label": "Shortcuts expanded through keyboard", "payload": { "object": "keyboardGuidePage", "prop": "shortcutsOpen", "value": true, "timeout_ms": 3000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Tab wraps focus to Features", "payload": { "key": "Tab" } },
    { "cmd": "qml-get", "label": "Guide focus remains trapped in its headers", "payload": { "object": "keyboardGuideFeaturesHeader", "props": ["activeFocus"] }, "expect": [ { "path": "props.activeFocus", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Escape closes guide", "payload": { "key": "Escape" } },
    { "cmd": "ui-wait-for", "label": "guide layer closes", "payload": { "object": "keyboardGuideLayer", "prop": "active", "value": false, "timeout_ms": 3000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Ctrl Shift D opens Downloads", "payload": { "key": "Ctrl+Shift+D" } },
    { "cmd": "ui-wait-for", "label": "Downloads opens", "payload": { "object": "downloadsLayer", "prop": "active", "value": true, "timeout_ms": 5000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Ctrl Shift E opens Extensions", "payload": { "key": "Ctrl+Shift+E" } },
    { "cmd": "ui-wait-for", "label": "Extensions opens", "payload": { "object": "extensionsLayer", "prop": "active", "value": true, "timeout_ms": 5000 }, "expect": [ { "path": "matched", "op": "==", "value": "true" } ] },
    { "cmd": "ui-keypress", "label": "Ctrl Shift S opens Settings", "payload": { "key": "Ctrl+Shift+S" } },
    { "cmd": "ui-wait-for", "label": "Settings opens with final visual grab", "payload": { "object": "settingsLayer", "prop": "active", "value": true, "timeout_ms": 5000, "grab": { "target": "window", "timeoutMs": 4000 } }, "expect": [ { "path": "matched", "op": "==", "value": "true" }, { "path": "grabPath", "op": "exists" } ] }
  ]
}
