{
  "name": "journey-open-manga",
  "comment": "Visibility Phase 2, Slice J1-Manga. Proves a user opens a downloaded manga chapter from Tankoban's Downloads page and reaches a genuinely ready comic reader (readerReady, page count/index sourced from the production ComicReaderShell's own state — see J1-Manga-Seam). Fixture: tests/lanista_fixtures/journeys/open-manga-v1 (a disk-only MangaDownloader-backed chapter, deliberately NOT the Collection/Progress-backed paths — see fixture.json's whyChapterLaneNotVolumeLane). Isolated tagged session on a unique pipe; never the daily app. A fresh manga chapter with no saved per-series prefs opens in 'paired_pages' (Double Page — ComicReaderState.defaultReadingMode: 'manga chapters + tankoban volumes open as Manga'/RTL double-page), verified live 2026-08-13: readerReady here IS genuine per-image pixel-render proof (ComicReaderDoubleSurface.qml gates presented() on each mounted Image's own status===Image.Ready, or an explicit terminal error card) — the strip-only 'scrolled to a page' caveat J1-Manga-Seam recorded does not apply to this journey's actual observed path.",
  "steps": [
    {
      "cmd": "ping",
      "label": "the journey session answers, drive gated on",
      "expect": [
        {
          "path": "schema",
          "op": "matches",
          "value": "^colosseum\\.dev\\.v1"
        },
        {
          "path": "gates.drive",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "get-state",
      "label": "one visible window, isolated data root",
      "expect": [
        {
          "path": "windows.0.visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "appDataRoot",
          "op": "contains",
          "value": "Colosseum-dltest"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "the boot splash has left the screen",
      "payload": {
        "object": "bootSplash",
        "prop": "visible",
        "value": false,
        "timeout_ms": 60000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "open the taskbar dock",
      "payload": {
        "target": "colosseumTaskbarHomeButton"
      }
    },
    {
      "cmd": "ui-query",
      "label": "settle the dock open (a real round-trip, no sleep)",
      "payload": {
        "object": "colosseumTaskbarHomeButton"
      },
      "expect": [
        {
          "path": "visible",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "the dock's open-width animation has genuinely settled (real width, not a mid-transition read — found live: an immediate ui-query after the home-button click can catch the still-animating dock at width 0, which then clicks the WRONG on-screen point)",
      "payload": {
        "object": "taskbarDownloads",
        "prop": "width",
        "value": 46,
        "timeout_ms": 5000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-query",
      "label": "the Downloads dock control renders, visible + actionable",
      "payload": {
        "object": "taskbarDownloads"
      },
      "expect": [
        {
          "path": "visible",
          "op": "==",
          "value": "true"
        },
        {
          "path": "enabled",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "open the Downloads page",
      "payload": {
        "target": "taskbarDownloads"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "the seeded chapter's shelf card renders",
      "payload": {
        "object": "downloadsShelfCard_tankoban_manga:journey-manga-series-v1",
        "prop": "visible",
        "value": true,
        "timeout_ms": 15000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "the seeded library item: expand the series' download ledger",
      "payload": {
        "target": "downloadsShelfCard_tankoban_manga:journey-manga-series-v1"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "the seeded chapter's own Read action renders in the expanded ledger",
      "payload": {
        "object": "downloadsReadAction_journey-manga-ch-1",
        "prop": "visible",
        "value": true,
        "timeout_ms": 15000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "the seeded library item's open action: read the chapter",
      "payload": {
        "target": "downloadsReadAction_journey-manga-ch-1"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "the production reader becomes visible",
      "payload": {
        "object": "comicReaderShell",
        "prop": "visible",
        "value": true,
        "timeout_ms": 30000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "readerReady is the real false->true transition, no sleep",
      "payload": {
        "object": "comicReaderShell",
        "prop": "readerReady",
        "value": true,
        "timeout_ms": 30000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "authoritative source id / page count / page index / layout",
      "payload": {
        "object": "comicReaderShell",
        "props": [
          "readerSourceId",
          "readerPageCount",
          "readerPageIndex",
          "layout",
          "readerReady"
        ]
      },
      "expect": [
        {
          "path": "props.readerSourceId",
          "op": "==",
          "value": "journey-manga-ch-1"
        },
        {
          "path": "props.readerPageCount",
          "op": "==",
          "value": "3"
        },
        {
          "path": "props.readerPageIndex",
          "op": "<=",
          "value": "2"
        },
        {
          "path": "props.readerReady",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "label": "L2 reader layout checkpoint: actionable + contained",
      "layout_verdict": {
        "checkpoint": "tests/lanista_layout/journey_open_manga.json",
        "out": "artifacts/visibility-phase2/j1-open-manga/layout-verdict.json"
      }
    },
    {
      "cmd": "ui-query",
      "label": "grab the ready reader as a paired exhibit",
      "payload": {
        "object": "comicReaderShell",
        "grab": {
          "target": "window",
          "timeoutMs": 4000
        }
      },
      "expect": [
        {
          "path": "grabPath",
          "op": "exists"
        }
      ]
    },
    {
      "cmd": "ui-keypress",
      "label": "regression: turn a page (Right) — RTL manga: observed moving between the two paired_pages units this 3-page fixture couples into",
      "payload": {
        "key": "Right"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "regression: readerReady genuinely re-settles after the turn (a real transient false during the unit change, not an instant flip — no sleep)",
      "payload": {
        "object": "comicReaderShell",
        "prop": "readerReady",
        "value": true,
        "timeout_ms": 15000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "regression: authoritative state stays internally consistent after the turn",
      "payload": {
        "object": "comicReaderShell",
        "props": [
          "readerPageIndex",
          "readerPageCount",
          "readerSourceId",
          "readerReady"
        ]
      },
      "expect": [
        {
          "path": "props.readerSourceId",
          "op": "==",
          "value": "journey-manga-ch-1"
        },
        {
          "path": "props.readerPageCount",
          "op": "==",
          "value": "3"
        },
        {
          "path": "props.readerReady",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "regression: back — the reader's own chrome back action (readerBackRequested -> win.closeComicReader -> closeSession -> seriesLayer.active=false, which DESTROYS the loaded MangaSeries/MangaReader/comicReaderShell tree rather than merely hiding it, so this step's own proof is the reopen chain below succeeding from scratch, not an intermediate probe of a torn-down/transitional scene)",
      "payload": {
        "target": "hudBackAction"
      }
    },
    {
      "cmd": "ui-click",
      "label": "regression: reopen — dock",
      "payload": {
        "target": "colosseumTaskbarHomeButton"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "regression: reopen — the dock's open-width animation has genuinely settled before clicking Downloads (same real animation race as the first open)",
      "payload": {
        "object": "taskbarDownloads",
        "prop": "width",
        "value": 46,
        "timeout_ms": 5000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "regression: reopen — Downloads",
      "payload": {
        "target": "taskbarDownloads"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "regression: reopen — the seeded chapter's shelf card renders again",
      "payload": {
        "object": "downloadsShelfCard_tankoban_manga:journey-manga-series-v1",
        "prop": "visible",
        "value": true,
        "timeout_ms": 15000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "regression: reopen — expand the ledger again",
      "payload": {
        "target": "downloadsShelfCard_tankoban_manga:journey-manga-series-v1"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "regression: reopen — the Read action renders again",
      "payload": {
        "object": "downloadsReadAction_journey-manga-ch-1",
        "prop": "visible",
        "value": true,
        "timeout_ms": 15000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-click",
      "label": "regression: reopen — read the chapter again",
      "payload": {
        "target": "downloadsReadAction_journey-manga-ch-1"
      }
    },
    {
      "cmd": "ui-wait-for",
      "label": "regression: reopen — the reader becomes visible again",
      "payload": {
        "object": "comicReaderShell",
        "prop": "visible",
        "value": true,
        "timeout_ms": 30000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "ui-wait-for",
      "label": "regression: reopen — readerReady becomes true again",
      "payload": {
        "object": "comicReaderShell",
        "prop": "readerReady",
        "value": true,
        "timeout_ms": 30000
      },
      "expect": [
        {
          "path": "matched",
          "op": "==",
          "value": "true"
        }
      ]
    },
    {
      "cmd": "qml-get",
      "label": "regression: reopen — same source, same page count, still authoritative",
      "payload": {
        "object": "comicReaderShell",
        "props": [
          "readerSourceId",
          "readerPageCount",
          "readerReady"
        ]
      },
      "expect": [
        {
          "path": "props.readerSourceId",
          "op": "==",
          "value": "journey-manga-ch-1"
        },
        {
          "path": "props.readerPageCount",
          "op": "==",
          "value": "3"
        },
        {
          "path": "props.readerReady",
          "op": "==",
          "value": "true"
        }
      ]
    }
  ]
}
