# M1308 FTP service. FTPS certificate weakening is deliberately not implemented.
target_sources(colosseum_server_v1 PRIVATE src/archive/FtpSource.cpp src/http/FtpRoutes.cpp)
if(BUILD_TESTING)
 add_executable(server1_ftp_routes_tests tests/test_ftp_routes.cpp)
 target_link_libraries(server1_ftp_routes_tests PRIVATE colosseum_server_v1)
 add_test(NAME AFTP-routes-loopback COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/run_ftp_tests.py" --candidate "$<TARGET_FILE:server1_ftp_routes_tests>")
 set_tests_properties(AFTP-routes-loopback PROPERTIES TIMEOUT 45)
 add_executable(server1_ftp_source_tests tests/test_ftp_source.cpp)
 target_link_libraries(server1_ftp_source_tests PRIVATE colosseum_server_v1)
 add_test(NAME AFTP-loopback COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/run_ftp_tests.py" --candidate "$<TARGET_FILE:server1_ftp_source_tests>")
 set_tests_properties(AFTP-loopback PROPERTIES TIMEOUT 45)
 if(SERVER1_K12_ORACLE AND SERVER1_NODE_EXECUTABLE)
  add_test(NAME AFTP-transport-differential COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/run_ftp_tests.py" --candidate "$<TARGET_FILE:server1_ftp_source_tests>" --oracle "${SERVER1_K12_ORACLE}" --node "${SERVER1_NODE_EXECUTABLE}")
  set_tests_properties(AFTP-transport-differential PROPERTIES TIMEOUT 90)
  add_test(NAME AFTP-oracle-generate COMMAND "${SERVER1_NODE_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/run_ftp_oracle.cjs" "${SERVER1_K12_ORACLE}" "${CMAKE_CURRENT_BINARY_DIR}/ftp-oracle.json")
  add_test(NAME AFTP-range-differential COMMAND server1_ftp_source_tests --oracle "${CMAKE_CURRENT_BINARY_DIR}/ftp-oracle.json")
  set_tests_properties(AFTP-oracle-generate PROPERTIES FIXTURES_SETUP ftp_oracle TIMEOUT 30)
  set_tests_properties(AFTP-range-differential PROPERTIES FIXTURES_REQUIRED ftp_oracle TIMEOUT 30)
 endif()
endif()
