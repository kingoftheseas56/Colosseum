function(server1_register_casting_tests)
  add_executable(server1_casting_tests tests/test_casting.cpp)
  target_link_libraries(server1_casting_tests PRIVATE colosseum_server_v1)
  add_test(NAME CAST-fixtures COMMAND server1_casting_tests "${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/casting.json")
  if(SERVER1_K12_ORACLE AND SERVER1_NODE_EXECUTABLE)
    add_test(NAME CAST-source-differential COMMAND "${SERVER1_NODE_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/run_casting_oracle.cjs" "${SERVER1_K12_ORACLE}" "${CMAKE_CURRENT_BINARY_DIR}/casting-oracle.json" "$<TARGET_FILE:server1_casting_tests>")
  endif()
  find_program(SERVER1_CAST_FFMPEG ffmpeg)
  if(SERVER1_CAST_FFMPEG AND UNIX)
    add_test(NAME CAST-real-media COMMAND server1_casting_tests "${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/casting.json" "${SERVER1_CAST_FFMPEG}")
    set_tests_properties(CAST-real-media PROPERTIES TIMEOUT 90)
  endif()
endfunction()
