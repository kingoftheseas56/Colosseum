<!DOCTYPE RCC><RCC version="1.0">
<!-- Bundled installed-release chronicle for Colosseum 1.1.4. The signed manifest + signature
     are produced by scripts/update/generate_installed_chronicle.py with the production key.
     This release declares no dedicated chronicle artwork, so the gallery uses its built-in
     fallback stage. InstalledChronicle re-verifies the signature before presentation. -->
<qresource prefix="/installed-chronicle">
    <file alias="installed-manifest.json">../resources/installed-chronicle/installed-manifest.json</file>
    <file alias="installed-manifest.json.sig">../resources/installed-chronicle/installed-manifest.json.sig</file>
</qresource>
</RCC>
