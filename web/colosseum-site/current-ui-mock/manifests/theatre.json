      "source": "qml/PlayerPage.qml",
      "route": "player.video",
      "status": "fixture",
      "notes": "All pinned presets (15/30/45 min, 1/2/3/4/6 hours, end current/next episode, cancel) and selected state exist; native sleep/power management is not executed."
    },
    {
