      "source": "qml/SubtitleMenu.qml:141; qml/PlayerPage.qml:5859",
      "route": "player.video",
      "status": "source-inapplicable",
      "notes": "SubStyleBar is instantiated behind onStyleRequested, but current SubtitleMenu declares styleRequested without emitting it. The reachable unified subtitle appearance panel is implemented; no new trigger was invented for the dormant bar."
    },
    {
      "id": "player.hold-space",
      "source": "qml/PlayerPage.qml:3257-3265,3911-3919,4005-4018",
      "route": "player.video",
      "status": "implemented",
      "notes": "350ms press threshold; short release toggles playback; hold sets max(2, prior speed); release restores prior speed without toggling. Keyboard auto-repeat is ignored; blur cancels safely."
    },
    {
      "id": "player.skip-segment",
      "source": "qml/PlayerPage.qml:2873-2898,5053-5098",
      "route": "player.video",
      "status": "implemented",
      "notes": "Source-shaped 42px monochrome intro/recap/credits pill; visible only in active segment with controls/settings enabled; yields to Up Next and excludes live. Click/Enter seeks to min(duration - .25, segment end + .75) and dismisses that segment."
    },
    {
      "id": "player.window-hotkeys",
      "source": "qml/Main.qml:205-211; qml/player2/Player2Shell.qml:560-561",
      "route": "player.video",
      "status": "implemented",
      "notes": "Application-style F11 works in default/experimental player even over local menus. Player2 F toggles the same staged fullscreen state. Button aria-pressed/name and feedback reflect the state; OS window unchanged."
    },
    {
      "id": "theatre.many-seasons",
      "source": "qml/TheatreSeries.qml:1817-1933; qml/TheatreSeriesView.qml:1800-1905",
      "route": "theatre.detail",
      "status": "implemented",
      "notes": "12-season fixture plus Specials replaces pills with authored 236px-wide, 304px-max-height menu. 36px options, active color, arrows/Home/End, Enter/Space, outside/Esc close and focus restore. Menu flips above when below would clip."
    },
    {
      "id": "theatre.catalogue-context",
      "source": "shared/catalog.js integration contract; qml/TheatreSeries.qml",
      "route": "theatre.detail",
      "status": "implemented",
