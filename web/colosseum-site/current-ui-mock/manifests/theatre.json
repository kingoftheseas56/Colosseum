      "source": "qml/player2/Player2Shell.qml",
      "route": "player.experimental",
      "status": "implemented",
      "notes": "Labeled conditional route with 320px simple track menu, speed-only selector, conditional previous/next episode buttons, four-row overflow menu, no Watch Party, right source/episode drawer. Shares unchanged source HUD geometry with existing Player2-derived baseline."
    },
