    {
      "id": "theatre.default",
      "source": "qml/TheatreSeries.qml",
      "route": "theatre.detail",
      "status": "implemented",
      "notes": "Copied baseline hero/facts/ledger retained; source-native season/episode contexts, watched markers, library/removal, notifications, source/download transitions; sticky header verified."
    },
    {
      "id": "theatre.rebuilt",
      "source": "qml/TheatreSeriesView.qml",
      "route": "theatre.rebuilt",
      "status": "implemented",
      "notes": "Source-specific 60px heading and synopsis in hero, two-column facts, 56px ledger, 96px episode rows, inline order/season pills, Next and Go-to controls. Native virtualization/performance is out of scope."
    },
    {
      "id": "theatre.cast-related",
      "source": "qml/TheatreSeries.qml",
      "route": "theatre.detail",
      "status": "source-inapplicable",
      "notes": "Pinned default and rebuilt title components do not instantiate a cast or more-like-this section."
    },
    {
      "id": "sources.order",
      "source": "qml/SourcesSheet.qml:47-53",
      "route": "theatre.sources",
      "status": "source-inapplicable",
      "notes": "Source explicitly preserves extension request order. No user re-sorting exists; none invented."
    },
    {
