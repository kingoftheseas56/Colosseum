  "coverage": [
    {
      "id": "shell.home",
      "source": "qml/Main.qml",
      "route": "home",
      "status": "implemented",
      "notes": "Copied baseline hero and five widget compositions; real scrolling and routed actions; staged covers."
    },
    {
      "id": "shell.worlds",
      "source": "qml/WorldPage.qml",
      "route": "world.tankoban",
      "status": "implemented",
      "notes": "Original world demo dimensions/styles retained; default Discover and world-specific tabs; hero slideshow is user-controlled."
    },
    {
      "id": "shell.chrome",
      "source": "qml/TopBar.qml",
      "route": "home",
      "status": "implemented",
      "notes": "Source four top pills, Home no-selection, world-search, back-only/none variants; live local clock."
    },
    {
      "id": "shell.taskbar",
      "source": "qml/Taskbar.qml",
      "route": "home",
      "status": "implemented",
      "notes": "64 px dock at 16 px bottom; permanent Colosseum/Vault, media/sample picker, recent sessions, Next to Open, source action doors and grouped sessions."
    },
    {
      "id": "shell.discovery",
      "source": "qml/DiscoverSidebar.qml",
      "route": "discover.tankoban",
      "status": "implemented",
      "notes": "Source sidebar starts collapsed; source selection, genres, sort, local search and deterministic loading/error/empty recovery."
    },
    {
      "id": "shell.library",
      "source": "qml/LibraryPage.qml",
      "route": "library.tankoban",
      "status": "implemented",
      "notes": "Separate Theatre, Biblio and Tankoban source variants. Theatre Shelf Ledger includes new episodes/downloaded; type and airing filter pills. Biblio excludes video-only ledger concepts; Tankoban has All/In Progress/Downloaded. Menus anchored at 200px with 38px actions, dismissal, keyboard navigation and focus restoration."
    },
    {
      "id": "shell.search",
      "source": "qml/SearchSurface.qml",
      "route": "search.theatre",
      "status": "implemented",
      "notes": "World-scoped search, local history/genres and Top Match. Biblio has actual source Books/Audiobooks groups and Jump to Home/Top 10/Genres. Series/LibGen groups were an inventory error; absent from pinned BiblioSearch.qml."
    },
    {
      "id": "shell.native-history",
      "source": "Browser adapter for qml/Main.qml navigation",
      "route": "home",
      "status": "implemented",
      "notes": "pushState for route entries and popstate restoration; app Back/Escape share browser history. Replaced iframe nodes avoid duplicate joint-history entries. Native Back/Forward and app reversal tested in Chromium/Firefox."
    },
    {
      "id": "shell.account-flyout",
      "source": "qml/account/AccountFlyout.qml",
      "route": "home",
      "status": "implemented",
      "notes": "296px anchored identity flyout, signed-in/out and Device fixture state, source Account/Devices entries, sync/pending/retry status, Sign in/out, outside/Escape dismissal, focus containment and restoration. Local fixture only."
    }
  ],
  "limitations": [
    "Catalogue, providers, history and sessions are local fixtures only. Native file picker and window minimize/quit use explanatory staged sheets.",
    "Current source sidebar geometry reproduced; catalogues are finite authentic-asset fixtures, not live remote completeness.",
    "Native spatial D-pad navigation is approximated with browser Tab/Enter.",
    "Home and world baseline widget geometry is preserved; catalogue artwork selections and metadata are staged. Search/discovery services never run.",
    "Current BiblioSearch.qml has Books and Audiobooks only, not Series or LibGen search result groups; earlier inventory statement was incorrect. Book result set uses two authentic bundled fixture covers. Native services remain staged."
  ]
}
