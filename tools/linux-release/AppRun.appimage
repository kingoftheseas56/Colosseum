#!/bin/sh
# AppImage-only host integration; the qualified shared AppRun stays unchanged.
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -d "$HERE/usr/share" ]; then
    export XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
fi
if [ -z "${SSL_CERT_FILE:-}" ]; then
    for trust in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/ca-bundle.pem /etc/ssl/cert.pem; do
        if [ -r "$trust" ]; then export SSL_CERT_FILE="$trust"; break; fi
    done
fi
if [ -z "${FONTCONFIG_FILE:-}" ] && [ -r /etc/fonts/fonts.conf ]; then
    export FONTCONFIG_FILE=/etc/fonts/fonts.conf
fi
if [ -z "${FONTCONFIG_PATH:-}" ] && [ -d /etc/fonts ]; then
    export FONTCONFIG_PATH=/etc/fonts
fi
exec "$HERE/AppRun.colosseum" "$@"
